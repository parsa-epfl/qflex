#!/usr/bin/env expect
# Path A driver for the load side of the multi-node savevm test:
#   1) Connect to serial. The guest has been resumed from `savevm
#      qflex-makefile-test` via QEMU's `-loadvm`, so we should land at the
#      shell prompt where savevm captured us.
#   2) `ls`, capture the output to $EXP_FOLDER/ls_after_load.txt.
#   3) `quit` over the monitor.
#
# Always tries to `quit` QEMU at the end (success or failure) so the host's
# `gdb -ex run --args qemu-system-aarch64` doesn't hang.

set timeout 900

# Wall-clock budgets for connect/wait operations (seconds). Tcl while/sleep
# loops aren't bound by expect's `set timeout`, so polling needs an explicit
# deadline — see the `expect-scripts` skill for the rationale.
#   INITIAL: first connect to qemu (qemu may still be coming up).
#   DEFAULT: any subsequent reconnect — qemu was alive, anything past 5s is dead.
#   CHECKPOINTING: savevm/loadvm or any operation that drains across nodes;
#                  large state can legitimately take many minutes.
set BUDGET_INITIAL_S        10
set BUDGET_DEFAULT_S         5
set BUDGET_CHECKPOINTING_S 1800

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)
set exp_folder   $env(EXP_FOLDER)

catch {file mkdir $exp_folder}
log_file -noappend "$exp_folder/expect_log.txt"

# Poll telnet for the listener. The budget caller passes is the wall-clock
# deadline; without it, a dead port spins forever (expect's `set timeout`
# only fires inside expect blocks, not Tcl while/sleep loops).
proc connect_telnet {host port {budget_seconds 5}} {
    global timeout
    set saved_timeout $timeout
    set timeout 5
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        spawn telnet $host $port
        set this_sid $spawn_id
        set ok 0
        expect {
            -re "Escape character is" { set ok 1 }
            -re "Connection refused" { }
            timeout { }
            eof { }
        }
        if {$ok} {
            set timeout $saved_timeout
            return $this_sid
        }
        catch {close -i $this_sid}
        catch {wait -i $this_sid}
        sleep 2
    }
    set timeout $saved_timeout
    error "connect_telnet: gave up after ${budget_seconds}s polling $host:$port"
}

proc quit_qemu {monitor_port} {
    global BUDGET_DEFAULT_S
    # Best-effort: if the monitor port doesn't accept us, the image has
    # already exited. Stop polling and return — no point retrying telnet
    # against a dead listener.
    if {[catch {connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S} sid]} {
        return
    }
    set timeout $BUDGET_DEFAULT_S
    expect {
        -i $sid
        timeout { puts "quit_qemu: monitor didn't prompt" }
        "(qemu) " {
            send -i $sid "quit\r"
            catch {expect -i $sid eof}
        }
    }
}

set ok 0

set serial_sid [connect_telnet 127.0.0.1 $serial_port $BUDGET_INITIAL_S]
set spawn_id $serial_sid

# loadvm replays the snapshotted serial state — bytes can stream in over
# multiple seconds, and prompt-regex matching races against partial buffer
# content. Drain everything for 5s of silence first, then send ls and drain
# the response. The captured bytes contain ls's echo + the listed files;
# the test asserts a known filename is in there.
set saved_timeout $timeout
set timeout 5
expect { -re {.+} { exp_continue } timeout { } }

send "ls\r"
sleep 1
set ls_output ""
set timeout 2
expect {
    -re {.+} {
        append ls_output $expect_out(buffer)
        exp_continue
    }
    timeout { }
}
set timeout $saved_timeout

if {[string length $ls_output] == 0} {
    puts "ERROR: no bytes received after ls"
    quit_qemu $monitor_port
    exit 1
}

set out_path "$exp_folder/ls_after_load.txt"
if {[catch {open $out_path "w"} f]} {
    puts "ERROR: could not open $out_path for writing: $f"
} else {
    puts $f $ls_output
    close $f
    puts "wrote ls output to $out_path"
    set ok 1
}

catch {close -i $serial_sid}
catch {wait -i $serial_sid}

# Grace before quit so siblings finish their capture before the master's
# `_kill_sibling_qemus` fires — without this the racing sibling can be killed
# mid-`ls`, leaving the captured file with garbage. quit_qemu itself short-
# circuits if the monitor is gone, so this is the only delay we actually pay.
sleep 5
quit_qemu $monitor_port

if {!$ok} { exit 1 }
