#!/usr/bin/env bash
# QFlex build entry point.
#
# The actual build commands live in ./justfile so that the bare, Nix and Docker
# builds share a single path. This script is kept as a thin, backward
# compatible wrapper for the existing docs/scripts; prefer calling `just`.

set -euo pipefail

BUILD_TYPE="release"
export CONAN=1
export EXTRA_PROFILE=""

print_help() {
    echo "Usage: $0 [options] <target>"
    echo "Targets:"
    echo "  <kraken>                 Build a Flexus simulator (knottykraken/semikraken)"
    echo "  cq | qemu | q            Build timing-qemu"
    echo "  fw | fwq                 Build fw-qemu"
    echo "  bxdb                     Build bxdb"
    echo "  docker                   Build the QFlex Docker image"
    echo "Options:"
    echo "  -b, --build-type <type>  release (default) | debug | relwithdebinfo"
    echo "  -c, --custom-gcc         Also use the custom-gcc Conan profile"
    echo "  -n, --nix                Use raw CMake for Flexus (Nix) instead of Conan"
    echo "  -h, --help               Print this help message"
    echo
    echo "All recipes are defined in ./justfile (run 'just --list')."
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -b|--build-type)
            BUILD_TYPE="$2"
            shift
            shift
            ;;
        -c|--custom-gcc)
            EXTRA_PROFILE="$(realpath flexus/target/_profile/custom-gcc)"
            shift
            ;;
        -n|--nix)
            CONAN=0
            shift
            ;;
        -h|--help)
            print_help
            ;;
        *)
            TARGET="$1"
            shift
            break
            ;;
    esac
done

if [[ -z "${TARGET:-}" ]]; then
    echo "Error: <target> argument is required" >&2
    print_help
fi

export PROFILE="$BUILD_TYPE"

case "$TARGET" in
    docker)
        docker buildx build -t "parsa/qflex-${BUILD_TYPE}:latest" --build-arg MODE="${BUILD_TYPE}" .
        ;;
    cq|qemu|q)
        exec just timing-qemu
        ;;
    fw|fwq)
        exec just fw-qemu
        ;;
    bxdb)
        exec just bxdb
        ;;
    *kraken)
        exec just flexus "$TARGET"
        ;;
    *)
        echo "Never heard of '${TARGET}'" >&2
        exit 1
        ;;
esac
