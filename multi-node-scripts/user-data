#cloud-config
disable_root: false
chpasswd:
  list: |
    root:root
  expire: False

# Your script
write_files:
  - path: /root/bootup_script.sh
    content: |
      #!/bin/bash
      echo "Hello from script"
      echo =============== hello from the other side XD ================
      # Your commands here
    permissions: '0755'
  

bootcmd:
  - /root/bootup_script.sh > /tmp/output.log 2>&1
  - systemctl restart systemd-networkd
  - systemctl restart systemd-resolved