--llc-size-per-tile-mb 2
--parallel
--network none
--memory-gb 64
--host-name ZEN3
--workload-name data-caching
--population-seconds 5
--no-consolidated
--primary-ipc 2.0
--primary-core-start 0
--image-name root-1c-origin-s.qcow2
--image-folder /mnt/sdb/data-caching-1c/
--mounting-folder /mnt/sdb/data-caching-1c/
--check-period-quantum-coeff 5
--no-unique --use-image-directly
