#!/usr/bin/env expect
# MULTI-NODE FOLLOWER (node_number > 0) MS load. Loads from `booted`,
# brings up the PDES NIC, ping-verifies the wire to master (0-drop required),
# nc-preflights TCP/443 to master (matches the real hammar->nginx path),
# waits for master's server-ready sentinel, then runs hammar warm + hammar
# load on the serial spawn. Signals master when 'All tasks are created.'
# appears, waits for its OWN per-node savevm log 7 (PDES drain cascade),
# sleeps 60s, then quits.
#
# Pair with conf/MS/expects/load_savevm_loaded_master.exp on node 0.
#
# === IN-IMAGE WORKLOAD SCRIPT REFERENCE ======================================
# One baked script lives in /home/qflex/ inside the alpine guest on this leaf.
# It is NOT REWRITTEN — the docker run has no --cpuset-cpus and no IP arg.
#
# ./run_client.sh    — NOT REWRITTEN.
#   #!/bin/sh
#   docker run -it --name media-streaming-client \
#       --network host \
#       -v $(pwd)/videos:/videos xusine/media-streaming:client
#
# === SERVER-IP REDIRECTION (baked into the booted snapshot) ==================
# Hammar's source HARDCODES `https://127.0.0.1/...` (warm.rs:66 in the
# xusine/media-streaming:client image). The wait's BOOT expect installs a
# userspace `socat TCP-LISTEN:443,bind=127.0.0.1 ... TCP:192.168.100.1:443`
# forwarder and bakes it into the booted snapshot, so every loadvm-resumed
# load (this script) already has the proxy live. Docker --net=host shares
# the guest netns, so hammar inside the container hits the socat listener.
# Nothing to do on the load side beyond bringing up eth0 for the PDES wire.
#
# Boot snapshot resumes at root (`#`) since the boot expect su'd to install
# iproute2/socat. The initial `su` from previous revisions is dropped; we
# do IP bring-up directly and drop to qflex at the end of section 2.
#
# TODO multi-node: hammar load is single-threaded here. Per-4-cores fan-out
# (see ./run_multiple.sh) is a later step once the basic path works.
# =============================================================================

set timeout 900

set BUDGET_INITIAL_S        10
set BUDGET_DEFAULT_S         5
set BUDGET_PROMPT_S         60
set BUDGET_WORKLOAD_INIT_S 43200   ; # 12h client budget (hammar warm/load can take minutes-hours wall-clock under emulation)
set BUDGET_CHECKPOINTING_S 10800

set SERVER_IP "192.168.100.1"   ; # master's PDES wire IP — the only place this is set

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)
set exp_folder   $env(EXP_FOLDER)

catch {file mkdir $exp_folder}
log_file -noappend "$exp_folder/expect_log.txt"

if {[info exists env(GROUP_EXP_FOLDER)]} {
    set group_folder $env(GROUP_EXP_FOLDER)
} else {
    set group_folder [file dirname $exp_folder]
}
set master_docker_cleaned_flag "$group_folder/ms_load_master_docker_cleaned.flag"
set wait_docker_cleaned_flag   "$group_folder/ms_load_wait_docker_cleaned.flag"
set master_eth_done_flag       "$group_folder/ms_load_master_eth_done.flag"
set wait_eth_done_flag         "$group_folder/ms_load_wait_eth_done.flag"
set wire_master_flag         "$group_folder/ms_load_wire_master.flag"
set wire_wait_flag           "$group_folder/ms_load_wire_wait.flag"
set nc_listen_ready_flag     "$group_folder/ms_load_nc_listen_ready.flag"
set server_ready_flag        "$group_folder/ms_load_server_ready.flag"
set done_flag                "$group_folder/ms_load_done.flag"
# TEMP: pooria_*_flag pair — remove with section 7.5 once multi-node load is fully working.
set pooria_in_container_flag "$group_folder/ms_load_pooria_in_container.flag"
set pooria_done_flag         "$group_folder/ms_load_pooria_done.flag"
set loaded_done_flag         "$group_folder/ms_load_loaded_done.flag"
catch {file delete -force $wait_docker_cleaned_flag}
catch {file delete -force $wait_eth_done_flag}
catch {file delete -force $wire_wait_flag}
catch {file delete -force $done_flag}
catch {file delete -force $pooria_in_container_flag}

proc connect_telnet {host port {budget_seconds 5}} {
    global timeout
    set saved_timeout $timeout
    set timeout 5
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        spawn telnet $host $port
        set this_sid $spawn_id
        set ok 0
        expect {
            -re "Escape character is" { set ok 1 }
            -re "Connection refused" { }
            timeout { }
            eof { }
        }
        if {$ok} {
            set timeout $saved_timeout
            return $this_sid
        }
        catch {close -i $this_sid}
        catch {wait -i $this_sid}
        sleep 2
    }
    set timeout $saved_timeout
    error "connect_telnet: gave up after ${budget_seconds}s polling $host:$port"
}

proc quit_qemu {monitor_port} {
    global BUDGET_DEFAULT_S
    if {[catch {connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S} sid]} {
        return
    }
    set timeout $BUDGET_DEFAULT_S
    expect {
        -i $sid
        timeout { puts "quit_qemu: monitor didn't prompt" }
        "(qemu) " {
            send -i $sid "quit\r"
            catch {expect -i $sid eof}
        }
    }
}

proc wait_for_file {path budget_seconds} {
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        if {[file exists $path]} { return }
        sleep 2
    }
    error "wait_for_file: $path never appeared within ${budget_seconds}s"
}

proc wait_for_substring {path needle budget_seconds} {
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        if {[file exists $path]} {
            set fh [open $path r]; set content [read $fh]; close $fh
            if {[string first $needle $content] >= 0} { return }
        }
        sleep 2
    }
    error "wait_for_substring: $needle never appeared in $path within ${budget_seconds}s"
}

# --- 1. Connect serial + nudge for post-loadvm prompt -----------------------

set serial_sid [connect_telnet 127.0.0.1 $serial_port $BUDGET_INITIAL_S]
set spawn_id $serial_sid

set timeout $BUDGET_PROMPT_S
send "\r"
expect {
    timeout { puts "ERROR: shell prompt timed out after loadvm"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 10

# --- 1.5 Serialized docker container cleanup (after master finishes) --------
# Boot left us at root (#), which has docker socket access. Wait for master's
# docker cleanup sentinel, then tear down any stale containers from prior
# runs, then signal master we're done. Keeps docker daemon I/O out of the
# ARP/ping window that follows.

puts "follower: waiting for master's $master_docker_cleaned_flag before docker cleanup..."
wait_for_file $master_docker_cleaned_flag $BUDGET_PROMPT_S

send "docker stop \$(docker ps -a -q) 2>/dev/null\r"
expect {
    timeout { puts "ERROR: docker stop didn't return prompt"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
send "docker rm \$(docker ps -a -q) 2>/dev/null\r"
expect {
    timeout { puts "ERROR: docker rm didn't return prompt"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

if {[catch {set f [open $wait_docker_cleaned_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $wait_docker_cleaned_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "follower: docker containers removed; wrote $wait_docker_cleaned_flag."

# --- 2. IP bring-up on the PDES NIC (eth0); drop back to qflex --------------
# Boot already left us at the root prompt (it installed socat as root), so
# we go straight to ip-link/addr setup with no `su`. The final `su qflex`
# drops us back to the unprivileged shell for ping/nc/docker.

# Wait for master's eth + ARP to be ready before bringing our own up —
# serializes eth/ARP setup across nodes to prevent ping drops under
# PDES wire pressure.
puts "follower: waiting for master's $master_eth_done_flag before eth setup..."
wait_for_file $master_eth_done_flag $BUDGET_PROMPT_S
puts "follower: master eth ready; proceeding to eth setup."

send "ip link show\r";                               expect -re {# +}
send "ip link set eth0 down\r";                      expect -re {# +}
send "ip link set eth0 address 52:54:00:aa:bb:0a\r"; expect -re {# +}
send "ip link set eth0 up\r";                        expect -re {# +}
send "ip addr flush dev eth0\r"
expect {
    timeout { puts "ERROR: ip addr flush timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "ip addr add 192.168.100.2/24 dev eth0\r";      expect -re {# +}
send "ip addr show eth0\r";                          expect -re {# +}

# Pin master's ARP entry — see load_savevm_loaded_master.exp for rationale.
# `arp -s` works on both BusyBox and iproute2.
send "arp -s 192.168.100.1 52:54:00:aa:bb:00\r"; expect -re {# +}
send "arp -n 192.168.100.1\r";                   expect -re {# +}

# --- 2.6 Eth-setup serialization sentinel -----------------------------------
# Follower eth + ARP ready. Tell master, so master can start its ping.
# socat (section 2.5) runs in parallel with master's ping — it touches only
# loopback, not the PDES wire, so it doesn't compete for ARP/eth0.
if {[catch {set f [open $wait_eth_done_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $wait_eth_done_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "follower: eth ready; wrote $wait_eth_done_flag."

# --- 2.5 Defensive iptables flush + socat 127.0.0.1:443 -> master:443 -------
# Hammar's URLs are hardcoded to 127.0.0.1 (warm.rs:66). Boot baked a socat
# forwarder into the snapshot, but loadvm-resumed state under PDES isn't
# guaranteed to keep the listener live — re-install here so the client
# container's --net=host traffic to 127.0.0.1:443 reaches $SERVER_IP:443.
# Must run as root (iptables + privileged port 443).

send "iptables -t nat -F OUTPUT\r"; expect -re {# +}
send "socat TCP-LISTEN:443,bind=127.0.0.1,reuseaddr,fork TCP:$SERVER_IP:443 &\r"
expect -re {# +}
sleep 2

send "ss -tln | grep 127.0.0.1:443\r"
expect {
    timeout { puts "ERROR: ss didn't return after socat verify"; quit_qemu $monitor_port; exit 1 }
    -re {127\.0\.0\.1:443} { puts "follower: socat listening on 127.0.0.1:443 -> $SERVER_IP:443" }
}
expect -re {# +}
sleep 5

send "su qflex\r";                                   expect -re {\$ +}

# Wait for master's ping to finish before we start ours — serializes the two
# pings so they don't race on PDES wire / ARP cache.
puts "follower: waiting for master's $wire_master_flag (ping done) before pinging..."
wait_for_file $wire_master_flag $BUDGET_PROMPT_S
puts "follower: master ping done; proceeding to our ping."

sleep 5

# --- 3. Ping verify the wire to master (0-drop required) -------------------

send "ping $SERVER_IP -i 0.5 -c 10\r"
set timeout 120
expect {
    timeout { puts "ERROR: ping summary didn't arrive within 120s"; quit_qemu $monitor_port; exit 1 }
    -re {(\d+) packets transmitted, (\d+)[ ,]} {
        set tx $expect_out(1,string); set rx $expect_out(2,string)
        puts "follower: ping summary -> $tx transmitted, $rx received"
        if {$tx != $rx} {
            puts "ERROR: ping drops detected (tx=$tx rx=$rx); aborting"
            quit_qemu $monitor_port; exit 1
        }
    }
}
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "WARN: prompt didn't return after ping summary; continuing" }
    -re {[\$#] +}
}

sleep 5

# --- 4. Wire-ready handshake ------------------------------------------------

if {[catch {set f [open $wire_wait_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $wire_wait_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "follower: wire verified; wrote $wire_wait_flag; waiting for $wire_master_flag..."
wait_for_file $wire_master_flag $BUDGET_PROMPT_S

# --- 5. nc data-path preflight: connect to master:443 and send a token ------
puts "follower: waiting for master's nc listener ($nc_listen_ready_flag)..."
wait_for_file $nc_listen_ready_flag $BUDGET_PROMPT_S
# -w 2 => nc closes 2s after sending instead of hanging for the server to close.
send "echo 'Hello from VM2!' | nc -w 2 $SERVER_IP 443\r"
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "ERROR: nc send timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
puts "follower: sent 'Hello from VM2!' to $SERVER_IP:443."

# --- 6. Wait for master's nginx to be ready --------------------------------

puts "follower: waiting for $server_ready_flag..."
wait_for_file $server_ready_flag $BUDGET_WORKLOAD_INIT_S
puts "follower: master's server-ready signal received; launching client container."

# --- 6.5 socat-redirect smoke check (TCP only — ICMP can't see the redirect) -
# socat redirects TCP only: `ping 127.0.0.1` is ICMP and the kernel always
# routes 127.0.0.0/8 through loopback, so it would show 0 ms latency and
# tell us nothing about whether socat is actually forwarding to the wire.
# The only meaningful pre-hammar test is a TCP connect to 127.0.0.1:443
# (where socat listens) — that triggers socat to open a real TCP socket
# to 192.168.100.1:443, traversing eth0 / PDES wire / master nginx.
#
# Wrap in `time` so the wall-clock RTT is visible in the log: if the wire
# is alive, expect ~hundreds of ms (matching the real ping RTT to master).
# A near-zero `real` time means the socket finished without going to the
# wire (e.g. socat replied with FIN locally, or the listener is broken).

send "time nc -zvw 5 127.0.0.1 443\r"
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "ERROR: nc to 127.0.0.1:443 (socat) timed out"; quit_qemu $monitor_port; exit 1 }
    -re {refused} {
        puts "ERROR: nc to 127.0.0.1:443 refused — socat listener died"
        quit_qemu $monitor_port; exit 1
    }
    -re {Operation timed out|Network is unreachable} {
        puts "ERROR: nc to 127.0.0.1:443 wire-level failure (socat -> master:443 broken)"
        quit_qemu $monitor_port; exit 1
    }
    -re {open|succeeded} {
        puts "follower: nc 127.0.0.1:443 OK -- socat -> master:443 path alive (check `real` time above for wire RTT)"
    }
}
expect {
    timeout { }
    -re {[\$#] +}
}

# Docker cleanup already done in section 1.5 (before eth setup).

# --- 7. Enter client container + run hammar warm + hammar load -------------
# Hammar URLs are hardcoded to 127.0.0.1; the boot-baked socat listener on
# 127.0.0.1:443 forwards transparently to $SERVER_IP:443. taskset -c 0
# because this leaf is 1 vCPU (no doubled_vcpu in multi-node).

send "./run_client.sh\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: client container prompt didn't arrive"; quit_qemu $monitor_port; exit 1 }
    -re {root@qflex:/#}
}
puts "follower: inside client container; sanity-check hammar..."

send "ls\r"
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "ERROR: ls didn't return"; quit_qemu $monitor_port; exit 1 }
    -re {hammar}
}
expect {
    timeout { }
    -re {root@qflex:/#}
}
puts "follower: hammar present; dispatching warm..."

# --- 7.5 pooria-load-test handshake -----------------------------------------
# TEMP: remove (along with master's section 8.5 and the pooria_*_flag defs
# at the top of this file) once multi-node MS load is fully working.
# Signal master we're inside the container at hammar prompt; wait for master
# to finalise savevm pooria-load-test before pushing hammar's load. After the
# savevm drain, settle 10s before hitting the wire hard.

if {[catch {set f [open $pooria_in_container_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $pooria_in_container_flag: $err"
    quit_qemu $monitor_port; exit 1
}
puts "follower: wrote $pooria_in_container_flag; waiting for $pooria_done_flag..."
wait_for_file $pooria_done_flag $BUDGET_CHECKPOINTING_S
puts "follower: pooria-load-test savevm complete; settling 10s before hammar warm..."
sleep 10

send "taskset -c 0 ./hammar/target/release/warm ./videos 1\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: warm didn't produce 'Compressed history:'"; quit_qemu $monitor_port; exit 1 }
    -re {Compressed history:}
}
puts "follower: warm done; settling 5s before load..."
sleep 5
set timeout $BUDGET_PROMPT_S
expect {
    timeout { }
    -re {root@qflex:/#}
}

send "taskset -c 0 ./hammar/target/release/hammar ./videos/logs 4 8 false\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: hammar load didn't print 'All tasks are created.'"; quit_qemu $monitor_port; exit 1 }
    -re {All tasks are created\.}
}
puts "follower: hammar load reported tasks created; settling 5s..."
sleep 5

# --- 8. Signal master that load is done ------------------------------------

if {[catch {set f [open $done_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $done_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "follower: wrote $done_flag; waiting for master's $loaded_done_flag..."

# --- 9. Wait for master's savevm-loaded marker + 60s settle ----------------
# Gating on loaded_done_flag (written by master after `savevm loaded` returns)
# instead of `savevm log 7` in our own Load.log, because the TEMP section 7.5
# already produced one `savevm log 7` for pooria-load-test — wait_for_substring
# returns on first match and would fire prematurely.

wait_for_file $loaded_done_flag $BUDGET_CHECKPOINTING_S
puts "follower: master reported savevm loaded complete. Sleeping 60s..."
sleep 60

quit_qemu $monitor_port
exit 0
