#!/usr/bin/env expect
# MULTI-NODE FOLLOWER (node_number > 0) MS load. Loads from `booted`, brings up
# the PDES NIC (eth0 = 192.168.100.2), ping-verifies the wire to master, waits
# for the server, brings up eth1 internet, runs the client container, sets up an
# iptables DNAT so localhost reroutes to the master, runs the hammar warm+load,
# and waits for its OWN per-node `savevm log 7`.
#
# Pair with conf/MS/expects/load_savevm_loaded_master.exp on node 0. Does NOT
# issue `savevm` over the monitor — savevm is master-only on multi-node.
#
# The client runs the single-node hammar flow UNCHANGED (still localhost-targeting,
# pinned to cpu 0 since leaves are -smp 1). Instead of passing a server IP, the
# container DNATs 127.0.0.1 -> 192.168.100.1 (route_localnet + iptables nat), so
# the unmodified client reaches the master's server transparently over the wire.

set timeout 900

set BUDGET_INITIAL_S        10
set BUDGET_DEFAULT_S         5
set BUDGET_PROMPT_S         120
set BUDGET_WORKLOAD_INIT_S 86400   ; # 24h client budget (apt + hammar warm/load can take many hours wall-clock under PDES)
set BUDGET_CHECKPOINTING_S 10800

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)
set exp_folder   $env(EXP_FOLDER)

catch {file mkdir $exp_folder}
log_file -noappend "$exp_folder/expect_log.txt"

if {[info exists env(GROUP_EXP_FOLDER)]} {
    set group_folder $env(GROUP_EXP_FOLDER)
} else {
    set group_folder [file dirname $exp_folder]
}
set docker_master_flag "$group_folder/ms_load_docker_master.flag"
set docker_wait_flag   "$group_folder/ms_load_docker_wait.flag"
set wire_master_flag   "$group_folder/ms_load_wire_master.flag"
set wire_wait_flag     "$group_folder/ms_load_wire_wait.flag"
set ping_master_flag   "$group_folder/ms_load_ping_master.flag"
set ping_wait_flag     "$group_folder/ms_load_ping_wait.flag"
set nc_ready_flag      "$group_folder/ms_load_nc_ready.flag"
set nc_ok_flag         "$group_folder/ms_load_nc_ok.flag"
set server_ready_flag  "$group_folder/ms_load_server_ready.flag"
set client_done_flag   "$group_folder/ms_load_client_done.flag"
catch {file delete -force $docker_wait_flag}
catch {file delete -force $wire_wait_flag}
catch {file delete -force $ping_wait_flag}
catch {file delete -force $client_done_flag}

proc connect_telnet {host port {budget_seconds 5}} {
    global timeout
    set saved_timeout $timeout
    set timeout 5
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        spawn telnet $host $port
        set this_sid $spawn_id
        set ok 0
        expect {
            -re "Escape character is" { set ok 1 }
            -re "Connection refused" { }
            timeout { }
            eof { }
        }
        if {$ok} {
            set timeout $saved_timeout
            return $this_sid
        }
        catch {close -i $this_sid}
        catch {wait -i $this_sid}
        sleep 2
    }
    set timeout $saved_timeout
    error "connect_telnet: gave up after ${budget_seconds}s polling $host:$port"
}

proc quit_qemu {monitor_port} {
    global BUDGET_DEFAULT_S
    if {[catch {connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S} sid]} {
        return
    }
    set timeout $BUDGET_DEFAULT_S
    expect {
        -i $sid
        timeout { puts "quit_qemu: monitor didn't prompt" }
        "(qemu) " {
            send -i $sid "quit\r"
            catch {expect -i $sid eof}
        }
    }
}

proc wait_for_file {path budget_seconds} {
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        if {[file exists $path]} { return }
        sleep 2
    }
    error "wait_for_file: $path never appeared within ${budget_seconds}s"
}

proc wait_for_substring {path needle budget_seconds} {
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        if {[file exists $path]} {
            set fh [open $path r]; set content [read $fh]; close $fh
            if {[string first $needle $content] >= 0} { return }
        }
        sleep 2
    }
    error "wait_for_substring: $needle never appeared in $path within ${budget_seconds}s"
}

# --- 1. Connect serial + nudge for post-loadvm prompt; su to root -----------

set serial_sid [connect_telnet 127.0.0.1 $serial_port $BUDGET_INITIAL_S]
set spawn_id $serial_sid

set timeout $BUDGET_PROMPT_S
send "\r"
expect {
    timeout { puts "ERROR: shell prompt timed out after loadvm"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 5

send "su\r"
expect {
    timeout { puts "ERROR: never reached root prompt after su"; quit_qemu $monitor_port; exit 1 }
    -re {[Aa]uthentication failure|incorrect password} {
        puts "ERROR: su rejected empty creds"; quit_qemu $monitor_port; exit 1
    }
    -re {[Ll]ogin: }    { send "\r"; exp_continue }
    -re {[Pp]assword: } { send "\r"; exp_continue }
    -re {# +}
}

# --- 2. IP bring-up on the PDES NIC (eth0 = 192.168.100.2), after master's --

wait_for_file $wire_master_flag $BUDGET_WORKLOAD_INIT_S
# TODO: get the eth0 MAC from the experiment context (commands/config.py derives
# it per node) instead of hard-coding 52:54:00:aa:bb:0a here.
send "ip link set eth0 down\r";                      send "\r"; expect -re {# +}
send "ip link set eth0 address 52:54:00:aa:bb:0a\r"; send "\r"; expect -re {# +}
send "ip link set eth0 up\r";                        send "\r"; expect -re {# +}
send "ip addr flush dev eth0\r"
send "\r"
expect {
    timeout { puts "ERROR: ip addr flush timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "ip addr add 192.168.100.2/24 dev eth0\r";   send "\r"; expect -re {# +}
send "ip addr show eth0\r";                        send "\r"; expect -re {# +}

if {[catch {set f [open $wire_wait_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $wire_wait_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "follower: eth0 up at 192.168.100.2; wrote $wire_wait_flag."

# --- 3. Ping verify the wire to master, AFTER master's ping (0-drop) --------
# Serialised: wait for master to finish its ping ($ping_master_flag) before we
# ping, then signal our ping done ($ping_wait_flag) so master continues.

wait_for_file $ping_master_flag $BUDGET_WORKLOAD_INIT_S
send "ping 192.168.100.1 -i 0.05 -W 100 -c 10\r"
set timeout 150
expect {
    timeout { puts "ERROR: ping summary didn't arrive within 150s"; quit_qemu $monitor_port; exit 1 }
    -re {(\d+) packets transmitted, (\d+)[ ,]} {
        set tx $expect_out(1,string); set rx $expect_out(2,string)
        puts "follower: ping summary -> $tx transmitted, $rx received"
        if {$tx != $rx} {
            puts "ERROR: ping drops detected (tx=$tx rx=$rx); aborting"
            quit_qemu $monitor_port; exit 1
        }
    }
}
set timeout $BUDGET_PROMPT_S
send "\r"
expect {
    timeout { puts "WARN: prompt didn't return after ping summary; continuing" }
    -re {# +}
}

if {[catch {set f [open $ping_wait_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $ping_wait_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "follower: ping OK; wrote $ping_wait_flag; continuing to docker cleanup."

# --- 4. Clear leftover containers + rendezvous ------------------------------

send "docker stop \$(docker ps -a -q) 2>/dev/null\r"
send "\r"
expect {
    timeout { puts "ERROR: docker stop didn't return prompt"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "docker rm \$(docker ps -a -q) 2>/dev/null\r"
send "\r"
expect {
    timeout { puts "ERROR: docker rm didn't return prompt"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}

if {[catch {set f [open $docker_wait_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $docker_wait_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "follower: docker cleared; wrote $docker_wait_flag; waiting for $docker_master_flag..."
wait_for_file $docker_master_flag $BUDGET_WORKLOAD_INIT_S

# --- 5. Wait for server up, then bring up eth1 internet on the guest --------
# eth1 = e1000 user-mode NAT; gives the client container internet for apt-get.
wait_for_file $server_ready_flag $BUDGET_WORKLOAD_INIT_S
puts "follower: server is up; bringing up eth1 internet for the client container..."
send "ip link set eth1 up\r"; send "\r"; expect -re {# +}
send "udhcpc -i eth1\r"
set timeout $BUDGET_PROMPT_S
send "\r"
expect { timeout { puts "ERROR: udhcpc eth1 timed out"; quit_qemu $monitor_port; exit 1 } -re {# +} }
send "echo 'nameserver 8.8.8.8' > /etc/resolv.conf\r"; send "\r"; expect -re {# +}
send "ping google.com -i 0.05 -W 100 -c 10\r"
set timeout 150
expect {
    timeout { puts "ERROR: ping google.com timed out (no internet on eth1)"; quit_qemu $monitor_port; exit 1 }
    -re {(\d+) packets transmitted, (\d+)[ ,]} {
        if {$expect_out(2,string) < 1} {
            puts "ERROR: ping google.com got 0 replies (no internet egress)"; quit_qemu $monitor_port; exit 1
        }
        puts "follower: internet OK ($expect_out(2,string) replies from google.com)"
    }
}
set timeout $BUDGET_PROMPT_S
send "\r"; expect { timeout { } -re {# +} }

# --- 6. Client container (bash entrypoint, privileged) + DNS + tools --------
# entrypoint bash so we can set up iptables inside; --privileged/--cap-add NET_ADMIN
# for the nat table. Container prompt assumed root@<host># (Debian root bash).
send "docker run -it --name media-streaming-client --entrypoint bash --network host --privileged --cap-add=NET_ADMIN -v \$(pwd)/videos:/videos xusine/media-streaming:client\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: client container didn't reach a bash prompt"; quit_qemu $monitor_port; exit 1 }
    -re {root@}
}
set timeout $BUDGET_PROMPT_S
send "\r"; expect { timeout { } -re {# +} }
puts "follower: in client container; setting DNS + installing tools..."
send "echo 'nameserver 8.8.8.8' > /etc/resolv.conf\r"; send "\r"; expect -re {# +}
# Marker-gate apt: its progress bars contain '# ' and would false-match a bare prompt
# regex. The PID marker can't appear in apt output or the typed echo (literal `$$`).
send "apt-get update; printf 'APTDONE%s\\n' \"\$\$\"\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: apt-get update timed out"; quit_qemu $monitor_port; exit 1 }
    -re {APTDONE[0-9]+}
}
set timeout $BUDGET_PROMPT_S
send "\r"; expect { timeout { } -re {# +} }
send "apt-get install -y iptables iputils-ping netcat-openbsd; printf 'APTDONE%s\\n' \"\$\$\"\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: apt-get install timed out"; quit_qemu $monitor_port; exit 1 }
    -re {APTDONE[0-9]+}
}
set timeout $BUDGET_PROMPT_S
send "\r"; expect { timeout { } -re {# +} }

# --- 7. DNAT localhost -> master (192.168.100.1) inside the container -------
send "cat > fix.sh << 'EOF'\r"
send "#!/bin/sh\r"
send "sysctl -w net.ipv4.conf.all.route_localnet=1\r"
send "iptables -t nat -A OUTPUT -d 127.0.0.1 -j DNAT --to-destination 192.168.100.1\r"
send "iptables -t nat -A POSTROUTING -d 192.168.100.1 -j MASQUERADE\r"
send "EOF\r"
send "\r"
expect { timeout { puts "ERROR: writing fix.sh timed out"; quit_qemu $monitor_port; exit 1 } -re {# +} }
send "chmod +x fix.sh\r"; send "\r"; expect -re {# +}
send "./fix.sh\r"
set timeout $BUDGET_PROMPT_S
send "\r"; expect { timeout { } -re {# +} }
# Re-add in the nft backend (the default 'iptables'); clear legacy-backend dupes first.
send "iptables-legacy -t nat -F OUTPUT\r";      send "\r"; expect { timeout { } -re {# +} }
send "iptables-legacy -t nat -F POSTROUTING\r"; send "\r"; expect { timeout { } -re {# +} }
send "sysctl -w net.ipv4.conf.all.route_localnet=1\r"; send "\r"; expect -re {# +}
send "iptables -t nat -A OUTPUT -d 127.0.0.1 -j DNAT --to-destination 192.168.100.1\r"; send "\r"; expect -re {# +}
send "iptables -t nat -A POSTROUTING -d 192.168.100.1 -j MASQUERADE\r"; send "\r"; expect -re {# +}
send "iptables -t nat -L OUTPUT -v -n\r";      send "\r"; expect -re {# +}
send "iptables -t nat -L POSTROUTING -v -n\r"; send "\r"; expect -re {# +}

# --- 8. Verify the remap: localhost must now traverse the wire (non-0 latency)
# ping 127.0.0.1 -> DNAT -> master. A ~0.0ms result means it stayed on loopback
# (DNAT not applied); require min latency above a small threshold.
send "ping 127.0.0.1 -i 0.05 -W 100 -c 10\r"
set timeout 150
expect {
    timeout { puts "ERROR: ping 127.0.0.1 timed out"; quit_qemu $monitor_port; exit 1 }
    -re {(\d+) packets transmitted, (\d+)[ ,]} {
        if {$expect_out(1,string) != $expect_out(2,string)} {
            puts "ERROR: ping 127.0.0.1 drops (DNAT path broken)"; quit_qemu $monitor_port; exit 1
        }
    }
}
expect {
    timeout { puts "ERROR: ping 127.0.0.1 no rtt line"; quit_qemu $monitor_port; exit 1 }
    -re {min/avg/max[^=]*= ([0-9.]+)/} {
        if {$expect_out(1,string) <= 0.1} {
            puts "ERROR: ping 127.0.0.1 min=$expect_out(1,string)ms ~0 => still loopback, DNAT not applied"; quit_qemu $monitor_port; exit 1
        }
        puts "follower: 127.0.0.1 remapped over wire (min=$expect_out(1,string)ms)"
    }
}
set timeout $BUDGET_PROMPT_S
send "\r"; expect { timeout { } -re {# +} }
send "ping 192.168.100.1 -i 0.05 -W 100 -c 10\r"
set timeout 150
expect {
    timeout { puts "ERROR: ping 192.168.100.1 timed out"; quit_qemu $monitor_port; exit 1 }
    -re {(\d+) packets transmitted, (\d+)[ ,]} {
        if {$expect_out(1,string) != $expect_out(2,string)} {
            puts "ERROR: ping 192.168.100.1 drops"; quit_qemu $monitor_port; exit 1
        }
    }
}
expect {
    timeout { puts "ERROR: ping 192.168.100.1 no rtt line"; quit_qemu $monitor_port; exit 1 }
    -re {min/avg/max[^=]*= ([0-9.]+)/} {
        if {$expect_out(1,string) <= 0.1} {
            puts "ERROR: ping 192.168.100.1 min=$expect_out(1,string)ms ~0 (invalid)"; quit_qemu $monitor_port; exit 1
        }
        puts "follower: wire to master OK (min=$expect_out(1,string)ms)"
    }
}
set timeout $BUDGET_PROMPT_S
send "\r"; expect { timeout { } -re {# +} }

# --- 9. nc data-path on :444 (127.0.0.1 -> DNAT -> master) ------------------
wait_for_file $nc_ready_flag $BUDGET_WORKLOAD_INIT_S
send "echo 'hello world' | nc -w 10 127.0.0.1 444\r"
puts "follower: sent 'hello world' to 127.0.0.1:444 (DNAT->master); waiting for nc_ok..."
wait_for_file $nc_ok_flag $BUDGET_WORKLOAD_INIT_S
send "\003"
set timeout $BUDGET_PROMPT_S
send "\r"; expect { timeout { } -re {# +} }
puts "follower: master confirmed nc (nc_ok); starting warm/load."

# --- 10. Warm + load (hammar; localhost -> DNAT -> master), pinned to cpu 0 -
send "ls\r"
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "ERROR: ls didn't show hammar"; quit_qemu $monitor_port; exit 1 }
    -re {hammar}
}
send "\r"; expect { timeout { } -re {# +} }
send "taskset -c 0 ./hammar/target/release/warm ./videos 1\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: warm didn't print 'Compressed history:'"; quit_qemu $monitor_port; exit 1 }
    -re {Compressed history:}
}
puts "follower: warm done; settling 5s before load..."
sleep 5
set timeout $BUDGET_PROMPT_S
send "\r"; expect { timeout { } -re {# +} }
send "taskset -c 0 ./hammar/target/release/hammar ./videos/logs 4 8 false\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: hammar load didn't print 'All tasks are created.'"; quit_qemu $monitor_port; exit 1 }
    -re {All tasks are created\.}
}
puts "follower: tasks created; client load done."

if {[catch {set f [open $client_done_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $client_done_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "follower: wrote $client_done_flag; waiting for own 'savevm log 7' in Load.log..."

# --- 11. Wait for own per-node savevm log 7 + 60s settle -------------------

wait_for_substring "$exp_folder/Load.log" "savevm log 7" $BUDGET_CHECKPOINTING_S
puts "follower: saw 'savevm log 7' — per-node savevm finalised. Sleeping 60s..."
sleep 60

quit_qemu $monitor_port
exit 0
