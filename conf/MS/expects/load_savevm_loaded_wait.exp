#!/usr/bin/env expect
# === DEBUG MODE =============================================================
# This script does NOT run hammar warm/load. After reaching the client
# container shell with the loopback DNAT (section 2.5) installed, the
# follower signals the master to take a distributed `savevm pooria-test`
# snapshot and exits once its own per-node save is finalised. Use
# `loadvm pooria-test` to resume manually and investigate from inside the
# wait alpine guest (e.g. `iptables -t nat -nvL OUTPUT` for DNAT counters,
# `curl -kv https://127.0.0.1/` from inside the client container, etc.).
# Once debugged, restore section 7-end to the warm + hammar load + done.flag
# flow (git diff).
#
# RESTORATION HINT: the load binary path is `./hammar/target/release/hammar`
# (parallels the warm binary at `./hammar/target/release/warm`). `./hammar`
# on its own is a directory and `bash: ./hammar: Is a directory` will fail
# the load. The first revision of this file had it wrong; don't reintroduce.
# ============================================================================
# MULTI-NODE FOLLOWER (node_number > 0) MS load. Loads from `booted`,
# brings up the PDES NIC, ping-verifies the wire to master (0-drop required),
# nc-preflights TCP/443 to master (matches the real hammar->nginx path),
# waits for master's server-ready sentinel, then runs hammar warm + hammar
# load on the serial spawn targeting master via $SERVER_IP. Signals master
# when 'All tasks are created.' appears, waits for its OWN per-node savevm
# log 7 (PDES drain cascade), sleeps 60s, then quits.
#
# Pair with conf/MS/expects/load_savevm_loaded_master.exp on node 0.
#
# === IN-IMAGE WORKLOAD SCRIPT REFERENCE ======================================
# One baked script lives in /home/qflex/ inside the alpine guest on this leaf.
# It is NOT REWRITTEN — the docker run has no --cpuset-cpus and no IP arg.
#
# ./run_client.sh    — NOT REWRITTEN.
#   #!/bin/sh
#   docker run -it --name media-streaming-client \
#       --network host \
#       -v $(pwd)/videos:/videos xusine/media-streaming:client
#
# === SERVER-IP REDIRECTION (kernel-level, not env-var) =======================
# Hammar's source HARDCODES `https://127.0.0.1/...` (warm.rs:66 in the
# xusine/media-streaming:client image — confirmed by the ConnectionRefused
# panic when run on a leaf without a local nginx). Env-var prefixes did
# nothing. We fix it the same way you'd fix any baked-in URL: rewrite the
# packet at the kernel. Before docker run client, the wait alpine guest
# installs an iptables OUTPUT DNAT 127.0.0.1:443 -> $SERVER_IP:443; since
# docker --net=host shares the guest's netns, the rule applies to the
# container's traffic too. route_localnet=1 lifts Linux's default-deny on
# routing 127.0.0.0/8 off the lo interface.
#
# TODO multi-node: hammar load is single-threaded here. Per-4-cores fan-out
# (see ./run_multiple.sh) is a later step once the basic path works.
# =============================================================================

set timeout 900

set BUDGET_INITIAL_S        10
set BUDGET_DEFAULT_S         5
set BUDGET_PROMPT_S         60
set BUDGET_WORKLOAD_INIT_S 43200   ; # 12h client budget (hammar warm/load can take minutes-hours wall-clock under emulation)
set BUDGET_CHECKPOINTING_S 10800

set SERVER_IP "192.168.100.1"   ; # master's PDES wire IP — the only place this is set

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)
set exp_folder   $env(EXP_FOLDER)

catch {file mkdir $exp_folder}
log_file -noappend "$exp_folder/expect_log.txt"

if {[info exists env(GROUP_EXP_FOLDER)]} {
    set group_folder $env(GROUP_EXP_FOLDER)
} else {
    set group_folder [file dirname $exp_folder]
}
set wire_master_flag     "$group_folder/ms_load_wire_master.flag"
set wire_wait_flag       "$group_folder/ms_load_wire_wait.flag"
set nc_listen_ready_flag "$group_folder/ms_load_nc_listen_ready.flag"
set server_ready_flag    "$group_folder/ms_load_server_ready.flag"
set done_flag            "$group_folder/ms_load_done.flag"
catch {file delete -force $wire_wait_flag}
catch {file delete -force $done_flag}

proc connect_telnet {host port {budget_seconds 5}} {
    global timeout
    set saved_timeout $timeout
    set timeout 5
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        spawn telnet $host $port
        set this_sid $spawn_id
        set ok 0
        expect {
            -re "Escape character is" { set ok 1 }
            -re "Connection refused" { }
            timeout { }
            eof { }
        }
        if {$ok} {
            set timeout $saved_timeout
            return $this_sid
        }
        catch {close -i $this_sid}
        catch {wait -i $this_sid}
        sleep 2
    }
    set timeout $saved_timeout
    error "connect_telnet: gave up after ${budget_seconds}s polling $host:$port"
}

proc quit_qemu {monitor_port} {
    global BUDGET_DEFAULT_S
    if {[catch {connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S} sid]} {
        return
    }
    set timeout $BUDGET_DEFAULT_S
    expect {
        -i $sid
        timeout { puts "quit_qemu: monitor didn't prompt" }
        "(qemu) " {
            send -i $sid "quit\r"
            catch {expect -i $sid eof}
        }
    }
}

proc wait_for_file {path budget_seconds} {
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        if {[file exists $path]} { return }
        sleep 2
    }
    error "wait_for_file: $path never appeared within ${budget_seconds}s"
}

proc wait_for_substring {path needle budget_seconds} {
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        if {[file exists $path]} {
            set fh [open $path r]; set content [read $fh]; close $fh
            if {[string first $needle $content] >= 0} { return }
        }
        sleep 2
    }
    error "wait_for_substring: $needle never appeared in $path within ${budget_seconds}s"
}

# --- 1. Connect serial + nudge for post-loadvm prompt -----------------------

set serial_sid [connect_telnet 127.0.0.1 $serial_port $BUDGET_INITIAL_S]
set spawn_id $serial_sid

set timeout $BUDGET_PROMPT_S
send "\r"
expect {
    timeout { puts "ERROR: shell prompt timed out after loadvm"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 10

# --- 2. IP bring-up on the PDES NIC (eth0); drop back to qflex --------------

send "su\r"
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "ERROR: never reached root prompt after su"; quit_qemu $monitor_port; exit 1 }
    -re {[Aa]uthentication failure|incorrect password} {
        puts "ERROR: su rejected empty creds"; quit_qemu $monitor_port; exit 1
    }
    -re {[Ll]ogin: }    { send "\r"; exp_continue }
    -re {[Pp]assword: } { send "\r"; exp_continue }
    -re {# +}
}
send "ip link show\r";                               expect -re {# +}
send "ip link set eth0 down\r";                      expect -re {# +}
send "ip link set eth0 address 52:54:00:aa:bb:0a\r"; expect -re {# +}
send "ip link set eth0 up\r";                        expect -re {# +}
send "ip addr flush dev eth0\r"
expect {
    timeout { puts "ERROR: ip addr flush timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "ip addr add 192.168.100.2/24 dev eth0\r";      expect -re {# +}
send "ip addr show eth0\r";                          expect -re {# +}

# --- 2.5 Loopback DNAT for hammar's hardcoded 127.0.0.1 (root only) --------
# See header "SERVER-IP REDIRECTION" banner. Must run before docker run
# client. Rule survives across su qflex since iptables lives in the kernel.
send "sysctl -w net.ipv4.conf.all.route_localnet=1\r"
expect {
    timeout { puts "ERROR: sysctl route_localnet timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "iptables -t nat -A OUTPUT -p tcp -d 127.0.0.1 --dport 443 -j DNAT --to-destination $SERVER_IP:443\r"
expect {
    timeout { puts "ERROR: iptables DNAT install timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
puts "follower: installed loopback DNAT 127.0.0.1:443 -> $SERVER_IP:443."

send "su qflex\r";                                   expect -re {\$ +}

sleep 5

# --- 3. Ping verify the wire to master (0-drop required) -------------------

send "ping $SERVER_IP -i 0.05 -c 10\r"
set timeout 120
expect {
    timeout { puts "ERROR: ping summary didn't arrive within 120s"; quit_qemu $monitor_port; exit 1 }
    -re {(\d+) packets transmitted, (\d+)[ ,]} {
        set tx $expect_out(1,string); set rx $expect_out(2,string)
        puts "follower: ping summary -> $tx transmitted, $rx received"
        if {$tx != $rx} {
            puts "ERROR: ping drops detected (tx=$tx rx=$rx); aborting"
            quit_qemu $monitor_port; exit 1
        }
    }
}
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "WARN: prompt didn't return after ping summary; continuing" }
    -re {[\$#] +}
}

sleep 5

# --- 4. Wire-ready handshake ------------------------------------------------

if {[catch {set f [open $wire_wait_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $wire_wait_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "follower: wire verified; wrote $wire_wait_flag; waiting for $wire_master_flag..."
wait_for_file $wire_master_flag $BUDGET_PROMPT_S

# --- 5. nc data-path preflight: connect to master:443 and send a token ------
puts "follower: waiting for master's nc listener ($nc_listen_ready_flag)..."
wait_for_file $nc_listen_ready_flag $BUDGET_PROMPT_S
# -w 2 => nc closes 2s after sending instead of hanging for the server to close.
send "echo 'Hello from VM2!' | nc -w 2 $SERVER_IP 443\r"
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "ERROR: nc send timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
puts "follower: sent 'Hello from VM2!' to $SERVER_IP:443."

# --- 6. Wait for master's nginx to be ready --------------------------------

puts "follower: waiting for $server_ready_flag..."
wait_for_file $server_ready_flag $BUDGET_WORKLOAD_INIT_S
puts "follower: master's server-ready signal received; launching client container."

# --- 6.5 Docker cleanup (any leftover containers from prior runs) ----------

send "docker stop \$(docker ps -a -q) 2>/dev/null\r"
expect {
    timeout { puts "ERROR: docker stop didn't return prompt"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
send "docker rm \$(docker ps -a -q) 2>/dev/null\r"
expect {
    timeout { puts "ERROR: docker rm didn't return prompt"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

# --- 7. Enter client container + signal master to savevm pooria-test -------
# DEBUG MODE: we DO NOT run hammar warm/load here. The wait gets into the
# client container with the DNAT (section 2.5) installed and the server
# pingable+nc-verified, then asks the master to take a distributed
# `savevm pooria-test` snapshot. Once the per-node save is finalised
# (deterministic `savevm log 7` in Load.log) we exit. The user can then
# `loadvm pooria-test` interactively and investigate why hammar's
# https://127.0.0.1/... still hits ConnectionRefused (e.g. iptables -nvL
# OUTPUT to see DNAT counters, curl -k https://127.0.0.1/ for the actual
# error, etc.).

set pooria_test_ready_flag "$group_folder/ms_load_pooria_test_ready.flag"
catch {file delete -force $pooria_test_ready_flag}

send "./run_client.sh\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: client container prompt didn't arrive"; quit_qemu $monitor_port; exit 1 }
    -re {root@qflex:/#}
}
puts "follower: inside client container; sanity-check hammar..."

send "ls\r"
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "ERROR: ls didn't return"; quit_qemu $monitor_port; exit 1 }
    -re {hammar}
}
expect {
    timeout { }
    -re {root@qflex:/#}
}
puts "follower: hammar present; signalling master to savevm pooria-test..."

if {[catch {set f [open $pooria_test_ready_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $pooria_test_ready_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "follower: wrote $pooria_test_ready_flag; waiting for own 'savevm log 7' in Load.log..."

# --- 8. Wait for own per-node pooria-test savevm to finalise ---------------

wait_for_substring "$exp_folder/Load.log" "savevm log 7" $BUDGET_CHECKPOINTING_S
puts "follower: saw 'savevm log 7' — pooria-test snapshot captured. Sleeping 60s for master settle..."
sleep 60

quit_qemu $monitor_port
exit 0
