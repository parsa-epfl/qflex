#!/usr/bin/env expect
# MULTI-NODE FOLLOWER (node_number > 0) MS boot. Boots Alpine, logs in as
# qflex/qflex, writes its login sentinel, waits for master's login sentinel,
# then polls its OWN Boot.log for `savevm log 7` (the deterministic marker
# that the PDES drain has finalised our per-node snapshot). Does NOT issue
# `savevm` over the monitor — savevm is master-only on multi-node.
#
# Pair with conf/MS/expects/boot_savevm_booted_master.exp on node 0.

set timeout 900

set BUDGET_INITIAL_S        10
set BUDGET_DEFAULT_S         5
set BUDGET_PROMPT_S         60
set BUDGET_BOOT_LOGIN_S   1800
set BUDGET_CHECKPOINTING_S 1800

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)
set exp_folder   $env(EXP_FOLDER)

catch {file mkdir $exp_folder}
log_file -noappend "$exp_folder/expect_log.txt"

if {[info exists env(GROUP_EXP_FOLDER)]} {
    set group_folder $env(GROUP_EXP_FOLDER)
} else {
    set group_folder [file dirname $exp_folder]
}
set master_login_flag "$group_folder/ms_boot_master_login.flag"
set wait_login_flag   "$group_folder/ms_boot_wait_login.flag"
catch {file delete -force $wait_login_flag}

proc connect_telnet {host port {budget_seconds 5}} {
    global timeout
    set saved_timeout $timeout
    set timeout 5
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        spawn telnet $host $port
        set this_sid $spawn_id
        set ok 0
        expect {
            -re "Escape character is" { set ok 1 }
            -re "Connection refused" { }
            timeout { }
            eof { }
        }
        if {$ok} {
            set timeout $saved_timeout
            return $this_sid
        }
        catch {close -i $this_sid}
        catch {wait -i $this_sid}
        sleep 2
    }
    set timeout $saved_timeout
    error "connect_telnet: gave up after ${budget_seconds}s polling $host:$port"
}

proc quit_qemu {monitor_port} {
    global BUDGET_DEFAULT_S
    if {[catch {connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S} sid]} {
        return
    }
    set timeout $BUDGET_DEFAULT_S
    expect {
        -i $sid
        timeout { puts "quit_qemu: monitor didn't prompt" }
        "(qemu) " {
            send -i $sid "quit\r"
            catch {expect -i $sid eof}
        }
    }
}

proc wait_for_file {path budget_seconds} {
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        if {[file exists $path]} { return }
        sleep 2
    }
    error "wait_for_file: $path never appeared within ${budget_seconds}s"
}

proc wait_for_substring {path needle budget_seconds} {
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        if {[file exists $path]} {
            set fh [open $path r]; set content [read $fh]; close $fh
            if {[string first $needle $content] >= 0} { return }
        }
        sleep 2
    }
    error "wait_for_substring: $needle never appeared in $path within ${budget_seconds}s"
}

# --- 1. Connect serial + login as qflex/qflex --------------------------------

set serial_sid [connect_telnet 127.0.0.1 $serial_port $BUDGET_INITIAL_S]
set spawn_id $serial_sid

set timeout $BUDGET_BOOT_LOGIN_S
send "\r"
expect {
    timeout { puts "ERROR: login prompt timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[Ll]ogin: }
}

set timeout $BUDGET_PROMPT_S
send "qflex\r"
expect {
    timeout { puts "ERROR: password prompt timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[Pp]assword: }
}
send "qflex\r"
expect {
    timeout { puts "ERROR: shell prompt timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 5

send "ls\r"
expect {
    timeout { puts "ERROR: ls didn't return"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 5

# --- 1.5 Bake internet + socat localhost->master forwarder into snapshot ----
# Runs BEFORE ms_boot_wait_login.flag so master's savevm booted waits until
# socat is live. Everything stays in the guest's kernel/process state, so
# loadvm-resumed phases inherit a working 127.0.0.1:443 -> $SERVER_IP:443
# proxy with no per-run setup race. Stays at `#` (root) for the rest of the
# boot expect.

set SERVER_IP "192.168.100.1"

send "su\r"
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "ERROR: never reached root prompt after su"; quit_qemu $monitor_port; exit 1 }
    -re {[Aa]uthentication failure|incorrect password} { puts "ERROR: su rejected empty creds"; quit_qemu $monitor_port; exit 1 }
    -re {[Ll]ogin: }    { send "\r"; exp_continue }
    -re {[Pp]assword: } { send "\r"; exp_continue }
    -re {# +}
}

send "ip link set eth1 up\r"; expect -re {# +}
send "udhcpc -i eth1\r";       expect -re {# +}

send "echo 'nameserver 10.0.2.3' > /etc/resolv.conf\r";  expect -re {# +}
send "echo 'nameserver 8.8.8.8'  >> /etc/resolv.conf\r"; expect -re {# +}

set timeout $BUDGET_BOOT_LOGIN_S
send "apk add iproute2\r"
expect {
    timeout { puts "ERROR: apk add iproute2 timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "apk add socat\r"
expect {
    timeout { puts "ERROR: apk add socat timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}

set timeout $BUDGET_PROMPT_S
send "iptables -t nat -F OUTPUT\r"; expect -re {# +}

send "socat TCP-LISTEN:443,bind=127.0.0.1,reuseaddr,fork TCP:$SERVER_IP:443 &\r"
expect -re {# +}
sleep 2

send "ss -tln | grep 127.0.0.1:443\r"
expect {
    timeout { puts "ERROR: ss didn't return after socat verify"; quit_qemu $monitor_port; exit 1 }
    -re {127\.0\.0\.1:443} { puts "follower: socat listening on 127.0.0.1:443 -> $SERVER_IP:443" }
}
expect -re {# +}
sleep 5

# --- 2. Sentinel handshake: announce we're at shell, wait for master --------

if {[catch {set f [open $wait_login_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $wait_login_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "follower: wrote $wait_login_flag; waiting for master at $master_login_flag..."
wait_for_file $master_login_flag $BUDGET_BOOT_LOGIN_S
puts "follower: master at shell; waiting for our own 'savevm log 7' in Boot.log..."

# --- 3. Wait for our OWN per-node savevm to finalise ------------------------

wait_for_substring "$exp_folder/Boot.log" "savevm log 7" $BUDGET_CHECKPOINTING_S
puts "follower: saw 'savevm log 7' — per-node savevm complete; exiting."
exit 0
