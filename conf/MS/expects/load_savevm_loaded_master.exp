#!/usr/bin/env expect
# MULTI-NODE MASTER (node_number == 0) MS load. Loads from `booted`, brings up
# the PDES NIC (eth0 = 192.168.100.1), ping- and nc-verifies the wire to the
# follower, then runs the cloudsuite media-streaming server (nginx) in a single
# tmux window, signals the follower to start its client, waits for the client to
# finish, and `savevm loaded` via the monitor.
#
# Pair with conf/MS/expects/load_savevm_loaded_wait.exp on the follower. PDES
# `savevm` is a distributed snapshot — only the master issues it; the follower
# just polls its own Load.log for `savevm log 7`.

set timeout 900

set BUDGET_INITIAL_S        10
set BUDGET_DEFAULT_S         5
set BUDGET_PROMPT_S          120
set BUDGET_WORKLOAD_INIT_S 86400   ; # 24h: server init + waiting for follower's client (can be many hours under PDES)
set BUDGET_CHECKPOINTING_S 10800

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)
set exp_folder   $env(EXP_FOLDER)

catch {file mkdir $exp_folder}
log_file -noappend "$exp_folder/expect_log.txt"

if {[info exists env(GROUP_EXP_FOLDER)]} {
    set group_folder $env(GROUP_EXP_FOLDER)
} else {
    set group_folder [file dirname $exp_folder]
}
set docker_master_flag "$group_folder/ms_load_docker_master.flag"
set docker_wait_flag   "$group_folder/ms_load_docker_wait.flag"
set wire_master_flag   "$group_folder/ms_load_wire_master.flag"
set wire_wait_flag     "$group_folder/ms_load_wire_wait.flag"
set ping_master_flag   "$group_folder/ms_load_ping_master.flag"
set ping_wait_flag     "$group_folder/ms_load_ping_wait.flag"
set nc_ready_flag      "$group_folder/ms_load_nc_ready.flag"
set nc_ok_flag         "$group_folder/ms_load_nc_ok.flag"
set server_ready_flag  "$group_folder/ms_load_server_ready.flag"
set client_done_flag   "$group_folder/ms_load_client_done.flag"
catch {file delete -force $docker_master_flag}
catch {file delete -force $wire_master_flag}
catch {file delete -force $ping_master_flag}
catch {file delete -force $nc_ready_flag}
catch {file delete -force $nc_ok_flag}
catch {file delete -force $server_ready_flag}

proc connect_telnet {host port {budget_seconds 5}} {
    global timeout
    set saved_timeout $timeout
    set timeout 5
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        spawn telnet $host $port
        set this_sid $spawn_id
        set ok 0
        expect {
            -re "Escape character is" { set ok 1 }
            -re "Connection refused" { }
            timeout { }
            eof { }
        }
        if {$ok} {
            set timeout $saved_timeout
            return $this_sid
        }
        catch {close -i $this_sid}
        catch {wait -i $this_sid}
        sleep 2
    }
    set timeout $saved_timeout
    error "connect_telnet: gave up after ${budget_seconds}s polling $host:$port"
}

proc quit_qemu {monitor_port} {
    global BUDGET_DEFAULT_S
    if {[catch {connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S} sid]} {
        return
    }
    set timeout $BUDGET_DEFAULT_S
    expect {
        -i $sid
        timeout { puts "quit_qemu: monitor didn't prompt" }
        "(qemu) " {
            send -i $sid "quit\r"
            catch {expect -i $sid eof}
        }
    }
}

proc wait_for_file {path budget_seconds} {
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        if {[file exists $path]} { return }
        sleep 2
    }
    error "wait_for_file: $path never appeared within ${budget_seconds}s"
}

proc wait_for_substring {path needle budget_seconds} {
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        if {[file exists $path]} {
            set fh [open $path r]; set content [read $fh]; close $fh
            if {[string first $needle $content] >= 0} { return }
        }
        sleep 2
    }
    error "wait_for_substring: $needle never appeared in $path within ${budget_seconds}s"
}

# Poll a tmux pane for a literal substring, fail-fast on bash syntax errors.
proc wait_for_pane_substring {session window needle budget_seconds} {
    global timeout
    set saved_timeout $timeout
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        send "tmux capture-pane -t ${session}:${window} -p\r"
        set buf ""
        set timeout 5
        expect {
            -re {.+} { append buf $expect_out(buffer); exp_continue }
            timeout { }
        }
        if {[string first $needle $buf] >= 0} { set timeout $saved_timeout; return }
        foreach err {"bash: syntax error" "syntax error near unexpected"} {
            if {[string first $err $buf] >= 0} {
                set timeout $saved_timeout
                error "wait_for_pane_substring: bash error in $session:$window: '$err' (waiting for '$needle')"
            }
        }
        sleep 2
    }
    set timeout $saved_timeout
    error "wait_for_pane_substring: '$needle' never in $session:$window within ${budget_seconds}s"
}

# --- 1. Connect serial + nudge for post-loadvm prompt; su to root -----------

set serial_sid [connect_telnet 127.0.0.1 $serial_port $BUDGET_INITIAL_S]
set spawn_id $serial_sid

set timeout $BUDGET_PROMPT_S
send "\r"
expect {
    timeout { puts "ERROR: shell prompt timed out after loadvm"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 5

send "su\r"
expect {
    timeout { puts "ERROR: never reached root prompt after su"; quit_qemu $monitor_port; exit 1 }
    -re {[Aa]uthentication failure|incorrect password} {
        puts "ERROR: su rejected empty creds"; quit_qemu $monitor_port; exit 1
    }
    -re {[Ll]ogin: }    { send "\r"; exp_continue }
    -re {[Pp]assword: } { send "\r"; exp_continue }
    -re {# +}
}

# --- 2. IP bring-up on the PDES NIC (eth0 = 192.168.100.1) ------------------
# TODO: get the eth0 MAC from the experiment context (commands/config.py derives
# it per node) instead of hard-coding 52:54:00:aa:bb:00 here.
send "ip link set eth0 down\r";                      send "\r"; expect -re {# +}
send "ip link set eth0 address 52:54:00:aa:bb:00\r"; send "\r"; expect -re {# +}
send "ip link set eth0 up\r";                        send "\r"; expect -re {# +}
send "ip addr flush dev eth0\r"
send "\r"
expect {
    timeout { puts "ERROR: ip addr flush timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "ip addr add 192.168.100.1/24 dev eth0\r";   send "\r"; expect -re {# +}
send "ip addr show eth0\r";                        send "\r"; expect -re {# +}

if {[catch {set f [open $wire_master_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $wire_master_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "master: eth0 up at 192.168.100.1; wrote $wire_master_flag; waiting for $wire_wait_flag..."
wait_for_file $wire_wait_flag $BUDGET_PROMPT_S

# --- 3. Ping verify the wire to follower FIRST (0-drop required) ------------
# Serialised: master pings while the follower waits ($ping_master_flag), then
# the follower pings while the master waits ($ping_wait_flag) — no overlap.

send "ping 192.168.100.2 -i 0.05 -W 100 -c 10\r"
set timeout 150
expect {
    timeout { puts "ERROR: ping summary didn't arrive within 150s"; quit_qemu $monitor_port; exit 1 }
    -re {(\d+) packets transmitted, (\d+)[ ,]} {
        set tx $expect_out(1,string); set rx $expect_out(2,string)
        puts "master: ping summary -> $tx transmitted, $rx received"
        if {$tx != $rx} {
            puts "ERROR: ping drops detected (tx=$tx rx=$rx); aborting"
            quit_qemu $monitor_port; exit 1
        }
    }
}
set timeout $BUDGET_PROMPT_S
send "\r"
expect {
    timeout { puts "WARN: prompt didn't return after ping summary; continuing" }
    -re {# +}
}

if {[catch {set f [open $ping_master_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $ping_master_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "master: ping OK; wrote $ping_master_flag; waiting for follower's ping ($ping_wait_flag)..."
wait_for_file $ping_wait_flag $BUDGET_WORKLOAD_INIT_S
puts "master: follower's ping done; continuing to docker cleanup."

# --- 4. Clear leftover containers + rendezvous ------------------------------

send "docker stop \$(docker ps -a -q) 2>/dev/null\r"
send "\r"
expect {
    timeout { puts "ERROR: docker stop didn't return prompt"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "docker rm \$(docker ps -a -q) 2>/dev/null\r"
send "\r"
expect {
    timeout { puts "ERROR: docker rm didn't return prompt"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}

if {[catch {set f [open $docker_master_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $docker_master_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "master: docker cleared; wrote $docker_master_flag; waiting for $docker_wait_flag..."
wait_for_file $docker_wait_flag $BUDGET_WORKLOAD_INIT_S

# --- 5. Server in a single tmux window (nginx foregrounds) ------------------
# run_server.sh: docker run --entrypoint=bash --cpuset-cpus=0 ... cloudsuite
# media-streaming:server -> root shell inside the server container.
# ./etc/entrypoint.sh: openssl + sed + nginx -g 'daemon off;'. The openssl cert
# footer '-----' is the last output before nginx execs; after it nginx is up.

send "tmux new-session -d -s ms\r"
send "\r"
expect {
    timeout { puts "ERROR: tmux new-session timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "tmux send-keys -t ms:0 './run_server.sh' Enter\r"
send "\r"
expect {
    timeout { puts "ERROR: dispatching run_server.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
puts "ms: window 0 (server) launched; waiting for 'root@qflex:/#'..."
wait_for_pane_substring ms 0 "root@qflex:/#" $BUDGET_WORKLOAD_INIT_S
puts "ms: server container at root shell; dispatching ./etc/entrypoint.sh..."

send "tmux send-keys -t ms:0 './etc/entrypoint.sh' Enter\r"
send "\r"
expect {
    timeout { puts "ERROR: dispatching entrypoint.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
puts "ms: entrypoint.sh dispatched; waiting for openssl cert footer '-----'..."
wait_for_pane_substring ms 0 "-----" $BUDGET_WORKLOAD_INIT_S
puts "ms: server cert generated; nginx daemon should be up. Settling 5s..."
sleep 5

# --- 6. Signal follower that the server is up -------------------------------

if {[catch {set f [open $server_ready_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $server_ready_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "master: wrote $server_ready_flag."

# --- 7. nc data-path on :444 (AFTER server; 443 is the live nginx) ----------
# Write nc_ready BEFORE listening; the follower, once inside its container with
# the localhost->master DNAT set up, sends a token to 127.0.0.1:444 (DNATs to us).
# Ctrl-C frees the shell the instant it lands, then nc_ok tells the follower the
# data path works so it can start the workload.
if {[catch {set f [open $nc_ready_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $nc_ready_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "master: wrote $nc_ready_flag; listening on :444 for the client's token..."
send "nc -l -p 444\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: nc preflight: no token on :444 (client DNAT path broken)"; quit_qemu $monitor_port; exit 1 }
    -re {hello world} { puts "master: nc preflight OK -- received 'hello world' over :444" }
}
send "\003"
set timeout $BUDGET_PROMPT_S
send "\r"
send "\r"; expect { timeout { } -re {# +} }
if {[catch {set f [open $nc_ok_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $nc_ok_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "master: wrote $nc_ok_flag; waiting for follower's client to finish..."

# --- 8. Wait for follower's client done -------------------------------------

wait_for_file $client_done_flag $BUDGET_WORKLOAD_INIT_S
puts "master: follower's client finished; proceeding to savevm loaded."

catch {close -i $serial_sid}
catch {wait -i $serial_sid}

# --- 9. savevm loaded via the monitor ---------------------------------------

set monitor_sid [connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S]
set spawn_id $monitor_sid

set timeout $BUDGET_DEFAULT_S
expect {
    timeout { puts "ERROR: monitor prompt timed out"; exit 1 }
    "(qemu) "
}

set timeout $BUDGET_CHECKPOINTING_S
send "delvm loaded\r"
expect {
    timeout { puts "WARN: delvm didn't return; continuing anyway" }
    "(qemu) "
}
send "savevm loaded\r"
expect {
    timeout { puts "ERROR: savevm didn't return"; exit 1 }
    "(qemu) "
}

puts "master: savevm returned; polling Load.log for 'savevm log 7'..."
wait_for_substring "$exp_folder/Load.log" "savevm log 7" $BUDGET_CHECKPOINTING_S
puts "master: saw 'savevm log 7' — savevm-loaded finalised. Sleeping 60s..."
sleep 60

send "quit\r"
catch {expect eof}
exit 0
