#!/usr/bin/env expect
# SINGLE-NODE MS load. Loads from `booted`, runs two docker containers on ONE
# QEMU guest:
#   server: cloudsuite/media-streaming:server (nginx in docker)
#   client: xusine/media-streaming:client (hammar warm + hammar load)
# Both communicate over the guest's 127.0.0.1 (docker --net host). Each runs
# backgrounded with output to a log we tail for its readiness marker; once the
# hammar load reports tasks created, `savevm loaded` and quit.
#
# Wire into a YAML's `load:` section:
#   experiment_context:
#     interaction_script: /home/dev/qflex/conf/MS/expects/load_savevm_loaded_single.exp
#     loadvm_name:        booted
#
# Single-node guest has 2 vCPUs (core_count=1 × doubled_vcpu=true). run_server.sh
# pins the server docker to host cpu 0 (--cpuset-cpus=0); the client's hammar is
# taskset'd to cpu 1 (the doubled-vcpu phantom). run_server.sh / run_client.sh are
# rewritten here so the in-container commands run as the docker entrypoint
# (the mounted entrypoint.sh for the server; ms_client_entry.sh for the client).
#
# TODO multi-node: hammar load currently pinned to core 1 (vCPU 1, the
# doubled-vcpu phantom). Multi-node single-core-per-leaf will be core 0.
# Per-4-cores fan-out (see ./run_multiple.sh) is a later step.

set timeout 900

set BUDGET_INITIAL_S        10
set BUDGET_DEFAULT_S         5
set BUDGET_PROMPT_S         120
set BUDGET_WORKLOAD_INIT_S 86400   ; # 24h client budget (hammar warm/load can take minutes-hours wall-clock under emulation)
set BUDGET_CHECKPOINTING_S 1800

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)
set exp_folder   $env(EXP_FOLDER)

catch {file mkdir $exp_folder}
log_file -noappend "$exp_folder/expect_log.txt"

proc connect_telnet {host port {budget_seconds 5}} {
    global timeout
    set saved_timeout $timeout
    set timeout 5
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        spawn telnet $host $port
        set this_sid $spawn_id
        set ok 0
        expect {
            -re "Escape character is" { set ok 1 }
            -re "Connection refused" { }
            timeout { }
            eof { }
        }
        if {$ok} {
            set timeout $saved_timeout
            return $this_sid
        }
        catch {close -i $this_sid}
        catch {wait -i $this_sid}
        sleep 2
    }
    set timeout $saved_timeout
    error "connect_telnet: gave up after ${budget_seconds}s polling $host:$port"
}

proc quit_qemu {monitor_port} {
    global BUDGET_DEFAULT_S
    if {[catch {connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S} sid]} {
        return
    }
    set timeout $BUDGET_DEFAULT_S
    expect {
        -i $sid
        timeout { puts "quit_qemu: monitor didn't prompt" }
        "(qemu) " {
            send -i $sid "quit\r"
            catch {expect -i $sid eof}
        }
    }
}

# --- 1. Connect serial + nudge for shell prompt (post-loadvm) ---------------

set serial_sid [connect_telnet 127.0.0.1 $serial_port $BUDGET_INITIAL_S]
set spawn_id $serial_sid

set timeout $BUDGET_PROMPT_S
send "\r"
expect {
    timeout { puts "ERROR: shell prompt timed out after loadvm"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 5

# --- 2. Clear any leftover containers from a prior run ----------------------
# Best-effort: if there are none, docker errors out cleanly and we move on.

send "docker stop \$(docker ps -a -q) 2>/dev/null\r"
expect {
    timeout { puts "ERROR: docker stop didn't return prompt"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
send "docker rm \$(docker ps -a -q) 2>/dev/null\r"
expect {
    timeout { puts "ERROR: docker rm didn't return prompt"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

# --- 3. Server: nginx via /etc/entrypoint.sh (mounted) as the container entrypoint -
# run_server.sh rewritten non-interactively (no tmux); the mounted entrypoint.sh
# does openssl + sed + `nginx -g 'daemon off;'` (foreground), so the backgrounded
# run is captured running by savevm. cpuset=0 keeps server work on core 0.

send "cat > ./run_server.sh <<'WRITE_SERVER_EOF'\r"
send "#!/bin/sh\r"
send "docker run --rm --net host --cpuset-cpus=0 \\\r"
send "    -v \$(pwd)/videos:/videos \\\r"
send "    -v \$(pwd)/entrypoint.sh:/etc/entrypoint.sh \\\r"
send "    --entrypoint=/etc/entrypoint.sh \\\r"
send "    cloudsuite/media-streaming:server\r"
send "WRITE_SERVER_EOF\r"
expect { timeout { puts "ERROR: writing run_server.sh timed out"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }
send "chmod +x ./run_server.sh\r"
expect { timeout { puts "ERROR: chmod run_server.sh timed out"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }

send "./run_server.sh > /tmp/ms_server.out 2>&1 < /dev/null &\r"
expect { timeout { puts "ERROR: server launch didn't return prompt"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }
puts "ms: server launched; tailing /tmp/ms_server.out for openssl cert footer '-----'..."
send "tail -f /tmp/ms_server.out\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: server didn't print openssl cert footer '-----'"; quit_qemu $monitor_port; exit 1 }
    -re {-----}
}
send "\003"
set timeout $BUDGET_PROMPT_S
expect { timeout { } -re {[\$#] +} }
puts "ms: server cert generated; nginx daemon should be up. Settling 5s..."
sleep 5

# --- 4. Client: warm + hammar load via ms_client_entry.sh as the container entrypoint -
# The entry's last line (hammar load) stays foreground so the backgrounded client
# is captured running. taskset -c 1 keeps client work on core 1 (single-node).

send "cat > ./ms_client_entry.sh <<'WRITE_CLIENT_ENTRY_EOF'\r"
send "#!/bin/sh\r"
send "taskset -c 1 ./hammar/target/release/warm ./videos 1\r"
send "taskset -c 1 ./hammar/target/release/hammar ./videos/logs 4 8 false\r"
send "WRITE_CLIENT_ENTRY_EOF\r"
expect { timeout { puts "ERROR: writing ms_client_entry.sh timed out"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }
send "chmod +x ./ms_client_entry.sh\r"
expect { timeout { puts "ERROR: chmod ms_client_entry.sh timed out"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }

send "cat > ./run_client.sh <<'WRITE_CLIENT_EOF'\r"
send "#!/bin/sh\r"
send "docker run --name media-streaming-client --network host \\\r"
send "    -v \$(pwd)/videos:/videos \\\r"
send "    -v \$(pwd)/ms_client_entry.sh:/ms_client_entry.sh \\\r"
send "    --entrypoint=/ms_client_entry.sh \\\r"
send "    xusine/media-streaming:client\r"
send "WRITE_CLIENT_EOF\r"
expect { timeout { puts "ERROR: writing run_client.sh timed out"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }
send "chmod +x ./run_client.sh\r"
expect { timeout { puts "ERROR: chmod run_client.sh timed out"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }

send "./run_client.sh > /tmp/ms_client.out 2>&1 < /dev/null &\r"
expect { timeout { puts "ERROR: client launch didn't return prompt"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }
puts "ms: client launched; tailing /tmp/ms_client.out for 'All tasks are created.' x4..."
send "tail -f /tmp/ms_client.out\r"
set timeout $BUDGET_WORKLOAD_INIT_S
set tasks_created 0
expect {
    timeout { puts "ERROR: hammar load printed 'All tasks are created.' only $tasks_created/4 times"; quit_qemu $monitor_port; exit 1 }
    -re {All tasks are created\.} {
        incr tasks_created
        if {$tasks_created < 4} { exp_continue }
    }
}
puts "ms: tasks created; settling 5s host time before savevm..."
send "\003"
set timeout $BUDGET_PROMPT_S
expect { timeout { } -re {[\$#] +} }
sleep 5

catch {close -i $serial_sid}
catch {wait -i $serial_sid}

# --- 6. savevm loaded via the monitor ---------------------------------------

set monitor_sid [connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S]
set spawn_id $monitor_sid

set timeout $BUDGET_DEFAULT_S
expect {
    timeout { puts "ERROR: monitor prompt timed out"; exit 1 }
    "(qemu) "
}

set timeout $BUDGET_CHECKPOINTING_S
send "delvm loaded\r"
expect {
    timeout { puts "WARN: delvm didn't return; continuing anyway" }
    "(qemu) "
}
send "savevm loaded\r"
expect {
    timeout { puts "ERROR: savevm didn't return"; exit 1 }
    "(qemu) "
}

send "quit\r"
catch {expect eof}
exit 0
