#!/usr/bin/env expect
# SINGLE-NODE DS load. Loads from `booted`, runs two docker containers on ONE
# QEMU guest:
#   server: abdu1998a/dataserving:server (Cassandra via docker-entrypoint.py)
#   client: abdu1998a/dataserving:client (YCSB warmup + load)
# Both communicate over the guest's 127.0.0.1 (docker --net host). Each runs
# backgrounded with output to a log we tail for its readiness marker; once the
# YCSB load reports its first throughput line, `savevm loaded` and quit.
#
# Wire into a YAML's `load:` section:
#   experiment_context:
#     interaction_script: /home/dev/qflex/conf/DS/expects/load_savevm_loaded_single.exp
#     loadvm_name:        booted
#
# Each container's command is its docker entrypoint (server: docker-entrypoint.py;
# client: ds_client_entry.sh = warmup + load). YCSB workload swapped a->c in place.

set timeout 900

set BUDGET_INITIAL_S        10
set BUDGET_DEFAULT_S         5
set BUDGET_PROMPT_S         120
set BUDGET_WORKLOAD_INIT_S 259200   ; # 72h client budget (YCSB warmup of 10M records under emulation can take many hours wall-clock)
set BUDGET_CHECKPOINTING_S 1800

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)
set exp_folder   $env(EXP_FOLDER)

catch {file mkdir $exp_folder}
log_file -noappend "$exp_folder/expect_log.txt"

proc connect_telnet {host port {budget_seconds 5}} {
    global timeout
    set saved_timeout $timeout
    set timeout 5
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        spawn telnet $host $port
        set this_sid $spawn_id
        set ok 0
        expect {
            -re "Escape character is" { set ok 1 }
            -re "Connection refused" { }
            timeout { }
            eof { }
        }
        if {$ok} {
            set timeout $saved_timeout
            return $this_sid
        }
        catch {close -i $this_sid}
        catch {wait -i $this_sid}
        sleep 2
    }
    set timeout $saved_timeout
    error "connect_telnet: gave up after ${budget_seconds}s polling $host:$port"
}

proc quit_qemu {monitor_port} {
    global BUDGET_DEFAULT_S
    if {[catch {connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S} sid]} {
        return
    }
    set timeout $BUDGET_DEFAULT_S
    expect {
        -i $sid
        timeout { puts "quit_qemu: monitor didn't prompt" }
        "(qemu) " {
            send -i $sid "quit\r"
            catch {expect -i $sid eof}
        }
    }
}

# Run a shell cmd and block until its unique end-marker prints (NOT a prompt match — no [6n race, no
# leftover-prompt race). Fails fast at $budget instead of sitting on a missed prompt for hours.
proc run_and_wait {cmd budget} {
    global spawn_id timeout
    set timeout $budget
    send "$cmd; printf '\\nQFLEXEOC%s\\n' \"\$\$\"\r"
    expect { timeout { puts "WARN: '$cmd' did not return within ${budget}s" } -re {QFLEXEOC[0-9]+} }
}

# --- 1. Connect serial + nudge for shell prompt (post-loadvm) ---------------

set serial_sid [connect_telnet 127.0.0.1 $serial_port $BUDGET_INITIAL_S]
set spawn_id $serial_sid

set timeout $BUDGET_PROMPT_S
send "\r"
expect {
    timeout { puts "ERROR: shell prompt timed out after loadvm"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 5

# --- 2. Clear any leftover containers from a prior run ----------------------
# Best-effort: if there are none, docker errors out cleanly and we move on.
# The server runs with `--name cassandra`, so a stale container would break
# `docker run --name` on this run.

send "docker stop \$(docker ps -a -q) 2>/dev/null\r"
expect {
    timeout { puts "ERROR: docker stop didn't return prompt"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
send "docker rm \$(docker ps -a -q) 2>/dev/null\r"
expect {
    timeout { puts "ERROR: docker rm didn't return prompt"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

# --- 3. Server: cassandra via docker-entrypoint.py as the container entrypoint --
# run_server.sh rewritten non-interactively (no tmux); docker-entrypoint.py
# execvp's `cassandra -R -f` (foreground), so the backgrounded run keeps the
# server alive into savevm. cpuset=0 keeps server work on core 0.

# rm first: a prior run can leave run_server.sh root-owned; qflex can't truncate/chmod it but
# owns /home/qflex so can rm it (same guard as the multi-node master).
run_and_wait "rm -f ./run_server.sh" $BUDGET_PROMPT_S
send "cat > ./run_server.sh <<'WRITE_SERVER_EOF'\r"
send "#!/bin/sh\r"
send "docker run --cpuset-cpus=0 --net host --name cassandra \\\r"
send "    --entrypoint=/docker-entrypoint.py \\\r"
send "    abdu1998a/dataserving:server\r"
send "WRITE_SERVER_EOF\r"
run_and_wait "true" $BUDGET_PROMPT_S
run_and_wait "chmod +x ./run_server.sh" $BUDGET_PROMPT_S

send "./run_server.sh > /tmp/ds_server.out 2>&1 < /dev/null &\r"
run_and_wait "true" $BUDGET_PROMPT_S
puts "ds: server launched; tailing /tmp/ds_server.out for 'Startup complete'..."
send "tail -f /tmp/ds_server.out\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: Cassandra didn't print 'Startup complete'"; quit_qemu $monitor_port; exit 1 }
    -re {Startup complete}
}
send "\003"
run_and_wait "true" $BUDGET_PROMPT_S
puts "ds: Cassandra startup complete. Settling 5s..."
sleep 5

# --- 4. Client: warmup THEN load in ONE container (entry runs warmup.sh then load.sh). Each
# phase writes a SEPARATELY-NAMED file (ds_warmup.out vs ds_load.out) under a mounted `dsout` dir,
# so a tail for the load marker can never match a warmup line. Warmup (ycsb load/INSERT) ends with
# the `Warm up is done.` banner; the run phase (workloadc/READ) emits `current ops/sec`.
# cpuset=1 keeps client on core 1.

run_and_wait "rm -f ./ds_client_entry.sh ./run_client.sh" $BUDGET_PROMPT_S
send "cat > ./ds_client_entry.sh <<'WRITE_CLIENT_ENTRY_EOF'\r"
send "#!/bin/sh\r"
send "./warmup.sh 127.0.0.1 10000000 16 > /out/ds_warmup.out 2>&1\r"
send "sed -i 's#workloads/workloada#workloads/workloadc#' load.sh\r"
send "./load.sh 127.0.0.1 10000000 5000 16 > /out/ds_load.out 2>&1\r"
send "WRITE_CLIENT_ENTRY_EOF\r"
run_and_wait "true" $BUDGET_PROMPT_S
run_and_wait "chmod +x ./ds_client_entry.sh" $BUDGET_PROMPT_S
send "cat > ./run_client.sh <<'WRITE_CLIENT_EOF'\r"
send "#!/bin/sh\r"
send "docker run --cpuset-cpus=1 --net host \\\r"
send "    -v \$(pwd)/dsout:/out \\\r"
send "    -v \$(pwd)/ds_client_entry.sh:/ds_client_entry.sh \\\r"
send "    --entrypoint=/ds_client_entry.sh \\\r"
send "    abdu1998a/dataserving:client\r"
send "WRITE_CLIENT_EOF\r"
run_and_wait "true" $BUDGET_PROMPT_S
run_and_wait "chmod +x ./run_client.sh" $BUDGET_PROMPT_S

# Fresh output files (rm clears any stale 'Warm up is done.'; touch makes them exist so
# `tail -f` doesn't race file creation).
run_and_wait "mkdir -p dsout; rm -f dsout/ds_warmup.out dsout/ds_load.out; touch dsout/ds_warmup.out dsout/ds_load.out" $BUDGET_PROMPT_S
send "./run_client.sh > /tmp/ds_runclient.out 2>&1 < /dev/null &\r"
run_and_wait "true" $BUDGET_PROMPT_S

# --- 5a. Warmup (ycsb load) -> dsout/ds_warmup.out; wait for the `Warm up is done.` banner ---
puts "ds: client launched; tailing dsout/ds_warmup.out for 'Warm up is done.'..."
send "tail -f dsout/ds_warmup.out\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: warmup didn't print 'Warm up is done.'"; quit_qemu $monitor_port; exit 1 }
    -re {Warm up is done\.}
}
send "\003"
run_and_wait "true" $BUDGET_PROMPT_S
puts "ds: warmup complete."

# --- 5b. Load (ycsb run, workloadc) -> dsout/ds_load.out; wait for the first run-phase throughput ---
puts "ds: tailing dsout/ds_load.out for first run-phase throughput..."
send "tail -f dsout/ds_load.out\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: load run didn't emit a throughput line"; quit_qemu $monitor_port; exit 1 }
    -re {current ops/sec; est completion in}
}
puts "ds: load running (run-phase throughput seen); savevm loaded now..."
send "\003"
run_and_wait "true" $BUDGET_PROMPT_S

catch {close -i $serial_sid}
catch {wait -i $serial_sid}

# --- 6. savevm loaded via the monitor ---------------------------------------

set monitor_sid [connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S]
set spawn_id $monitor_sid

set timeout $BUDGET_DEFAULT_S
expect {
    timeout { puts "ERROR: monitor prompt timed out"; exit 1 }
    "(qemu) "
}

set timeout $BUDGET_CHECKPOINTING_S
send "delvm loaded\r"
expect {
    timeout { puts "WARN: delvm didn't return; continuing anyway" }
    "(qemu) "
}
send "savevm loaded\r"
expect {
    timeout { puts "ERROR: savevm didn't return"; exit 1 }
    "(qemu) "
}

send "quit\r"
catch {expect eof}
exit 0
