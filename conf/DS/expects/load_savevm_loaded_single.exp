#!/usr/bin/env expect
# SINGLE-NODE DS load. Loads from `booted`, brings up an in-guest detached tmux
# session with 2 windows on ONE QEMU guest:
#   window 0: abdu1998a/dataserving:server (Cassandra via docker-entrypoint.py)
#   window 1: abdu1998a/dataserving:client (YCSB warmup + load)
# Both communicate over the guest's 127.0.0.1 (docker --net host). Once the
# YCSB load reports its first throughput line, `savevm loaded` and quit.
#
# Wire into a YAML's `load:` section:
#   experiment_context:
#     interaction_script: /home/dev/qflex/conf/DS/expects/load_savevm_loaded_single.exp
#     loadvm_name:        booted
#
# Server window is driven headlessly via `tmux send-keys` + `tmux capture-pane`
# polling. Client window is `tmux attach`ed so its output streams live to the
# serial spawn (no capture-pane polling). YCSB workload swapped a->c in place.

set timeout 900

set BUDGET_INITIAL_S        10
set BUDGET_DEFAULT_S         5
set BUDGET_PROMPT_S         120
set BUDGET_WORKLOAD_INIT_S 129600   ; # 36h client budget (YCSB warmup of 10M records under emulation can take many hours wall-clock)
set BUDGET_CHECKPOINTING_S 1800

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)
set exp_folder   $env(EXP_FOLDER)

catch {file mkdir $exp_folder}
log_file -noappend "$exp_folder/expect_log.txt"

proc connect_telnet {host port {budget_seconds 5}} {
    global timeout
    set saved_timeout $timeout
    set timeout 5
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        spawn telnet $host $port
        set this_sid $spawn_id
        set ok 0
        expect {
            -re "Escape character is" { set ok 1 }
            -re "Connection refused" { }
            timeout { }
            eof { }
        }
        if {$ok} {
            set timeout $saved_timeout
            return $this_sid
        }
        catch {close -i $this_sid}
        catch {wait -i $this_sid}
        sleep 2
    }
    set timeout $saved_timeout
    error "connect_telnet: gave up after ${budget_seconds}s polling $host:$port"
}

proc quit_qemu {monitor_port} {
    global BUDGET_DEFAULT_S
    if {[catch {connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S} sid]} {
        return
    }
    set timeout $BUDGET_DEFAULT_S
    expect {
        -i $sid
        timeout { puts "quit_qemu: monitor didn't prompt" }
        "(qemu) " {
            send -i $sid "quit\r"
            catch {expect -i $sid eof}
        }
    }
}

# Poll a tmux pane for a literal substring. Drives `tmux capture-pane -p` over
# the alpine shell spawn, accumulates the response, and searches for the
# needle. Wall-clock deadline (outer `set timeout` doesn't bound Tcl loops).
# Fail-fasts if the pane shows a bash syntax error.
proc wait_for_pane_substring {session window needle budget_seconds} {
    global timeout
    set saved_timeout $timeout
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        send "tmux capture-pane -t ${session}:${window} -p\r"
        set buf ""
        set timeout 5
        expect {
            -re {.+} { append buf $expect_out(buffer); exp_continue }
            timeout { }
        }
        if {[string first $needle $buf] >= 0} { set timeout $saved_timeout; return }
        foreach err {"bash: syntax error" "syntax error near unexpected"} {
            if {[string first $err $buf] >= 0} {
                set timeout $saved_timeout
                error "wait_for_pane_substring: bash error in $session:$window: '$err' (waiting for '$needle')"
            }
        }
        sleep 2
    }
    set timeout $saved_timeout
    error "wait_for_pane_substring: '$needle' never in $session:$window within ${budget_seconds}s"
}

# --- 1. Connect serial + nudge for shell prompt (post-loadvm) ---------------

set serial_sid [connect_telnet 127.0.0.1 $serial_port $BUDGET_INITIAL_S]
set spawn_id $serial_sid

set timeout $BUDGET_PROMPT_S
send "\r"
expect {
    timeout { puts "ERROR: shell prompt timed out after loadvm"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 5

# --- 2. Clear any leftover containers from a prior run ----------------------
# Best-effort: if there are none, docker errors out cleanly and we move on.
# The server runs with `--name cassandra`, so a stale container would break
# `docker run --name` on this run.

send "docker stop \$(docker ps -a -q) 2>/dev/null\r"
expect {
    timeout { puts "ERROR: docker stop didn't return prompt"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
send "docker rm \$(docker ps -a -q) 2>/dev/null\r"
expect {
    timeout { puts "ERROR: docker rm didn't return prompt"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

# --- 3. Create detached tmux session with 2 windows -------------------------

send "tmux new-session -d -s ds\r"
expect {
    timeout { puts "ERROR: tmux new-session timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
send "tmux new-window -t ds:1\r"
expect {
    timeout { puts "ERROR: tmux new-window 1 timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

# --- 4. Window 0: server ----------------------------------------------------
# run_server.sh: docker run -it --cpuset-cpus=0 --net host --name cassandra
#   --entrypoint bash abdu1998a/dataserving:server
# Drops into root shell inside the server container.

send "tmux send-keys -t ds:0 './run_server.sh' Enter\r"
expect {
    timeout { puts "ERROR: dispatching run_server.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
puts "ds: window 0 (server) launched; waiting for 'root@qflex:/#'..."
wait_for_pane_substring ds 0 "root@qflex:/#" $BUDGET_WORKLOAD_INIT_S
puts "ds: window 0 at root shell inside server container; dispatching ./docker-entrypoint.py..."

# docker-entrypoint.py rewrites cassandra.yaml/jvm options then execvp's
# `cassandra -R -f` (foreground). Cassandra prints 'Startup complete' once the
# node is up and accepting CQL — other log lines come before and after it.
send "tmux send-keys -t ds:0 './docker-entrypoint.py' Enter\r"
expect {
    timeout { puts "ERROR: dispatching docker-entrypoint.py timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
puts "ds: docker-entrypoint.py dispatched; waiting for 'Startup complete'..."
wait_for_pane_substring ds 0 "Startup complete" $BUDGET_WORKLOAD_INIT_S
puts "ds: Cassandra startup complete. Settling 5s..."
sleep 5

# --- 5. Window 1: client — attach so its output streams live to serial -----
# Selecting ds:1 then `tmux attach -t ds` connects the serial spawn directly
# to the client pane: typing goes to its stdin, its output streams once to
# the expect log (no `capture-pane` polling = no repeated buffer dumps).

send "tmux select-window -t ds:1\r"
expect {
    timeout { puts "ERROR: tmux select-window timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
send "tmux attach -t ds\r"

send "./run_client.sh\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: client container didn't reach root prompt"; quit_qemu $monitor_port; exit 1 }
    -re {root@qflex:/#}
}
puts "ds: window 1 at root shell inside client container; swapping YCSB workloada->workloadc in warmup.sh..."

# Swap the YCSB workload a->c in place (workloada appears exactly once).
send "sed -i 's#workloads/workloada#workloads/workloadc#' warmup.sh\r"
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "ERROR: sed warmup.sh didn't return prompt"; quit_qemu $monitor_port; exit 1 }
    -re {root@qflex:/#}
}

# Warmup: fills Cassandra with 10M records (1KB each ~= 10GB), 16 threads.
# Retries internally until the seed server accepts. Finishes with
# 'Warm up is done.' then the prompt.
send "./warmup.sh 127.0.0.1 10000000 16\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: warmup didn't print 'Warm up is done.'"; quit_qemu $monitor_port; exit 1 }
    -re {Warm up is done\.}
}
puts "ds: warmup done; waiting for the prompt before loading..."
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "ERROR: warmup didn't return prompt"; quit_qemu $monitor_port; exit 1 }
    -re {root@qflex:/#}
}

send "sed -i 's#workloads/workloada#workloads/workloadc#' load.sh\r"
expect {
    timeout { puts "ERROR: sed load.sh didn't return prompt"; quit_qemu $monitor_port; exit 1 }
    -re {root@qflex:/#}
}

# Load: 10M records, 5000 target rps, 16 threads. Starts emitting throughput
# lines ('... current ops/sec; est completion in ...') ~10s in. Snapshot the
# guest with the load actively running — FW resumes from this state.
send "./load.sh 127.0.0.1 10000000 5000 16\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: load didn't emit a throughput line"; quit_qemu $monitor_port; exit 1 }
    -re {current ops/sec; est completion in}
}
puts "ds: load running (first throughput line seen); savevm loaded now..."

# Detach (Ctrl-B d) so closing the serial spawn doesn't kill an attached tmux client.
send "\x02d"
set timeout $BUDGET_PROMPT_S
expect { timeout { } -re {[\$#] +} }

catch {close -i $serial_sid}
catch {wait -i $serial_sid}

# --- 6. savevm loaded via the monitor ---------------------------------------

set monitor_sid [connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S]
set spawn_id $monitor_sid

set timeout $BUDGET_DEFAULT_S
expect {
    timeout { puts "ERROR: monitor prompt timed out"; exit 1 }
    "(qemu) "
}

set timeout $BUDGET_CHECKPOINTING_S
send "delvm loaded\r"
expect {
    timeout { puts "WARN: delvm didn't return; continuing anyway" }
    "(qemu) "
}
send "savevm loaded\r"
expect {
    timeout { puts "ERROR: savevm didn't return"; exit 1 }
    "(qemu) "
}

send "quit\r"
catch {expect eof}
exit 0
