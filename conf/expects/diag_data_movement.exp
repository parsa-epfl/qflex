#!/usr/bin/env expect
# GENERIC data-movement capture (workload/config-agnostic). Wired programmatically by the
# `generate-test-communication` command (commands/generate_test_communication.py) for single-node AND
# every multi-node leaf — one script, no per-experiment expect. The command resumes `loaded` with
# qemu -snapshot (qcow untouched) and QFLEX_MEASURE_DATA_MOVEMENT=1 (arms the PDES wire counters).
#
# What it does, per node: connect serial, capture /proc/net/dev + /proc/interrupts (BEFORE, read-only),
# advance the guest by DATA_MOVE_DURATION_S of GUEST time (a guest-side `sleep`, NOT host wall-clock —
# the already-running workload keeps generating traffic in the background during that window), capture
# AFTER, then quit. Guest time is host-resource-independent, so single-vs-multi deltas are comparable.
# NO savevm, no guest writes that matter. Captures land in $EXP_FOLDER; result_new computes the
# per-interface byte/packet (chunk) deltas if present.
#   single-node  -> `lo` delta = localhost (client<->server loopback) data moved
#   multi-node   -> `lo` + `eth0` deltas (+ the PDES [PDES-WIRE] line at qemu teardown) = cross-node

set timeout 900
set BUDGET_INITIAL_S       10
set BUDGET_DEFAULT_S        5
set BUDGET_PROMPT_S        60
set BUDGET_GUEST_WINDOW_S 1800

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)
set exp_folder   $env(EXP_FOLDER)
if {[info exists env(DATA_MOVE_DURATION_S)]} {
    set duration_s $env(DATA_MOVE_DURATION_S)
} else {
    set duration_s 1
}
catch {file mkdir $exp_folder}
log_file -noappend "$exp_folder/expect_log.txt"

proc connect_telnet {host port {budget_seconds 5}} {
    global timeout
    set saved_timeout $timeout
    set timeout 5
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        spawn telnet $host $port
        set this_sid $spawn_id
        set ok 0
        expect {
            -re "Escape character is" { set ok 1 }
            -re "Connection refused" { }
            timeout { }
            eof { }
        }
        if {$ok} { set timeout $saved_timeout; return $this_sid }
        catch {close -i $this_sid}
        catch {wait -i $this_sid}
        sleep 2
    }
    set timeout $saved_timeout
    error "connect_telnet: gave up after ${budget_seconds}s polling $host:$port"
}

proc quit_qemu {monitor_port} {
    global BUDGET_DEFAULT_S
    if {[catch {connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S} sid]} {
        return
    }
    set timeout $BUDGET_DEFAULT_S
    expect {
        -i $sid
        timeout { puts "quit_qemu: monitor didn't prompt" }
        "(qemu) " {
            send -i $sid "quit\r"
            catch {expect -i $sid eof}
        }
    }
}

# Marker-based capture: run a read-only command, capture its output to $exp_folder/$out_name. The
# PID-bearing marker can't appear in the typed echo, so the regex only matches the real output.
proc capture_to {out_name shell_cmd} {
    global exp_folder spawn_id BUDGET_PROMPT_S
    set timeout $BUDGET_PROMPT_S
    send "$shell_cmd; printf '\\nQFLEXEOC%s\\n' \"\$\$\"\r"
    expect {
        timeout { puts "ERROR: '$shell_cmd' returned no end-of-capture marker"; return 0 }
        -re {\nQFLEXEOC[0-9]+\r?\n}
    }
    set buf $expect_out(buffer)
    expect { timeout { } -re {[\$#] +} }
    set fh [open "$exp_folder/$out_name" w]
    puts $fh $buf
    close $fh
    return 1
}

# --- 1. Connect serial + nudge for shell prompt (post-loadvm) -------------------------------------
# connect_telnet's retry/close can leave the global spawn_id clobbered, so set it explicitly. The
# `loaded` snapshot resumes with the workload backgrounded (server/client are detached docker
# containers logging to /tmp/*.out), so the serial console is at a shell prompt — gate on it directly.
set serial_sid [connect_telnet 127.0.0.1 $serial_port $BUDGET_INITIAL_S]
set spawn_id $serial_sid

set timeout $BUDGET_PROMPT_S
send "\r"
expect {
    timeout { puts "ERROR: shell prompt timed out after loadvm"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

# --- 3. Capture BEFORE (read-only procfs; no su needed — both files are world-readable) -----------
capture_to "netdev_before.txt"     "cat /proc/net/dev"
capture_to "interrupts_before.txt" "cat /proc/interrupts"

# --- 4. Advance GUEST time by the window (guest-side sleep; host-resource-independent) -------------
# The backgrounded workload keeps generating traffic during this guest interval. Under PDES sync one
# guest-second can take many host-minutes, so wait for the post-sleep prompt on the long guest budget.
puts "DIAG: advancing ${duration_s}s of GUEST time (host wall-clock may be much longer under PDES)..."
set timeout $BUDGET_GUEST_WINDOW_S
send "sleep $duration_s\r"
expect {
    timeout { puts "ERROR: guest sleep ${duration_s}s didn't return within ${BUDGET_GUEST_WINDOW_S}s host budget"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

# --- 5. Capture AFTER -----------------------------------------------------------------------------
capture_to "netdev_after.txt"      "cat /proc/net/dev"
capture_to "interrupts_after.txt"  "cat /proc/interrupts"

# --- 6. Quit (NO savevm; qcow already protected by qemu -snapshot) --------------------------------
puts "DIAG: done; wrote netdev/interrupts before+after to $exp_folder; quitting (no savevm)."
quit_qemu $monitor_port
exit 0
