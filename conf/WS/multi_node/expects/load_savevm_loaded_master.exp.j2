#!/usr/bin/env expect
# MULTI-NODE MASTER (node_number == 0) load template. Pairs with
# boot/boot_savevm_booted_master.exp + boot/boot_savevm_booted_wait.exp on the
# boot side. The load phase has already done `loadvm booted`, so the guest is
# back at the logged-in shell prompt — no re-login needed. Runs your INSERT
# YOUR SETUP HERE block, then `savevm loaded` over the monitor for the init
# phase to load from.
#
# Pair with conf/WS/expects/load_savevm_loaded_wait.exp on every non-master
# leaf. PDES `savevm` is a distributed snapshot — the master issues the
# monitor command, every node serialises its own per-node qcow2 as part of
# the drain. If the same script runs on both leaves, the drain is
# double-driven → corrupt snapshot.
#
# The 5 s settles after the post-loadvm prompt nudge, after ls, and after
# savevm are host wall-clock (Tcl `sleep`) — they give per-node guest activity
# room to settle and the follower's per-node `save_snapshot()` time to
# finalise before `quit` tears down PDES. See the `expect-scripts` skill.
#
# For SINGLE-NODE setups, use load_savevm_loaded.exp instead.
#
# === IN-IMAGE WORKLOAD SCRIPT REFERENCE — ./server.sh ========================
# Captured from `cat ./server.sh` in the post-loadvm guest:
#
#   #!/bin/sh
#
#   docker run -it --name web_search_server --rm \
#     -v $(pwd)/index_14GB:/download/index_14GB \
#     --net host \
#     --cpuset-cpus=0-7 \
#     cloudsuite/web-search:server 14g 1
#
# We rewrite this file in-guest before launching (heredoc further down) so
# --cpuset-cpus=0-7 becomes --cpuset-cpus=0-0 — matches our -smp 1 guest. If
# you need to change anything about server.sh in this run, edit the heredoc
# below — don't edit the in-image baked file (the change wouldn't survive a
# fresh loadvm anyway, since the qcow2 owns the canonical copy).
# =============================================================================

set timeout 900

set BUDGET_INITIAL_S        10
set BUDGET_DEFAULT_S        60
set BUDGET_PROMPT_S         180
set BUDGET_INSTALL_S        600     ; # apk download over NAT at idle CPU; fail fast, not the ckpt budget
set BUDGET_PING_S           300
set BUDGET_CHECKPOINTING_S 172800
set BUDGET_WORKLOAD_INIT_S 172800   ; # wait for first server-side NodeDataChanged: ~45 min under PDES sync=true on -smp 1

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)
set exp_folder   $env(EXP_FOLDER)

catch {file mkdir $exp_folder}
log_file -noappend "$exp_folder/expect_log.txt"

# Three load-phase sentinels under the group folder (parent of $exp_folder).
# Master writes load_loaded_server_done.flag (after first savevm) and
# load_done.flag (after second savevm); follower writes load_ramp_up_done.flag.
# Master clears its OWN flags at startup so re-runs don't see stale signals.
#
# TODO: migrate these ad-hoc sentinels into the executor's existing
# _sentinel_path framework (commands/executer.py:_sentinel_basename) so they're
# named, owned, and cleaned up consistently with the boot-phase
# .started/.done/.killed_by_peer sentinels. The `load_` prefix here is a
# stopgap to avoid name collisions with future sentinels.
set group_folder                  [file dirname $exp_folder]
set load_loaded_server_done_flag  "$group_folder/load_loaded_server_done.flag"
set load_ramp_up_done_flag        "$group_folder/load_ramp_up_done.flag"
set load_done_flag                "$group_folder/load_done.flag"
catch {file delete -force $load_loaded_server_done_flag}
catch {file delete -force $load_done_flag}

proc connect_telnet {host port {budget_seconds 5}} {
    global timeout
    set saved_timeout $timeout
    set timeout 5
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        spawn telnet $host $port
        set this_sid $spawn_id
        set ok 0
        expect {
            -re "Escape character is" { set ok 1 }
            -re "Connection refused" { }
            timeout { }
            eof { }
        }
        if {$ok} {
            set timeout $saved_timeout
            return $this_sid
        }
        catch {close -i $this_sid}
        catch {wait -i $this_sid}
        sleep 2
    }
    set timeout $saved_timeout
    error "connect_telnet: gave up after ${budget_seconds}s polling $host:$port"
}

proc quit_qemu {monitor_port} {
    global BUDGET_DEFAULT_S
    if {[catch {connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S} sid]} {
        return
    }
    set timeout $BUDGET_DEFAULT_S
    expect {
        -i $sid
        timeout { puts "quit_qemu: monitor didn't prompt" }
        "(qemu) " {
            send -i $sid "quit\r"
            catch {expect -i $sid eof}
        }
    }
}

# Poll a file for a literal substring with a wall-clock budget. min_count
# lets a single Load.log host multiple savevm rounds — pass 2 on the second
# call so we don't match the first savevm's still-present log 7. Used to
# wait for per-node savevm to complete via qemu's `savevm log 7` printf
# (last thing save_snapshot() emits before returning).
proc wait_for_substring {path needle budget_seconds {min_count 1}} {
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        if {[file exists $path]} {
            set fh [open $path r]
            set content [read $fh]
            close $fh
            set count 0
            set start 0
            while {[set idx [string first $needle $content $start]] >= 0} {
                incr count
                set start [expr {$idx + 1}]
            }
            if {$count >= $min_count} { return }
        }
        sleep 2
    }
    error "wait_for_substring: $needle did not reach count ${min_count} in $path within ${budget_seconds}s"
}

# Poll for a file's existence with a wall-clock budget. Used to wait for the
# peer to write a sentinel.
proc wait_for_file {path budget_seconds} {
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        if {[file exists $path]} { return }
        sleep 2
    }
    error "wait_for_file: $path never appeared within ${budget_seconds}s"
}

# Run a shell cmd and block until its unique end-marker prints (NOT a prompt match — no [6n race, no
# leftover-prompt race). Fails fast at $budget instead of sitting on a missed prompt for hours.
proc run_and_wait {cmd budget} {
    global spawn_id
    set timeout $budget
    send "$cmd; printf '\\nQFLEXEOC%s\\n' \"\$\$\"\r"
    expect { timeout { puts "WARN: '$cmd' did not return within ${budget}s" } -re {QFLEXEOC[0-9]+} }
}

# --- 1. Connect serial + nudge for shell prompt ------------------------------
# loadvm restored the guest to the logged-in qflex shell. A bare \r re-renders
# the prompt. No fresh-boot wait needed (no kernel boot under PDES).

set serial_sid [connect_telnet 127.0.0.1 $serial_port $BUDGET_INITIAL_S]
set spawn_id $serial_sid

set timeout $BUDGET_PROMPT_S
send "\r"
expect {
    timeout { puts "ERROR: shell prompt timed out after loadvm"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

# TODO: replace this fixed 10 s wait with a sentinel-based handshake so the
# two nodes coordinate on a "loaded" signal instead of guessing wall-clock.
# Mirror the boot phase's `savevm log 7` pattern: each leaf touches a per-node
# "loaded" sentinel, peers wait_for_file each other's, then proceed.
puts "master: post-loadvm settle — waiting 10 s host time before guest config..."
sleep 10

# =============================================================================
# INSERT YOUR SETUP HERE
# =============================================================================
#
# Anything you do here gets baked into the `loaded` snapshot — typically the
# longer-running, workload-side warm-up that the init phase will hand to FW.
# Each guest command is one `send` followed by an `expect` that waits for the
# next shell prompt. The regex {[\$#] +} matches both `$ ` (qflex) and `# `
# (root). Do NOT anchor with `$` at end-of-buffer — Alpine's busybox emits an
# ESC[6n cursor report after the prompt, so the buffer doesn't end at it.
#
# For privileged ops use `doas` (sudo isn't installed); answer the password
# prompt with `qflex`. For long-running setup, bump the surrounding `set
# timeout` before the send.
#
# =============================================================================

send "ls\r"
expect {
    timeout { puts "ERROR: ls didn't return"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 5

# TEMP: configure 192.168.100.1/24 on the PDES NIC (eth0). su to root because
# `ip` requires privileges; alpine's su asks for username and password (both
# empty here), so two trailing \r's cover both prompts. Drop back to qflex
# with `su qflex` after. eth0 here = the virtio-net-pci PDES NIC at PCI addr
# 0x10 (the one with mac=52:54:00:aa:bb:00 — see the QEMU command line).
send "su\r"
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "ERROR: never reached root prompt after su"; quit_qemu $monitor_port; exit 1 }
    -re {[Aa]uthentication failure|incorrect password} {
        puts "ERROR: su rejected empty creds — image may not allow empty pw"
        quit_qemu $monitor_port; exit 1
    }
    -re {[Ll]ogin: }    { send "\r"; exp_continue }
    -re {[Pp]assword: } { send "\r"; exp_continue }
    -re {# +}
}
send "ip link show\r"
expect {
    timeout { puts "ERROR: ip link show timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "ip link set eth0 down\r"
expect {
    timeout { puts "ERROR: ip link set eth0 down timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "ip link set eth0 address 52:54:00:aa:bb:00\r"
expect {
    timeout { puts "ERROR: ip link set address timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "ip link set eth0 up\r"
expect {
    timeout { puts "ERROR: ip link set eth0 up timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "ip addr add 192.168.100.1/24 dev eth0\r"
expect {
    timeout { puts "ERROR: ip addr add timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "ip addr show eth0\r"
expect {
    timeout { puts "ERROR: ip addr show timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
# Bake `ss` (iproute2) into `loaded` for per-side socket measurement — done at load start (idle CPU,
# before the workload launches). We are root; the NAT NIC here is eth1 (eth0 is the PDES wire). DNS via
# QEMU user-mode NAT. Marker-gated so each step ends the instant its command returns (no [6n /
# leftover-prompt race) and apk fails fast at BUDGET_INSTALL_S, not the 48h checkpointing budget.
run_and_wait "ip link set eth1 up" $BUDGET_PROMPT_S
run_and_wait "udhcpc -i eth1 -t 5 -n -q" $BUDGET_PROMPT_S
run_and_wait "echo 'nameserver 10.0.2.3' > /etc/resolv.conf; echo 'nameserver 8.8.8.8' >> /etc/resolv.conf" $BUDGET_PROMPT_S
run_and_wait "apk add --no-cache iproute2" $BUDGET_INSTALL_S
send "su qflex\r"
expect {
    timeout { puts "ERROR: didn't get qflex prompt after su qflex"; quit_qemu $monitor_port; exit 1 }
    -re {\$ +}
}

sleep 5

# TEMP: ping the peer to verify the PDES wire is up under sync=true.
# Match on the iputils/busybox summary line, NOT on the next prompt — proves
# ping actually ran. 30 s host wall-clock budget; under PDES that's plenty for
# 10 packets at -i 0.001 to land + summary to print.
send "ping 192.168.100.2 -i 0.001 -c 10\r"
set timeout $BUDGET_PING_S
expect {
    timeout { puts "ERROR: ping summary didn't arrive within ${BUDGET_PING_S}s"; quit_qemu $monitor_port; exit 1 }
    -re {(\d+) packets transmitted, (\d+)[ ,]} {
        puts "master: ping summary -> $expect_out(1,string) transmitted, $expect_out(2,string) received"
    }
}
# drain post-summary prompt so the next send isn't racing leftover bytes
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "WARN: prompt didn't return after ping summary; continuing" }
    -re {[\$#] +}
}

sleep 5

# TEMP: rewrite the in-image ./server.sh in-place so --cpuset-cpus matches our
# -smp 1 guest. Image's baked server.sh asks for cpus 0-7; docker rejects it
# because only CPU 0 is available. Single-quoted heredoc delimiter so $(pwd)
# is preserved literal — gets expanded at runtime, not at write-time.
send "cat > ./server.sh <<'WRITE_SERVER_EOF'\r"
send "#!/bin/sh\r"
send "\r"
send "docker run --name web_search_server --rm \\\r"
send "  -v \$(pwd)/index_14GB:/download/index_14GB \\\r"
send "  --net host \\\r"
send "  --cpuset-cpus={{ server_cores }} \\\r"
send "  cloudsuite/web-search:server 14g 1\r"
send "WRITE_SERVER_EOF\r"
expect {
    timeout { puts "ERROR: writing ./server.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
send "chmod +x ./server.sh\r"
expect {
    timeout { puts "ERROR: chmod ./server.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 5
send "cat ./server.sh\r"
sleep 5


# Background server.sh (output → /tmp/server.out), tail it for the init marker, then Ctrl-C the tail so
# the shell returns while the server keeps running — so `loaded` lands at a shell prompt and we can run
# monitoring (ss/netdev) later without killing the server. Mirrors the single-node load; the output is
# still visible (via tail until the marker) and preserved in /tmp/server.out.
# TODO: apply this same bg+tail+Ctrl-C pattern to the multi-node load scripts of the OTHER workloads
# (WSV / MS / DS) so their `loaded` console also lands at a shell (don't touch their expects yet).
# `touch` the file on the same line as the launch so `tail -f` can't race the backgrounded child's
# redirect (the multi-node tail-before-file failure). No `docker info` probe — docker is already up,
# and probing it here was observed to wedge the single-vCPU guest console.
send "touch /tmp/server.out; ./server.sh > /tmp/server.out 2>&1 < /dev/null &\r"
expect {
    timeout { puts "ERROR: launching ./server.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
# Wait for the first NodeDataChanged from solr init (~45 min under PDES sync=true on -smp 1);
# BUDGET_WORKLOAD_INIT_S lets a slow-but-progressing run continue rather than aborting.
puts "master: server.sh launched (bg → /tmp/server.out); tailing for first 'NodeDataChanged' (~45 min budget)..."
send "tail -f /tmp/server.out\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: never saw 'NodeDataChanged' in /tmp/server.out within ${BUDGET_WORKLOAD_INIT_S}s"; quit_qemu $monitor_port; exit 1 }
    -re {NodeDataChanged}
}
# Ctrl-C kills tail → shell returns; server keeps running in the background.
send "\003"
set timeout $BUDGET_PROMPT_S
expect { timeout { puts "WARN: prompt didn't return after Ctrl-C; continuing" } -re {[\$#] +} }
puts "master: saw first 'NodeDataChanged'; settling 10 s host time before savevm..."
sleep 10

# Open a SEPARATE spawn on the monitor port to issue savevm. server.sh stays
# running on the serial spawn — different chardev, no interference.
set monitor_sid [connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S]
set spawn_id $monitor_sid
set timeout $BUDGET_DEFAULT_S
expect {
    timeout { puts "ERROR: monitor prompt timed out before savevm"; exit 1 }
    "(qemu) "
}

# delvm best-effort idempotency — savevm refuses to overwrite.
set timeout $BUDGET_CHECKPOINTING_S
send "delvm loaded-server\r"
expect {
    timeout { puts "WARN: delvm didn't return; continuing anyway" }
    "(qemu) "
}
send "savevm loaded-server\r"
expect {
    timeout { puts "ERROR: savevm didn't return"; exit 1 }
    "(qemu) "
}

# (qemu) prompt comes back AFTER save_snapshot returns, but its log 7 printf
# goes through a different stream (qemu's stdout → Load.log via bash
# redirect, vs the monitor chardev). Wait explicitly for log 7 to land in
# Load.log so we're certain the per-node save finalised before we touch the
# sentinel.
puts "master: savevm command returned; polling Load.log for 'savevm log 7'..."
wait_for_substring "$exp_folder/Load.log" "savevm log 7" $BUDGET_CHECKPOINTING_S
puts "master: saw 'savevm log 7' — distributed savevm-loaded-server finalised."

# Write the first load-phase sentinel: "master finished savevm loaded-server".
# Follower's wait_for_file will pick this up and launch ./client.sh.
if {[catch {set f [open $load_loaded_server_done_flag "w"]; close $f} err]} {
    puts "WARN: could not write $load_loaded_server_done_flag: $err"
} else {
    puts "master: wrote sentinel: $load_loaded_server_done_flag"
}

# --- 3. Wait for follower's ramp-up sentinel ---------------------------------
# Follower writes load_ramp_up_done.flag after seeing "Ramp up completed" in
# client.sh's output. Once it's there, the workload is in steady state and we
# can capture a `loaded` snapshot of the running benchmark.
puts "master: waiting for follower to write $load_ramp_up_done_flag (client ramp-up)..."
wait_for_file $load_ramp_up_done_flag $BUDGET_WORKLOAD_INIT_S
puts "master: saw follower's ramp-up sentinel; running second savevm 'loaded'..."

# --- 4. Second savevm: "loaded" ---------------------------------------------
# spawn_id is still $monitor_sid from the first savevm — reuse it.
set timeout $BUDGET_CHECKPOINTING_S
send "delvm loaded\r"
expect {
    timeout { puts "WARN: delvm loaded didn't return; continuing anyway" }
    "(qemu) "
}
send "savevm loaded\r"
expect {
    timeout { puts "ERROR: savevm loaded didn't return"; exit 1 }
    "(qemu) "
}

# Confirm the SECOND log 7 — Load.log already contains the first one from
# `savevm loaded-server`, so we wait for count >= 2.
puts "master: savevm loaded returned; polling Load.log for second 'savevm log 7'..."
wait_for_substring "$exp_folder/Load.log" "savevm log 7" $BUDGET_CHECKPOINTING_S 2
puts "master: saw second 'savevm log 7' — savevm-loaded finalised."

# 10 s host settle, then write the final sentinel.
sleep 10
if {[catch {set f [open $load_done_flag "w"]; close $f} err]} {
    puts "WARN: could not write $load_done_flag: $err"
} else {
    puts "master: wrote final sentinel: $load_done_flag"
}

# --- 5. Quit master qemu cleanly --------------------------------------------
# spawn_id is still the monitor — send `quit` directly. Master's `quit` will
# cascade END_OF_EMULATION to the follower's qemu via PDES; follower's script
# wakes from its wait_for_file load_done.flag and quits its own qemu next.
puts "master: closing master qemu via monitor 'quit'."
send "quit\r"
catch {expect eof}
exit 0
