#!/usr/bin/env expect
# SINGLE-NODE WS load. Loads from `booted`, rewrites server.sh + client.sh
# with single-vCPU cpusets, runs them in sequence (server backgrounded with
# stdout to /tmp/server.out, then client backgrounded to /tmp/client.out),
# tail -f the respective files until NodeDataChanged (server) and
# Ramp up completed (client) appear, then `savevm loaded` + quit.
#
# Wire into a YAML's `load:` section as:
#   experiment_context:
#     interaction_script: /home/dev/qflex/conf/WS/expects/load_savevm_loaded_single.exp
#     loadvm_name:        booted
#
# Single-node guest has 2 vCPUs (core_count=1 × doubled_vcpu=true). Server is
# pinned to vCPU 0, client to vCPU 1, and client targets 127.0.0.1 since both
# share the same guest's network stack.
#
# === IN-IMAGE WORKLOAD SCRIPT REFERENCE — ./server.sh ========================
# Captured from `cat ./server.sh` in the post-loadvm guest:
#
#   #!/bin/sh
#
#   docker run -it --name web_search_server --rm \
#     -v $(pwd)/index_14GB:/download/index_14GB \
#     --net host \
#     --cpuset-cpus=0-7 \
#     cloudsuite/web-search:server 14g 1
#
# We rewrite this file in-guest below before launching, replacing
# --cpuset-cpus=0-7 with --cpuset-cpus=0-0 (match -smp 2's vCPU 0).
# =============================================================================
#
# === IN-IMAGE WORKLOAD SCRIPT REFERENCE — ./client.sh ========================
# Captured from `cat ./client.sh` in the post-loadvm guest:
#
#   #!/bin/sh
#
#   ./disable_logging.sh
#
#   docker run -it --rm --name web_search_client \
#     --cpuset-cpus=8-15 \
#     --net host cloudsuite/web-search:client \
#     127.0.0.1 8 \
#     --ramp-up=30 \
#     --ramp-down=180 \
#     --steady=720000 \
#     --interval-type=ThinkTime \
#     --interval-min=0 \
#     --interval-max=0 -q
#
# We rewrite this file in-guest below before launching, replacing
# --cpuset-cpus=8-15 → --cpuset-cpus=1-1 (match -smp 2's vCPU 1) and
# 127.0.0.1 8 → 127.0.0.1 1 (single-thread client). Server target stays
# 127.0.0.1 since both share this guest's network stack.
# =============================================================================

set timeout 900

set BUDGET_INITIAL_S        10
set BUDGET_DEFAULT_S         5
set BUDGET_PROMPT_S         60
set BUDGET_WORKLOAD_INIT_S 86400   ; # 120 min for solr init + client ramp-up
set BUDGET_CHECKPOINTING_S 86400

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)
set exp_folder   $env(EXP_FOLDER)

catch {file mkdir $exp_folder}
log_file -noappend "$exp_folder/expect_log.txt"

proc connect_telnet {host port {budget_seconds 5}} {
    global timeout
    set saved_timeout $timeout
    set timeout 5
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        spawn telnet $host $port
        set this_sid $spawn_id
        set ok 0
        expect {
            -re "Escape character is" { set ok 1 }
            -re "Connection refused" { }
            timeout { }
            eof { }
        }
        if {$ok} {
            set timeout $saved_timeout
            return $this_sid
        }
        catch {close -i $this_sid}
        catch {wait -i $this_sid}
        sleep 2
    }
    set timeout $saved_timeout
    error "connect_telnet: gave up after ${budget_seconds}s polling $host:$port"
}

proc quit_qemu {monitor_port} {
    global BUDGET_DEFAULT_S
    if {[catch {connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S} sid]} {
        return
    }
    set timeout $BUDGET_DEFAULT_S
    expect {
        -i $sid
        timeout { puts "quit_qemu: monitor didn't prompt" }
        "(qemu) " {
            send -i $sid "quit\r"
            catch {expect -i $sid eof}
        }
    }
}

# --- 1. Connect serial + nudge for shell prompt (post-loadvm) ---------------

set serial_sid [connect_telnet 127.0.0.1 $serial_port $BUDGET_INITIAL_S]
set spawn_id $serial_sid

set timeout $BUDGET_PROMPT_S
send "\r"
expect {
    timeout { puts "ERROR: shell prompt timed out after loadvm"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 5

# --- 2. Rewrite ./server.sh with --cpuset-cpus=0-0 --------------------------

send "cat > ./server.sh <<'WRITE_SERVER_EOF'\r"
send "#!/bin/sh\r"
send "\r"
send "docker run --name web_search_server --rm \\\r"
send "  -v \$(pwd)/index_14GB:/download/index_14GB \\\r"
send "  --net host \\\r"
send "  --cpuset-cpus={{ server_cores }} \\\r"
send "  cloudsuite/web-search:server 14g 1\r"
send "WRITE_SERVER_EOF\r"
expect {
    timeout { puts "ERROR: writing ./server.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
send "chmod +x ./server.sh\r"
expect {
    timeout { puts "ERROR: chmod ./server.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

# --- 3. Rewrite ./client.sh with --cpuset-cpus=1-1 + 127.0.0.1 1 -----------

send "cat > ./client.sh <<'WRITE_CLIENT_EOF'\r"
send "#!/bin/sh\r"
send "\r"
send "./disable_logging.sh\r"
send "\r"
send "docker run --rm --name web_search_client \\\r"
send "  --cpuset-cpus={{ client_cores }} \\\r"
send "  --net host cloudsuite/web-search:client \\\r"
send "  127.0.0.1 1 \\\r"
send "  --ramp-up=30 \\\r"
send "  --ramp-down=180 \\\r"
send "  --steady=720000 \\\r"
send "  --interval-type=ThinkTime \\\r"
send "  --interval-min=0 \\\r"
send "  --interval-max=0 -q\r"
send "WRITE_CLIENT_EOF\r"
expect {
    timeout { puts "ERROR: writing ./client.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
send "chmod +x ./client.sh\r"
expect {
    timeout { puts "ERROR: chmod ./client.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 5

# --- 4. Background server.sh, tail /tmp/server.out for NodeDataChanged ------

send "./server.sh > /tmp/server.out 2>&1 < /dev/null &\r"
expect {
    timeout { puts "ERROR: launching ./server.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

puts "single-node: server.sh launched (bg → /tmp/server.out); tailing for 'NodeDataChanged' (~45 min budget)..."
send "tail -f /tmp/server.out\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: never saw 'NodeDataChanged' in /tmp/server.out within ${BUDGET_WORKLOAD_INIT_S}s"; quit_qemu $monitor_port; exit 1 }
    -re {NodeDataChanged}
}
puts "single-node: saw 'NodeDataChanged'; stopping tail and launching client..."

# Ctrl-C kills tail → returns to shell prompt.
send "\003"
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "WARN: prompt didn't return after Ctrl-C; continuing" }
    -re {[\$#] +}
}

sleep 5

# --- 5. Background client.sh, tail /tmp/client.out for Ramp up completed ---

send "./client.sh > /tmp/client.out 2>&1 < /dev/null &\r"
expect {
    timeout { puts "ERROR: launching ./client.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

puts "single-node: client.sh launched (bg → /tmp/client.out); tailing for 'Ramp up completed' (~45 min budget)..."
send "tail -f /tmp/client.out\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: never saw 'Ramp up completed' in /tmp/client.out within ${BUDGET_WORKLOAD_INIT_S}s"; quit_qemu $monitor_port; exit 1 }
    -re {Ramp up completed}
}
puts "single-node: saw 'Ramp up completed'; stopping tail and proceeding to savevm..."

send "\003"
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "WARN: prompt didn't return after Ctrl-C; continuing" }
    -re {[\$#] +}
}

sleep 5

catch {close -i $serial_sid}
catch {wait -i $serial_sid}

# --- 6. savevm loaded via the monitor ---------------------------------------

set monitor_sid [connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S]
set spawn_id $monitor_sid

set timeout $BUDGET_DEFAULT_S
expect {
    timeout { puts "ERROR: monitor prompt timed out"; exit 1 }
    "(qemu) "
}

set timeout $BUDGET_CHECKPOINTING_S
send "delvm loaded\r"
expect {
    timeout { puts "WARN: delvm didn't return; continuing anyway" }
    "(qemu) "
}
send "savevm loaded\r"
expect {
    timeout { puts "ERROR: savevm didn't return"; exit 1 }
    "(qemu) "
}

send "quit\r"
catch {expect eof}
exit 0
