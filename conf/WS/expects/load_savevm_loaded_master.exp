#!/usr/bin/env expect
# MULTI-NODE MASTER (node_number == 0) load template. Pairs with
# boot/boot_savevm_booted_master.exp + boot/boot_savevm_booted_wait.exp on the
# boot side. The load phase has already done `loadvm booted`, so the guest is
# back at the logged-in shell prompt — no re-login needed. Runs your INSERT
# YOUR SETUP HERE block, then `savevm loaded` over the monitor for the init
# phase to load from.
#
# Pair with conf/WS/expects/load_savevm_loaded_wait.exp on every non-master
# leaf. PDES `savevm` is a distributed snapshot — the master issues the
# monitor command, every node serialises its own per-node qcow2 as part of
# the drain. If the same script runs on both leaves, the drain is
# double-driven → corrupt snapshot.
#
# The 5 s settles after the post-loadvm prompt nudge, after ls, and after
# savevm are host wall-clock (Tcl `sleep`) — they give per-node guest activity
# room to settle and the follower's per-node `save_snapshot()` time to
# finalise before `quit` tears down PDES. See the `expect-scripts` skill.
#
# For SINGLE-NODE setups, use load_savevm_loaded.exp instead.

set timeout 900

set BUDGET_INITIAL_S        10
set BUDGET_DEFAULT_S         5
set BUDGET_PROMPT_S         60
set BUDGET_CHECKPOINTING_S 1800

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)
set exp_folder   $env(EXP_FOLDER)

catch {file mkdir $exp_folder}
log_file -noappend "$exp_folder/expect_log.txt"

proc connect_telnet {host port {budget_seconds 5}} {
    global timeout
    set saved_timeout $timeout
    set timeout 5
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        spawn telnet $host $port
        set this_sid $spawn_id
        set ok 0
        expect {
            -re "Escape character is" { set ok 1 }
            -re "Connection refused" { }
            timeout { }
            eof { }
        }
        if {$ok} {
            set timeout $saved_timeout
            return $this_sid
        }
        catch {close -i $this_sid}
        catch {wait -i $this_sid}
        sleep 2
    }
    set timeout $saved_timeout
    error "connect_telnet: gave up after ${budget_seconds}s polling $host:$port"
}

proc quit_qemu {monitor_port} {
    global BUDGET_DEFAULT_S
    if {[catch {connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S} sid]} {
        return
    }
    set timeout $BUDGET_DEFAULT_S
    expect {
        -i $sid
        timeout { puts "quit_qemu: monitor didn't prompt" }
        "(qemu) " {
            send -i $sid "quit\r"
            catch {expect -i $sid eof}
        }
    }
}

# --- 1. Connect serial + nudge for shell prompt ------------------------------
# loadvm restored the guest to the logged-in qflex shell. A bare \r re-renders
# the prompt. No fresh-boot wait needed (no kernel boot under PDES).

set serial_sid [connect_telnet 127.0.0.1 $serial_port $BUDGET_INITIAL_S]
set spawn_id $serial_sid

set timeout $BUDGET_PROMPT_S
send "\r"
expect {
    timeout { puts "ERROR: shell prompt timed out after loadvm"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

# TODO: replace this fixed 10 s wait with a sentinel-based handshake so the
# two nodes coordinate on a "loaded" signal instead of guessing wall-clock.
# Mirror the boot phase's `savevm log 7` pattern: each leaf touches a per-node
# "loaded" sentinel, peers wait_for_file each other's, then proceed.
puts "master: post-loadvm settle — waiting 10 s host time before guest config..."
sleep 10

# =============================================================================
# INSERT YOUR SETUP HERE
# =============================================================================
#
# Anything you do here gets baked into the `loaded` snapshot — typically the
# longer-running, workload-side warm-up that the init phase will hand to FW.
# Each guest command is one `send` followed by an `expect` that waits for the
# next shell prompt. The regex {[\$#] +} matches both `$ ` (qflex) and `# `
# (root). Do NOT anchor with `$` at end-of-buffer — Alpine's busybox emits an
# ESC[6n cursor report after the prompt, so the buffer doesn't end at it.
#
# For privileged ops use `doas` (sudo isn't installed); answer the password
# prompt with `qflex`. For long-running setup, bump the surrounding `set
# timeout` before the send.
#
# =============================================================================

send "ls\r"
expect {
    timeout { puts "ERROR: ls didn't return"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 5

# TEMP: configure 192.168.100.1/24 on the PDES NIC (eth0). su to root because
# `ip` requires privileges; alpine's su asks for username and password (both
# empty here), so two trailing \r's cover both prompts. Drop back to qflex
# with `su qflex` after. eth0 here = the virtio-net-pci PDES NIC at PCI addr
# 0x10 (the one with mac=52:54:00:aa:bb:00 — see the QEMU command line).
send "su\r"
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "ERROR: never reached root prompt after su"; quit_qemu $monitor_port; exit 1 }
    -re {[Aa]uthentication failure|incorrect password} {
        puts "ERROR: su rejected empty creds — image may not allow empty pw"
        quit_qemu $monitor_port; exit 1
    }
    -re {[Ll]ogin: }    { send "\r"; exp_continue }
    -re {[Pp]assword: } { send "\r"; exp_continue }
    -re {# +}
}
send "ip link show\r"
expect {
    timeout { puts "ERROR: ip link show timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "ip link set eth0 down\r"
expect {
    timeout { puts "ERROR: ip link set eth0 down timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "ip link set eth0 address 52:54:00:aa:bb:00\r"
expect {
    timeout { puts "ERROR: ip link set address timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "ip link set eth0 up\r"
expect {
    timeout { puts "ERROR: ip link set eth0 up timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "ip addr add 192.168.100.1/24 dev eth0\r"
expect {
    timeout { puts "ERROR: ip addr add timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "ip addr show eth0\r"
expect {
    timeout { puts "ERROR: ip addr show timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "su qflex\r"
expect {
    timeout { puts "ERROR: didn't get qflex prompt after su qflex"; quit_qemu $monitor_port; exit 1 }
    -re {\$ +}
}

sleep 5

# TEMP: ping the peer to verify the PDES wire is up under sync=true.
# Match on the iputils/busybox summary line, NOT on the next prompt — proves
# ping actually ran. 30 s host wall-clock budget; under PDES that's plenty for
# 10 packets at -i 0.05 to land + summary to print.
send "ping 192.168.100.2 -i 0.05 -c 10\r"
set timeout 30
expect {
    timeout { puts "ERROR: ping summary didn't arrive within 30s"; quit_qemu $monitor_port; exit 1 }
    -re {(\d+) packets transmitted, (\d+)[ ,]} {
        puts "master: ping summary -> $expect_out(1,string) transmitted, $expect_out(2,string) received"
    }
}
# drain post-summary prompt so the next send isn't racing leftover bytes
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "WARN: prompt didn't return after ping summary; continuing" }
    -re {[\$#] +}
}

sleep 5

# TEMP: kick off the workload server in the background so the script can
# continue. & detaches; the prompt returns immediately.
send "./server.sh &\r"
expect {
    timeout { puts "ERROR: ./server.sh didn't return prompt"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 5

# TEMP: skip checkpointing for now — both leaves stay in a forever loop so the
# user can poke the running guests by hand (and Ctrl+C ./qflex when done).
# Restore the savevm/quit block below when ready to re-enable checkpointing.
puts "master: ping + server up; entering forever loop (no savevm). Ctrl+C ./qflex to stop."
while {1} {
    sleep 60
}

