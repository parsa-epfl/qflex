#!/usr/bin/env expect
# SINGLE-NODE WSV load. Loads from `booted`, runs the cloudsuite/web-serving
# stack as docker containers on ONE guest (database, memcached, web_server
# detached; faban_client backgrounded with its output tailed), waits for the
# faban benchmark's ramp-up, then `savevm loaded` over the monitor and quits.
#
# Wire into a YAML's `load:` section:
#   experiment_context:
#     interaction_script: /home/dev/qflex/conf/WSV/expects/load_savevm_loaded_single.exp
#     loadvm_name:        booted
#
# Single-node guest has 2 vCPUs (core_count=1 × doubled_vcpu=true): db/memcached/
# web_server on cpu 0, faban_client on cpu 1.
#
# === IN-IMAGE WORKLOAD SCRIPT REFERENCE ======================================
# Four baked scripts live in /home/qflex/ inside the alpine guest, all
# communicating via 127.0.0.1. If you need to change any of them for this run,
# edit the heredoc HERE — the qcow2 owns the canonical copy and a fresh loadvm
# wipes guest-side edits.
#
# ./run_database.sh   — REWRITTEN to `docker run -dt` (was -it); MariaDB starts
#   via the image entrypoint and the ALTER USER runs as a post-start docker exec.
#   cpuset=0.
# ./run_memcached.sh  — NOT REWRITTEN. cpuset=0; already `docker run -dt`.
# ./run_server.sh     — NOT REWRITTEN. cpuset=0; already `docker run -dt`. Baked
#   bootstrap arg `127.0.0.1` is fine (faban_client connects via 127.0.0.1 too,
#   same --net=host namespace). Multi-node DOES rewrite this to 192.168.100.1
#   (the master's PDES IP). See load_savevm_loaded_master.exp for that variant.
# ./run_client.sh     — REWRITTEN to mount wsv_faban_entry.sh as the container
#   entrypoint (no interactive bash). cpuset=1. The faban benchmark is launched
#   by the entry script via `./run/entrypoint.sh 127.0.0.1 4 ...` (target = local).
# =============================================================================

set timeout 900

set BUDGET_INITIAL_S        10
set BUDGET_DEFAULT_S         5
set BUDGET_PROMPT_S         60
set BUDGET_WORKLOAD_INIT_S 43200   ; # 12h client budget (ramp-up=120 guest-sec can be many hours wall-clock)
set BUDGET_CHECKPOINTING_S 1800
set BUDGET_SERVER_SETTLE_S    30   ; # host-time settle after 8443 is listening, before launching the faban client

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)
set exp_folder   $env(EXP_FOLDER)

catch {file mkdir $exp_folder}
log_file -noappend "$exp_folder/expect_log.txt"

proc connect_telnet {host port {budget_seconds 5}} {
    global timeout
    set saved_timeout $timeout
    set timeout 5
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        spawn telnet $host $port
        set this_sid $spawn_id
        set ok 0
        expect {
            -re "Escape character is" { set ok 1 }
            -re "Connection refused" { }
            timeout { }
            eof { }
        }
        if {$ok} {
            set timeout $saved_timeout
            return $this_sid
        }
        catch {close -i $this_sid}
        catch {wait -i $this_sid}
        sleep 2
    }
    set timeout $saved_timeout
    error "connect_telnet: gave up after ${budget_seconds}s polling $host:$port"
}

proc quit_qemu {monitor_port} {
    global BUDGET_DEFAULT_S
    if {[catch {connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S} sid]} {
        return
    }
    set timeout $BUDGET_DEFAULT_S
    expect {
        -i $sid
        timeout { puts "quit_qemu: monitor didn't prompt" }
        "(qemu) " {
            send -i $sid "quit\r"
            catch {expect -i $sid eof}
        }
    }
}

# --- 1. Connect serial + nudge for shell prompt (post-loadvm) ---------------

set serial_sid [connect_telnet 127.0.0.1 $serial_port $BUDGET_INITIAL_S]
set spawn_id $serial_sid

set timeout $BUDGET_PROMPT_S
send "\r"
expect {
    timeout { puts "ERROR: shell prompt timed out after loadvm"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 5

# --- 1b. Clear leftover containers so every run starts from scratch ----------
# A stopped/aborted run (or a snapshot baked with a running container) can leave
# named containers behind; the per-service `docker run --name=…` then collides
# and the server never binds 8443. Stop+rm everything first. All run_*.sh use
# --net=host already, so each comes back up on the guest's host netns.
send "docker stop \$(docker ps -a -q) 2>/dev/null\r"; send "\r"
expect { timeout { puts "ERROR: docker stop didn't return prompt"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }
send "docker rm \$(docker ps -a -q) 2>/dev/null\r"; send "\r"
expect { timeout { puts "ERROR: docker rm didn't return prompt"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }
puts "wsv: cleared leftover containers; starting services fresh."

# --- 2. Database: detached container, then ALTER USER via docker exec (retry) -
# run_database.sh rewritten -it -> -dt (no tmux); the ALTER retries until MariaDB
# accepts and echoes a marker. cpuset=0 keeps server-side work on core 0.

send "cat > ./run_database.sh <<'WRITE_DB_EOF'\r"
send "#!/bin/sh\r"
send "docker run -dt --net=host --rm --name=database_server \\\r"
send "  -v \$(pwd)/backup:/backup \\\r"
send "  -v \$(pwd)/db/entrypoint.sh:/etc/entrypoint.sh \\\r"
send "  --cpuset-cpus=0 \\\r"
send "  cloudsuite/web-serving:db_server\r"
send "WRITE_DB_EOF\r"
expect { timeout { puts "ERROR: writing run_database.sh timed out"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }
send "chmod +x ./run_database.sh\r"
expect { timeout { puts "ERROR: chmod run_database.sh timed out"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }
send "./run_database.sh\r"
expect { timeout { puts "ERROR: launching database didn't return prompt"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }

puts "wsv: database launched; running ALTER USER (retry until MariaDB accepts)..."
# Foreground retry loop: docker exec runs the ALTER against the detached
# container (which keeps running after the exec returns). The retry rides out
# MariaDB's startup. Streams live to the serial; ends on the marker.
send "until docker exec database_server mysql -u root -e \"ALTER USER 'root'@'localhost' IDENTIFIED VIA mysql_native_password USING PASSWORD(''); FLUSH PRIVILEGES;\"; do sleep 5; done; echo WSV_DB_ALTERED\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: mysql ALTER USER never succeeded"; quit_qemu $monitor_port; exit 1 }
    -re {WSV_DB_ALTERED}
}
set timeout $BUDGET_PROMPT_S
send "\r"; expect { timeout { } -re {[\$#] +} }
puts "wsv: mysql ALTER USER done."

# --- 3. Memcached: detached container (no tmux) -----------------------------

send "./run_memcached.sh && echo WSV_MEMCACHED_OK\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: memcached didn't confirm start"; quit_qemu $monitor_port; exit 1 }
    -re {WSV_MEMCACHED_OK}
}
set timeout $BUDGET_PROMPT_S
expect { timeout { } -re {[\$#] +} }
puts "wsv: memcached container started."

# --- 4. Web_server: detached container, then wait for Elgg bootstrap --------
# run_server.sh is `docker run -dt` (baked, advertised addr 127.0.0.1 for single).
# The Elgg-bootstrap wait targets the running container, so it stays docker exec.

send "./run_server.sh && echo WSV_SERVER_OK\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: web_server didn't confirm start"; quit_qemu $monitor_port; exit 1 }
    -re {WSV_SERVER_OK}
}
set timeout $BUDGET_PROMPT_S
expect { timeout { } -re {[\$#] +} }
puts "wsv: web_server container started; waiting for Elgg to bootstrap (settings.php written)..."
# PID marker so we match the loop's real output, not the typed command echo.
send "until docker exec web_server grep -q '127.0.0.1:8443' /usr/share/nginx/html/elgg/elgg-config/settings.php 2>/dev/null; do sleep 5; done; printf 'ELGGUP%s\\n' \"\$\$\"\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: Elgg never wrote settings.php (web_server not serving)"; quit_qemu $monitor_port; exit 1 }
    -re {ELGGUP[0-9]+}
}
puts "wsv: Elgg bootstrapped. Settling ${BUDGET_SERVER_SETTLE_S}s before launching faban..."
sleep $BUDGET_SERVER_SETTLE_S

# --- 5. faban client via wsv_faban_entry.sh as the container entrypoint ------
# Rewrite run_client.sh to mount the entry + run it non-interactively (no tmux);
# the benchmark (steady) stays foreground so the backgrounded container is captured
# running. cpuset=1 keeps client work on core 1 (single-node).

send "cat > ./wsv_faban_entry.sh <<'WRITE_FABAN_ENTRY_EOF'\r"
send "#!/bin/sh\r"
send "./run/entrypoint.sh 127.0.0.1 4 --encryption=1 --ramp-up=120 --ramp-down=1800 --steady=86400 --oper=run --min=0 --max=0 --type=THINKTIME\r"
send "WRITE_FABAN_ENTRY_EOF\r"
expect { timeout { puts "ERROR: writing wsv_faban_entry.sh timed out"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }
send "chmod +x ./wsv_faban_entry.sh\r"
expect { timeout { puts "ERROR: chmod wsv_faban_entry.sh timed out"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }

send "cat > ./run_client.sh <<'WRITE_CLIENT_EOF'\r"
send "#!/bin/sh\r"
send "docker run --net=host --rm --name=faban_client \\\r"
send "    -v \$(pwd)/client/gen.test_server.py:/web20_benchmark/run/gen \\\r"
send "    -v \$(pwd)/wsv_faban_entry.sh:/wsv_faban_entry.sh \\\r"
send "    --cpuset-cpus=1 \\\r"
send "    --entrypoint=/wsv_faban_entry.sh \\\r"
send "    cloudsuite/web-serving:faban_client\r"
send "WRITE_CLIENT_EOF\r"
expect { timeout { puts "ERROR: writing run_client.sh timed out"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }
send "chmod +x ./run_client.sh\r"
expect { timeout { puts "ERROR: chmod run_client.sh timed out"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }

send "./run_client.sh > /tmp/wsv_faban.out 2>&1 < /dev/null &\r"
expect { timeout { puts "ERROR: faban launch didn't return prompt"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }
puts "wsv: faban launched; tailing /tmp/wsv_faban.out for a SUCCESSFUL client op (Successfully browsed Elgg)..."
send "tail -f /tmp/wsv_faban.out\r"
# 'Ramp up completed' is a TIMER, not proof of success — faban prints it even
# when every request fails. The real proof is 'Successfully browsed Elgg'.
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: client never logged 'Successfully browsed Elgg' -- workload broken"; quit_qemu $monitor_port; exit 1 }
    -re {Successfully browsed Elgg}
}
puts "wsv: client succeeded (browsed Elgg); waiting for 'Ramp up completed'..."
expect {
    timeout { puts "ERROR: 'Ramp up completed' never arrived after a successful browse"; quit_qemu $monitor_port; exit 1 }
    -re {Ramp up completed}
}
puts "wsv: ramp-up done WITH verified successful client ops; settling 5s before savevm..."
send "\003"
set timeout $BUDGET_PROMPT_S
expect { timeout { } -re {[\$#] +} }
sleep 5

# faban keeps running in the background container so savevm snapshots the live workload.

# --- 7. savevm loaded via the monitor ---------------------------------------

set monitor_sid [connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S]
set spawn_id $monitor_sid

set timeout $BUDGET_DEFAULT_S
expect {
    timeout { puts "ERROR: monitor prompt timed out"; exit 1 }
    "(qemu) "
}

set timeout $BUDGET_CHECKPOINTING_S
send "delvm loaded\r"
expect {
    timeout { puts "WARN: delvm didn't return; continuing anyway" }
    "(qemu) "
}
send "savevm loaded\r"
expect {
    timeout { puts "ERROR: savevm didn't return"; exit 1 }
    "(qemu) "
}

send "quit\r"
catch {expect eof}
exit 0
