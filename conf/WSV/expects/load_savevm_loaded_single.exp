#!/usr/bin/env expect
# SINGLE-NODE WSV load. Loads from `booted`, brings up an in-guest detached tmux
# session with 4 windows, runs the cloudsuite/web-serving stack across them
# (database, memcached, web_server, faban_client), waits for the faban
# benchmark's ramp-up, then `savevm loaded` over the monitor and quits.
#
# Wire into a YAML's `load:` section:
#   experiment_context:
#     interaction_script: /home/dev/qflex/conf/WSV/expects/load_savevm_loaded_single.exp
#     loadvm_name:        booted
#
# Single-node guest has 2 vCPUs (core_count=1 × doubled_vcpu=true). The
# in-image ./run_*.sh scripts already pin db/memcached/web_server to cpu 0 and
# faban_client to cpu 1 — no rewrite needed.
#
# tmux is assumed already installed in the qcow2 (manually by the user). The
# script never attaches into tmux — it drives the session entirely from the
# alpine shell via `tmux send-keys` and reads window output via
# `tmux capture-pane -p`. That keeps the serial spawn predictable and avoids
# Ctrl-B escape sequences over telnet.
#
# === IN-IMAGE WORKLOAD SCRIPT REFERENCE ======================================
# Four baked scripts live in /home/qflex/ inside the alpine guest. Single-node
# runs all four on ONE guest and they all communicate via 127.0.0.1; NONE are
# rewritten here. If you need to change any of them for this run, you'd add a
# heredoc-rewrite right before the corresponding tmux send-keys dispatch (same
# pattern as the multi-node master/wait scripts). Don't edit the in-image
# baked file directly — the qcow2 owns the canonical copy and a fresh loadvm
# wipes guest-side edits.
#
# ./run_database.sh   — NOT REWRITTEN. cpuset=0 fits -smp 2; mariadb listens on
#   127.0.0.1; web_server connects to it locally.
# ./run_memcached.sh  — NOT REWRITTEN. cpuset=0; memcached listens on 127.0.0.1.
# ./run_server.sh     — NOT REWRITTEN. Baked bootstrap arg `127.0.0.1` is fine
#   because faban_client connects via 127.0.0.1 too (same guest, same --net=host
#   namespace). Multi-node DOES rewrite this — the web-server address arg
#   becomes 192.168.100.1 (the master's PDES IP, == the follower's faban
#   target). See load_savevm_loaded_master.exp for that variant.
# ./run_client.sh     — NOT REWRITTEN. cpuset=1 works because -smp 2 has cpu 1.
#   The faban benchmark is dispatched via `./run/entrypoint.sh 127.0.0.1 4 ...`
#   (target IP = local) at the entrypoint.sh dispatch line below.
# =============================================================================

set timeout 900

set BUDGET_INITIAL_S        10
set BUDGET_DEFAULT_S         5
set BUDGET_PROMPT_S         60
set BUDGET_WORKLOAD_INIT_S 43200   ; # 12h client budget (ramp-up=120 guest-sec can be many hours wall-clock)
set BUDGET_CHECKPOINTING_S 1800

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)
set exp_folder   $env(EXP_FOLDER)

catch {file mkdir $exp_folder}
log_file -noappend "$exp_folder/expect_log.txt"

proc connect_telnet {host port {budget_seconds 5}} {
    global timeout
    set saved_timeout $timeout
    set timeout 5
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        spawn telnet $host $port
        set this_sid $spawn_id
        set ok 0
        expect {
            -re "Escape character is" { set ok 1 }
            -re "Connection refused" { }
            timeout { }
            eof { }
        }
        if {$ok} {
            set timeout $saved_timeout
            return $this_sid
        }
        catch {close -i $this_sid}
        catch {wait -i $this_sid}
        sleep 2
    }
    set timeout $saved_timeout
    error "connect_telnet: gave up after ${budget_seconds}s polling $host:$port"
}

proc quit_qemu {monitor_port} {
    global BUDGET_DEFAULT_S
    if {[catch {connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S} sid]} {
        return
    }
    set timeout $BUDGET_DEFAULT_S
    expect {
        -i $sid
        timeout { puts "quit_qemu: monitor didn't prompt" }
        "(qemu) " {
            send -i $sid "quit\r"
            catch {expect -i $sid eof}
        }
    }
}

# Poll a tmux pane for a literal substring. Drives `tmux capture-pane -p` over
# the alpine shell spawn, accumulates the response, and searches for the
# needle. Wall-clock deadline (outer `set timeout` doesn't bound Tcl loops).
# Fail-fasts if the pane shows a bash syntax error — a misquoted send-keys
# would otherwise spin the loop until the workload-init budget expires.
proc wait_for_pane_substring {session window needle budget_seconds} {
    global timeout
    set saved_timeout $timeout
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        send "tmux capture-pane -t ${session}:${window} -p\r"
        set buf ""
        set timeout 5
        expect {
            -re {.+} { append buf $expect_out(buffer); exp_continue }
            timeout { }
        }
        if {[string first $needle $buf] >= 0} { set timeout $saved_timeout; return }
        foreach err {"bash: syntax error" "syntax error near unexpected"} {
            if {[string first $err $buf] >= 0} {
                set timeout $saved_timeout
                error "wait_for_pane_substring: bash error in $session:$window: '$err' (waiting for '$needle')"
            }
        }
        sleep 2
    }
    set timeout $saved_timeout
    error "wait_for_pane_substring: '$needle' never in $session:$window within ${budget_seconds}s"
}

# --- 1. Connect serial + nudge for shell prompt (post-loadvm) ---------------

set serial_sid [connect_telnet 127.0.0.1 $serial_port $BUDGET_INITIAL_S]
set spawn_id $serial_sid

set timeout $BUDGET_PROMPT_S
send "\r"
expect {
    timeout { puts "ERROR: shell prompt timed out after loadvm"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 5

# --- 2. Create detached tmux session with 4 windows -------------------------

send "tmux new-session -d -s wsv\r"
expect {
    timeout { puts "ERROR: tmux new-session timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
send "tmux new-window -t wsv:1\r"
expect {
    timeout { puts "ERROR: tmux new-window 1 timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
send "tmux new-window -t wsv:2\r"
expect {
    timeout { puts "ERROR: tmux new-window 2 timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
send "tmux new-window -t wsv:3\r"
expect {
    timeout { puts "ERROR: tmux new-window 3 timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

# --- 3. Window 0: database --------------------------------------------------
# run_database.sh runs cloudsuite db_server with -it; after MariaDB starts the
# container drops to a root shell prompt `root@qflex:/#`. We then run a mysql
# ALTER USER over -e and wait for the next root prompt.

send "tmux send-keys -t wsv:0 './run_database.sh' Enter\r"
expect {
    timeout { puts "ERROR: dispatching run_database.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
puts "wsv: window 0 (database) launched; waiting for 'root@qflex:/#'..."
wait_for_pane_substring wsv 0 "root@qflex:/#" $BUDGET_WORKLOAD_INIT_S
puts "wsv: window 0 at root shell; sending mysql ALTER USER..."

send "tmux send-keys -t wsv:0 \"mysql -u root -e \\\"ALTER USER 'root'@'localhost' IDENTIFIED VIA mysql_native_password USING PASSWORD(''); FLUSH PRIVILEGES;\\\"\" Enter\r"
expect {
    timeout { puts "ERROR: dispatching mysql ALTER USER timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
# Pane already shows the prompt before mysql was sent. Give the command time
# to actually run before re-polling — otherwise we re-match the pre-command
# prompt and proceed before mysql finished.
sleep 5
wait_for_pane_substring wsv 0 "root@qflex:/#" $BUDGET_PROMPT_S
puts "wsv: mysql ALTER USER returned."

# --- 4. Window 1: memcached (detached docker) -------------------------------

send "tmux send-keys -t wsv:1 './run_memcached.sh' Enter\r"
expect {
    timeout { puts "ERROR: dispatching run_memcached.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
puts "wsv: window 1 (memcached) dispatched; settling 1s host time..."
sleep 1

# --- 5. Window 2: web_server (detached docker) ------------------------------

send "tmux send-keys -t wsv:2 './run_server.sh' Enter\r"
expect {
    timeout { puts "ERROR: dispatching run_server.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
puts "wsv: window 2 (web_server) dispatched; settling 1s host time..."
sleep 1

# --- 6. Window 3: faban client + benchmark ----------------------------------
# run_client.sh enters the faban container with --entrypoint=bash; prompt
# becomes `root@qflex:/web20_benchmark#`. Then we dispatch entrypoint.sh and
# wait for "Ramp up completed" — that's faban's ramp-up→steady-state signal.

send "tmux send-keys -t wsv:3 './run_client.sh' Enter\r"
expect {
    timeout { puts "ERROR: dispatching run_client.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
puts "wsv: window 3 (faban) launched; waiting for 'root@qflex:/web20_benchmark#'..."
wait_for_pane_substring wsv 3 "root@qflex:/web20_benchmark#" $BUDGET_WORKLOAD_INIT_S
puts "wsv: faban container ready; dispatching entrypoint.sh..."

send "tmux send-keys -t wsv:3 './run/entrypoint.sh 127.0.0.1 4 --encryption=1 --ramp-up=120 --ramp-down=1800 --steady=86400 --oper=run --min=0 --max=0 --type=THINKTIME' Enter\r"
expect {
    timeout { puts "ERROR: dispatching entrypoint.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
# 'Ramp up completed' is a TIMER, not proof of success — faban prints it even
# when every request fails. The real proof is 'Successfully browsed Elgg'.
# Gate on that FIRST; do not weaken this gate.
puts "wsv: entrypoint.sh dispatched; waiting for a SUCCESSFUL client op (Successfully browsed Elgg)..."
wait_for_pane_substring wsv 3 "Successfully browsed Elgg" $BUDGET_WORKLOAD_INIT_S
puts "wsv: client succeeded (browsed Elgg); waiting for 'Ramp up completed'..."
wait_for_pane_substring wsv 3 "Ramp up completed" $BUDGET_WORKLOAD_INIT_S
puts "wsv: ramp-up done WITH verified successful client ops; settling 5s host time before savevm..."
sleep 5

catch {close -i $serial_sid}
catch {wait -i $serial_sid}

# --- 7. savevm loaded via the monitor ---------------------------------------

set monitor_sid [connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S]
set spawn_id $monitor_sid

set timeout $BUDGET_DEFAULT_S
expect {
    timeout { puts "ERROR: monitor prompt timed out"; exit 1 }
    "(qemu) "
}

set timeout $BUDGET_CHECKPOINTING_S
send "delvm loaded\r"
expect {
    timeout { puts "WARN: delvm didn't return; continuing anyway" }
    "(qemu) "
}
send "savevm loaded\r"
expect {
    timeout { puts "ERROR: savevm didn't return"; exit 1 }
    "(qemu) "
}

send "quit\r"
catch {expect eof}
exit 0
