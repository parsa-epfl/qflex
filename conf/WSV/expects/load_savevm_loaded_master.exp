#!/usr/bin/env expect
# MULTI-NODE MASTER (node_number == 0) WSV load. Loads from `booted`, brings
# up the PDES NIC, ping-verifies the wire to the follower (0-drop required),
# launches an in-guest detached tmux session with 3 windows (database,
# memcached, web_server) on master, signals follower to start the faban
# client, waits for follower's ramp-up sentinel, then `savevm loaded` via
# the monitor and quits.
#
# Pair with conf/WSV/expects/load_savevm_loaded_wait.exp on the follower.
#
# === IN-IMAGE WORKLOAD SCRIPT REFERENCE ======================================
# Three baked scripts live in /home/qflex/ inside the alpine guest. This expect
# runs each as a detached docker container (no tmux) and REWRITES two
# (./run_database.sh -> -dt; ./run_server.sh -> advertised addr 192.168.100.1)
# in place before launch — see heredocs further down. If you need to change what
# any of these do for this run, edit the heredoc HERE, not the in-image baked
# file: the qcow2 owns the canonical copy and a fresh loadvm wipes any guest-
# side edits to the baked files.
#
# ./run_database.sh   — REWRITTEN -it -> -dt in section 5 below (so MariaDB stays
#   detached and the ALTER USER runs as a post-start docker exec). Baked version:
#   #!/bin/sh
#   docker run -it --net=host --rm --name=database_server \
#       -v $(pwd)/backup:/backup \
#       -v $(pwd)/db/entrypoint.sh:/etc/entrypoint.sh \
#       --cpuset-cpus=0 \
#       cloudsuite/web-serving:db_server
#   cpuset=0 works under -smp 1; mariadb listens on 127.0.0.1 inside master's
#   --net=host network namespace, which is fine because the web_server runs on
#   the same alpine host. No cross-wire access to the DB needed.
#
# ./run_memcached.sh  — NOT REWRITTEN.
#   #!/bin/sh
#   docker run -dt --net=host --rm \
#       --cpuset-cpus=0 \
#       --name=memcache_server cloudsuite/web-serving:memcached_server
#   Same rationale as ./run_database.sh — local-only listener under --net=host
#   is fine because web_server connects from the same alpine namespace.
#
# ./run_server.sh     — REWRITTEN by heredoc in section 7 below.
#   Baked version (passes 127.0.0.1 as the http-server bind IP):
#   #!/bin/sh
#   docker run -dt --rm --net=host --name=web_server \
#       -v $(pwd)/server/bootstrap.sh:/etc/bootstrap.sh \
#       --cpuset-cpus=0 \
#       cloudsuite/web-serving:web_server \
#       /etc/bootstrap.sh \
#       https 127.0.0.1 127.0.0.1 127.0.0.1 4 4
#   The THIRD positional arg is the web server's listen/server address; we set
#   it to 192.168.100.1 (the wire IP the follower's faban connects to). That
#   alone makes browse/login work over the wire, but it does NOT change Elgg's
#   site URL: the image bakes $CONFIG->wwwroot = https://127.0.0.1:8443/ in
#   settings.php, and Elgg builds its login-redirect + notifications URLs from
#   wwwroot. So a SEPARATE step (section 7b) rewrites settings.php's wwwroot to
#   192.168.100.1 after the container starts, or every getNotifications fails
#   (the follower chases its own 127.0.0.1). DB + memcache args (positions 1
#   and 2) stay 127.0.0.1 — local to the master, no cross-wire reachability
#   needed. Single-node needs neither change (its client targets 127.0.0.1).
# =============================================================================

set timeout 900

set BUDGET_INITIAL_S        10
set BUDGET_DEFAULT_S         5
set BUDGET_PROMPT_S         60
set BUDGET_WORKLOAD_INIT_S 43200   ; # 12h: server init + waiting for follower's faban ramp-up=120 (can be many hours under PDES)
set BUDGET_CHECKPOINTING_S 10800
set BUDGET_SERVER_SETTLE_S    30   ; # host-time settle after 8443 is listening, before signalling the follower

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)
set exp_folder   $env(EXP_FOLDER)

catch {file mkdir $exp_folder}
log_file -noappend "$exp_folder/expect_log.txt"

if {[info exists env(GROUP_EXP_FOLDER)]} {
    set group_folder $env(GROUP_EXP_FOLDER)
} else {
    set group_folder [file dirname $exp_folder]
}
set wire_master_flag          "$group_folder/wsv_load_wire_master.flag"
set wire_wait_flag            "$group_folder/wsv_load_wire_wait.flag"
set nc_listen_ready_flag      "$group_folder/wsv_load_nc_listen_ready.flag"
set server_ready_flag         "$group_folder/wsv_load_server_ready.flag"
set ramp_up_done_flag         "$group_folder/wsv_load_ramp_up_done.flag"
catch {file delete -force $wire_master_flag}
catch {file delete -force $nc_listen_ready_flag}
catch {file delete -force $server_ready_flag}

proc connect_telnet {host port {budget_seconds 5}} {
    global timeout
    set saved_timeout $timeout
    set timeout 5
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        spawn telnet $host $port
        set this_sid $spawn_id
        set ok 0
        expect {
            -re "Escape character is" { set ok 1 }
            -re "Connection refused" { }
            timeout { }
            eof { }
        }
        if {$ok} {
            set timeout $saved_timeout
            return $this_sid
        }
        catch {close -i $this_sid}
        catch {wait -i $this_sid}
        sleep 2
    }
    set timeout $saved_timeout
    error "connect_telnet: gave up after ${budget_seconds}s polling $host:$port"
}

proc quit_qemu {monitor_port} {
    global BUDGET_DEFAULT_S
    if {[catch {connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S} sid]} {
        return
    }
    set timeout $BUDGET_DEFAULT_S
    expect {
        -i $sid
        timeout { puts "quit_qemu: monitor didn't prompt" }
        "(qemu) " {
            send -i $sid "quit\r"
            catch {expect -i $sid eof}
        }
    }
}

proc wait_for_file {path budget_seconds} {
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        if {[file exists $path]} { return }
        sleep 2
    }
    error "wait_for_file: $path never appeared within ${budget_seconds}s"
}

proc wait_for_substring {path needle budget_seconds} {
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        if {[file exists $path]} {
            set fh [open $path r]; set content [read $fh]; close $fh
            if {[string first $needle $content] >= 0} { return }
        }
        sleep 2
    }
    error "wait_for_substring: $needle never appeared in $path within ${budget_seconds}s"
}

# --- 1. Connect serial + nudge for post-loadvm prompt -----------------------

set serial_sid [connect_telnet 127.0.0.1 $serial_port $BUDGET_INITIAL_S]
set spawn_id $serial_sid

set timeout $BUDGET_PROMPT_S
send "\r"
expect {
    timeout { puts "ERROR: shell prompt timed out after loadvm"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 10

# --- 2. IP bring-up on the PDES NIC (eth0) ----------------------------------
# `su` + empty creds; prompt-aware exp_continue to sync on the visible prompt.

send "su\r"
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "ERROR: never reached root prompt after su"; quit_qemu $monitor_port; exit 1 }
    -re {[Aa]uthentication failure|incorrect password} {
        puts "ERROR: su rejected empty creds"; quit_qemu $monitor_port; exit 1
    }
    -re {[Ll]ogin: }    { send "\r"; exp_continue }
    -re {[Pp]assword: } { send "\r"; exp_continue }
    -re {# +}
}
send "ip link show\r";                              expect -re {# +}
send "ip link set eth0 down\r";                     expect -re {# +}
send "ip link set eth0 address 52:54:00:aa:bb:00\r"; expect -re {# +}
send "ip link set eth0 up\r";                       expect -re {# +}
send "ip addr flush dev eth0\r"
expect {
    timeout { puts "ERROR: ip addr flush timed out"; quit_qemu $monitor_port; exit 1 }
    -re {# +}
}
send "ip addr add 192.168.100.1/24 dev eth0\r";     expect -re {# +}
send "ip addr show eth0\r";                         expect -re {# +}
send "su qflex\r";                                  expect -re {\$ +}

sleep 5

# --- 3. Ping verify the wire to follower (0-drop required) ------------------

send "ping 192.168.100.2 -i 0.05 -c 10\r"
set timeout 120
expect {
    timeout { puts "ERROR: ping summary didn't arrive within 120s"; quit_qemu $monitor_port; exit 1 }
    -re {(\d+) packets transmitted, (\d+)[ ,]} {
        set tx $expect_out(1,string); set rx $expect_out(2,string)
        puts "master: ping summary -> $tx transmitted, $rx received"
        if {$tx != $rx} {
            puts "ERROR: ping drops detected (tx=$tx rx=$rx); aborting"
            quit_qemu $monitor_port; exit 1
        }
    }
}
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "WARN: prompt didn't return after ping summary; continuing" }
    -re {[\$#] +}
}

sleep 5

# --- 4. Wire-ready handshake ------------------------------------------------

if {[catch {set f [open $wire_master_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $wire_master_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "master: wire verified; wrote $wire_master_flag; waiting for $wire_wait_flag..."
wait_for_file $wire_wait_flag $BUDGET_PROMPT_S
puts "master: both wires verified; running nc data-path preflight."

# --- 4.5 nc data-path preflight: prove TCP works follower->master on :8443 --
# ICMP ping doesn't prove a TCP listener is reachable across the wire; faban
# connects to 192.168.100.1:8443. Listen in the FOREGROUND so the token shows
# on the serial, and expect it directly — that IS the proof data flowed.
if {[catch {set f [open $nc_listen_ready_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $nc_listen_ready_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "master: nc listener coming up on :8443; wrote $nc_listen_ready_flag; waiting for token..."
send "nc -l -p 8443\r"
set timeout $BUDGET_PROMPT_S
expect {
    timeout { puts "ERROR: nc preflight: no token on :8443 (TCP path broken)"; quit_qemu $monitor_port; exit 1 }
    -re {Hello from VM2} { puts "master: nc preflight OK -- received 'Hello from VM2!' over :8443" }
}
# busybox `nc -l` exits when the follower's `nc -w` closes; Ctrl-C guarantees
# the shell is clean before we reuse it (so the next command isn't typed into
# a still-running nc).
send "\003"
expect { timeout { } -re {[\$#] +} }
sleep 2
puts "master: nc preflight passed; starting tmux + cloudsuite services."

# --- 5. Database: detached container, then ALTER USER via docker exec (retry) -
# run_database.sh rewritten -it -> -dt (no tmux); MariaDB starts via the image
# entrypoint. The ALTER retries until MariaDB accepts and echoes a marker.
# cpuset=0 keeps server-side work on core 0.

send "cat > ./run_database.sh <<'WRITE_DB_EOF'\r"
send "#!/bin/sh\r"
send "docker run -dt --net=host --rm --name=database_server \\\r"
send "  -v \$(pwd)/backup:/backup \\\r"
send "  -v \$(pwd)/db/entrypoint.sh:/etc/entrypoint.sh \\\r"
send "  --cpuset-cpus=0 \\\r"
send "  cloudsuite/web-serving:db_server\r"
send "WRITE_DB_EOF\r"
expect { timeout { puts "ERROR: writing run_database.sh timed out"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }
send "chmod +x ./run_database.sh\r"
expect { timeout { puts "ERROR: chmod run_database.sh timed out"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }
send "./run_database.sh\r"
expect { timeout { puts "ERROR: launching database didn't return prompt"; quit_qemu $monitor_port; exit 1 } -re {[\$#] +} }

puts "wsv: database launched; running ALTER USER (retry until MariaDB accepts)..."
# Foreground retry loop: docker exec runs the ALTER against the detached
# container (which keeps running after the exec returns). The retry rides out
# MariaDB's startup. Streams live to the serial; ends on the marker.
send "until docker exec database_server mysql -u root -e \"ALTER USER 'root'@'localhost' IDENTIFIED VIA mysql_native_password USING PASSWORD(''); FLUSH PRIVILEGES;\"; do sleep 5; done; echo WSV_DB_ALTERED\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: mysql ALTER USER never succeeded"; quit_qemu $monitor_port; exit 1 }
    -re {WSV_DB_ALTERED}
}
set timeout $BUDGET_PROMPT_S
send "\r"; expect { timeout { } -re {[\$#] +} }
puts "wsv: mysql ALTER USER done."

# --- 6. Memcached: detached container (no tmux) -----------------------------
# run_memcached.sh is already `docker run -dt` (cpuset=0), returns immediately.

send "./run_memcached.sh && echo WSV_MEMCACHED_OK\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: memcached didn't confirm start"; quit_qemu $monitor_port; exit 1 }
    -re {WSV_MEMCACHED_OK}
}
set timeout $BUDGET_PROMPT_S
expect { timeout { } -re {[\$#] +} }
puts "wsv: memcached container started."

# --- 7. Web_server: detached container (no tmux) ----------------------------
# Rewrite ./run_server.sh so the web server's advertised address (3rd bootstrap
# arg) is 192.168.100.1 — the address the follower's faban connects to. Was
# 127.0.0.1 (loopback-only, unreachable from the wire); 0.0.0.0 connected at
# TCP level but broke Elgg's site URL. See the IN-IMAGE banner at the top.
send "cat > ./run_server.sh <<'WRITE_SERVER_EOF'\r"
send "#!/bin/sh\r"
send "\r"
send "docker run -dt --rm --net=host --name=web_server \\\r"
send "  -v \$(pwd)/server/bootstrap.sh:/etc/bootstrap.sh \\\r"
send "  --cpuset-cpus=0 \\\r"
send "  cloudsuite/web-serving:web_server \\\r"
send "  /etc/bootstrap.sh \\\r"
send "  https 127.0.0.1 127.0.0.1 192.168.100.1 4 4\r"
send "WRITE_SERVER_EOF\r"
expect {
    timeout { puts "ERROR: writing ./run_server.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
send "chmod +x ./run_server.sh\r"
expect {
    timeout { puts "ERROR: chmod ./run_server.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
sleep 5

send "./run_server.sh && echo WSV_SERVER_OK\r"
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: web_server didn't confirm start"; quit_qemu $monitor_port; exit 1 }
    -re {WSV_SERVER_OK}
}
set timeout $BUDGET_PROMPT_S
expect { timeout { } -re {[\$#] +} }
puts "wsv: web_server container started."

# --- 7b. Point Elgg's wwwroot at the master's wire IP -----------------------
# The web_server image bakes $CONFIG->wwwroot = https://127.0.0.1:8443/ in
# settings.php; Elgg builds its login-redirect + notifications URLs from it, so
# the follower's faban would chase its own 127.0.0.1 and every getNotifications
# would fail (browse works because it hits the target directly). Rewrite wwwroot
# to 192.168.100.1 once Elgg has written settings.php, reload php-fpm, then wait
# until nginx is actually listening on :8443 (don't signal the follower against a
# not-yet-serving port). The docker-exec fixups target the already-running
# detached container, so they stay post-start (not the container entrypoint).
send "cat > ./fix_wwwroot.sh <<'WSV_FIX_EOF'\r"
send "#!/bin/sh\r"
send "until docker exec web_server grep -q '127.0.0.1:8443' /usr/share/nginx/html/elgg/elgg-config/settings.php 2>/dev/null; do sleep 5; done\r"
send "docker exec web_server sed -i 's#https://127.0.0.1:8443/#https://192.168.100.1:8443/#' /usr/share/nginx/html/elgg/elgg-config/settings.php\r"
send "docker exec web_server sh -c 'kill -USR2 \$(cat /var/run/php/php8.1-fpm.pid 2>/dev/null) 2>/dev/null || pkill -USR2 php-fpm' || true\r"
# web_server runs --net=host, so its nginx socket shows in this guest's netns.
send "until netstat -tln 2>/dev/null | grep -q ':8443'; do sleep 5; done\r"
send "echo 'master: 8443 listening'\r"
send "echo WSV_WWWROOT_FIXED\r"
send "WSV_FIX_EOF\r"
expect {
    timeout { puts "ERROR: writing fix_wwwroot.sh timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}
send "sh ./fix_wwwroot.sh\r"
puts "wsv: fixing Elgg wwwroot -> https://192.168.100.1:8443/ (await settings.php, sed, php-fpm reload, :8443 listening)..."
set timeout $BUDGET_WORKLOAD_INIT_S
expect {
    timeout { puts "ERROR: wwwroot fix never completed"; quit_qemu $monitor_port; exit 1 }
    -re {WSV_WWWROOT_FIXED}
}
puts "wsv: Elgg wwwroot set + 8443 listening. Settling ${BUDGET_SERVER_SETTLE_S}s before signalling follower."
sleep $BUDGET_SERVER_SETTLE_S

# --- 9. Signal follower that server is up ----------------------------------

if {[catch {set f [open $server_ready_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $server_ready_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "master: wrote $server_ready_flag; waiting for follower's ramp-up sentinel..."

# --- 10. Wait for follower's ramp-up done ----------------------------------

wait_for_file $ramp_up_done_flag $BUDGET_WORKLOAD_INIT_S
puts "master: follower finished ramp-up; proceeding to savevm loaded."

catch {close -i $serial_sid}
catch {wait -i $serial_sid}

# --- 11. savevm loaded via the monitor -------------------------------------

set monitor_sid [connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S]
set spawn_id $monitor_sid

set timeout $BUDGET_DEFAULT_S
expect {
    timeout { puts "ERROR: monitor prompt timed out"; exit 1 }
    "(qemu) "
}

set timeout $BUDGET_CHECKPOINTING_S
send "delvm loaded\r"
expect {
    timeout { puts "WARN: delvm didn't return; continuing anyway" }
    "(qemu) "
}
send "savevm loaded\r"
expect {
    timeout { puts "ERROR: savevm didn't return"; exit 1 }
    "(qemu) "
}

# --- 12. Wait for own per-node savevm log 7 + 60s settle -------------------

puts "master: savevm returned; polling Load.log for 'savevm log 7'..."
wait_for_substring "$exp_folder/Load.log" "savevm log 7" $BUDGET_CHECKPOINTING_S
puts "master: saw 'savevm log 7' — savevm-loaded finalised. Sleeping 60s..."
sleep 60

send "quit\r"
catch {expect eof}
exit 0
