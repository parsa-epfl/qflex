#!/usr/bin/env expect
# MULTI-NODE MASTER (node_number == 0) WSV boot. Boots Alpine, logs in as
# qflex/qflex, writes the master-login sentinel, waits for the follower's
# login sentinel, then `savevm booted` via the monitor and quits.
#
# Pair with conf/WSV/expects/boot_savevm_booted_wait.exp on every non-master
# leaf. PDES `savevm` is a distributed snapshot — the master's monitor command
# drives a drain that writes every node's per-node qcow2; we just need the
# follower to be at the shell prompt before we trigger it so neither leaf
# saves a half-initialised guest.
#
# Wire into a YAML's `boot:` section per leaf, e.g.:
#   experiment_context_node_0:
#     interaction_script: /home/dev/qflex/conf/WSV/expects/boot_savevm_booted_master.exp
#   experiment_context_node_1:
#     interaction_script: /home/dev/qflex/conf/WSV/expects/boot_savevm_booted_wait.exp

set timeout 900

set BUDGET_INITIAL_S        10
set BUDGET_DEFAULT_S         5
set BUDGET_PROMPT_S         60
set BUDGET_BOOT_LOGIN_S   1800   ; # cold-boot login under multi-node PDES can be many minutes
set BUDGET_CHECKPOINTING_S 1800

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)
set exp_folder   $env(EXP_FOLDER)

catch {file mkdir $exp_folder}
log_file -noappend "$exp_folder/expect_log.txt"

set group_folder              [file dirname $exp_folder]
set master_login_flag         "$group_folder/wsv_boot_master_login.flag"
set wait_login_flag           "$group_folder/wsv_boot_wait_login.flag"
catch {file delete -force $master_login_flag}

proc connect_telnet {host port {budget_seconds 5}} {
    global timeout
    set saved_timeout $timeout
    set timeout 5
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        spawn telnet $host $port
        set this_sid $spawn_id
        set ok 0
        expect {
            -re "Escape character is" { set ok 1 }
            -re "Connection refused" { }
            timeout { }
            eof { }
        }
        if {$ok} {
            set timeout $saved_timeout
            return $this_sid
        }
        catch {close -i $this_sid}
        catch {wait -i $this_sid}
        sleep 2
    }
    set timeout $saved_timeout
    error "connect_telnet: gave up after ${budget_seconds}s polling $host:$port"
}

proc quit_qemu {monitor_port} {
    global BUDGET_DEFAULT_S
    if {[catch {connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S} sid]} {
        return
    }
    set timeout $BUDGET_DEFAULT_S
    expect {
        -i $sid
        timeout { puts "quit_qemu: monitor didn't prompt" }
        "(qemu) " {
            send -i $sid "quit\r"
            catch {expect -i $sid eof}
        }
    }
}

proc wait_for_file {path budget_seconds} {
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        if {[file exists $path]} { return }
        sleep 2
    }
    error "wait_for_file: $path never appeared within ${budget_seconds}s"
}

# --- 1. Connect serial + login as qflex/qflex --------------------------------

set serial_sid [connect_telnet 127.0.0.1 $serial_port $BUDGET_INITIAL_S]
set spawn_id $serial_sid

set timeout $BUDGET_BOOT_LOGIN_S
send "\r"
expect {
    timeout { puts "ERROR: login prompt timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[Ll]ogin: }
}

set timeout $BUDGET_PROMPT_S
send "qflex\r"
expect {
    timeout { puts "ERROR: password prompt timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[Pp]assword: }
}
send "qflex\r"
expect {
    timeout { puts "ERROR: shell prompt timed out"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 5

send "ls\r"
expect {
    timeout { puts "ERROR: ls didn't return"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

sleep 5

# --- 2. Sentinel handshake: announce we're at shell, wait for follower ------

if {[catch {set f [open $master_login_flag "w"]; close $f} err]} {
    puts "ERROR: could not write $master_login_flag: $err"; quit_qemu $monitor_port; exit 1
}
puts "master: wrote $master_login_flag; waiting for follower at $wait_login_flag..."
wait_for_file $wait_login_flag $BUDGET_BOOT_LOGIN_S
puts "master: follower at shell; proceeding to savevm booted."

catch {close -i $serial_sid}
catch {wait -i $serial_sid}

# --- 3. savevm booted via the monitor ---------------------------------------

set monitor_sid [connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S]
set spawn_id $monitor_sid

set timeout $BUDGET_DEFAULT_S
expect {
    timeout { puts "ERROR: monitor prompt timed out"; exit 1 }
    "(qemu) "
}

set timeout $BUDGET_CHECKPOINTING_S
send "delvm booted\r"
expect {
    timeout { puts "WARN: delvm didn't return; continuing anyway" }
    "(qemu) "
}
send "savevm booted\r"
expect {
    timeout { puts "ERROR: savevm didn't return"; exit 1 }
    "(qemu) "
}

sleep 5

send "quit\r"
catch {expect eof}
exit 0
