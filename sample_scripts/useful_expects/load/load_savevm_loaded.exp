#!/usr/bin/env expect
# Reusable SINGLE-NODE load template. Pairs with boot/boot_savevm_booted.exp:
# the load phase has already done `loadvm booted`, so the guest is back at
# the logged-in shell prompt — no re-login needed. Runs your INSERT YOUR
# SETUP HERE block, then `savevm loaded` for the init phase to load from.
#
# Wire into a YAML's `load:` section as:
#   interaction_script: sample_scripts/useful_expects/load/load_savevm_loaded.exp
#   loadvm_name:        booted
#
# For MULTI-NODE setups, do NOT use this template on every leaf — `savevm` is
# master-only on multi-node. Use the paired templates instead:
#   master leaf  -> sample_scripts/useful_expects/load/load_savevm_loaded_master.exp
#   follower(s)  -> sample_scripts/useful_expects/load/load_savevm_loaded_wait.exp

set timeout 900

set BUDGET_INITIAL_S        10
set BUDGET_DEFAULT_S         5
set BUDGET_PROMPT_S         60
set BUDGET_CHECKPOINTING_S 1800

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)
set exp_folder   $env(EXP_FOLDER)

catch {file mkdir $exp_folder}
log_file -noappend "$exp_folder/expect_log.txt"

proc connect_telnet {host port {budget_seconds 5}} {
    global timeout
    set saved_timeout $timeout
    set timeout 5
    set deadline [expr {[clock seconds] + $budget_seconds}]
    while {[clock seconds] < $deadline} {
        spawn telnet $host $port
        set this_sid $spawn_id
        set ok 0
        expect {
            -re "Escape character is" { set ok 1 }
            -re "Connection refused" { }
            timeout { }
            eof { }
        }
        if {$ok} {
            set timeout $saved_timeout
            return $this_sid
        }
        catch {close -i $this_sid}
        catch {wait -i $this_sid}
        sleep 2
    }
    set timeout $saved_timeout
    error "connect_telnet: gave up after ${budget_seconds}s polling $host:$port"
}

proc quit_qemu {monitor_port} {
    global BUDGET_DEFAULT_S
    if {[catch {connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S} sid]} {
        return
    }
    set timeout $BUDGET_DEFAULT_S
    expect {
        -i $sid
        timeout { puts "quit_qemu: monitor didn't prompt" }
        "(qemu) " {
            send -i $sid "quit\r"
            catch {expect -i $sid eof}
        }
    }
}

# --- 1. Connect serial + nudge for shell prompt ------------------------------
# loadvm restored the guest to whatever state `booted` was savevm'd at — for
# this template, that's a logged-in qflex shell. A bare \r re-renders it.

set serial_sid [connect_telnet 127.0.0.1 $serial_port $BUDGET_INITIAL_S]
set spawn_id $serial_sid

set timeout $BUDGET_PROMPT_S
send "\r"
expect {
    timeout { puts "ERROR: shell prompt timed out after loadvm"; quit_qemu $monitor_port; exit 1 }
    -re {[\$#] +}
}

# =============================================================================
# INSERT YOUR SETUP HERE
# =============================================================================
#
# Anything you do here gets baked into the `loaded` snapshot — typically the
# longer-running, workload-side warm-up that the init phase will hand to FW.
# Each guest command is one `send` followed by an `expect` that waits for the
# next shell prompt. The regex {[\$#] +} matches both `$ ` (qflex) and `# `
# (root). Do NOT anchor with `$` at end-of-buffer — Alpine's busybox emits an
# ESC[6n cursor report after the prompt, so the buffer doesn't end at it.
#
# Example — touch a marker file and verify the command returned cleanly:
#
#   send "touch /home/qflex/loaded_marker.txt\r"
#   expect {
#       timeout { puts "ERROR: marker write timed out"; quit_qemu $monitor_port; exit 1 }
#       -re {[\$#] +}
#   }
#
# For privileged ops use `doas` (sudo isn't installed); answer the password
# prompt with `qflex`. For long-running setup, bump the surrounding `set
# timeout` before the send.
#
# =============================================================================

catch {close -i $serial_sid}
catch {wait -i $serial_sid}

# --- 2. savevm loaded via the monitor ----------------------------------------

set monitor_sid [connect_telnet 127.0.0.1 $monitor_port $BUDGET_DEFAULT_S]
set spawn_id $monitor_sid

set timeout $BUDGET_DEFAULT_S
expect {
    timeout { puts "ERROR: monitor prompt timed out"; exit 1 }
    "(qemu) "
}

# delvm is best-effort — keeps re-runs idempotent (savevm refuses to overwrite).
set timeout $BUDGET_CHECKPOINTING_S
send "delvm loaded\r"
expect {
    timeout { puts "WARN: delvm didn't return; continuing anyway" }
    "(qemu) "
}
send "savevm loaded\r"
expect {
    timeout { puts "ERROR: savevm didn't return"; exit 1 }
    "(qemu) "
}

send "quit\r"
catch {expect eof}
exit 0
