#!/usr/bin/env expect
# Install qemu-guest-agent (the QMP agent) into an Alpine guest via the serial
# console, then `savevm base` and `quit` cleanly via the QEMU monitor.
#
# Driven by qflex's Path A: receives TELNET_SERIAL_PORT and TELNET_MONITOR_PORT
# (and EXP_FOLDER, NODE_NUMBER, SERIAL_LOG_PATH) as env vars from the executor's
# bash. Set this script as `interaction_script` on a leaf in YAML:
#
#   experiment_context_node_0:
#     interaction_script: ./sample_scripts/install_qga.exp
#
# After `savevm base` you can later `loadvm base` and the agent will be running,
# letting downstream scripts use guest-agent QMP commands instead of expect.

set timeout 600

set serial_port  $env(TELNET_SERIAL_PORT)
set monitor_port $env(TELNET_MONITOR_PORT)

# QEMU's `telnet,server,nowait` listener takes a moment to come up after gdb
# starts. Retry a handful of times before giving up.
set max_retries 30
set connected 0
for {set i 0} {$i < $max_retries} {incr i} {
    if {[catch {spawn telnet 127.0.0.1 $serial_port}] == 0} {
        set connected 1
        break
    }
    sleep 1
}
if {!$connected} {
    puts "ERROR: could not connect to serial telnet on port $serial_port"
    exit 1
}

# Wait for Alpine's login prompt.
expect {
    timeout { puts "ERROR: timed out waiting for login prompt"; exit 1 }
    -re {login: $}
}
send "root\r"

# Alpine's root has no password by default on a fresh image; tolerate either path.
expect {
    timeout { puts "ERROR: timed out at password / shell prompt"; exit 1 }
    -re {Password: $} { send "\r"; exp_continue }
    -re {# $}
}

# Update package index and install qemu-guest-agent.
send "apk update\r"
expect -re {# $}
send "apk add qemu-guest-agent\r"
expect -re {# $}

# Enable + start the service so subsequent loadvm sessions have it running.
send "rc-update add qemu-guest-agent default\r"
expect -re {# $}
send "rc-service qemu-guest-agent start\r"
expect -re {# $}

# Done with the guest. Disconnect from serial.
close

# Snapshot + quit cleanly via the monitor.
spawn telnet 127.0.0.1 $monitor_port
expect "(qemu) "
send "savevm base\r"
expect "(qemu) "
send "quit\r"
