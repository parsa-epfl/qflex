@app.command(name="get-experiment-folder")
@data_class_wrap(create_experiment_context, name="experiment_context")
def get_experiment_folder(
    experiment_context: ExperimentContext,
):
    """
    Print the experiment folder path(s) the YAML/CLI invocation resolves to,
    one per line. For a multi-node config, prints the unnamed group's folder
    first, followed by each sub-experiment's per-node folder. For single-node,
    prints just the one folder. Pure path computation — runs no phase, creates
    no folder, fast.

    Use this when you need the folder before tailing logs / inspecting
    artifacts, instead of hand-deriving `<mounting>/experiments/<name>/`.
    """
    typer.echo(experiment_context.get_experiment_folder_address())
    for sub in experiment_context.sub_experiments or []:
        typer.echo(sub.get_experiment_folder_address())

