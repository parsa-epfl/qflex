@qpoints_app.command("run-gem5")
@data_class_wrap(ExperimentContextTyper("experiment_context"))
def qpoints_run_gem5_cmd(
    experiment_context: ExperimentContext,
    gem5_ckp_dir: Annotated[
        str | None,
        typer.Option(
            help="Gem5 checkpoint directory. Defaults to <mounting>/checkpoints/<experiment>."
        ),
    ] = None,
    snapshot: Annotated[str, typer.Option(help="Snapshot name, e.g. snapshot_0.")] = "",
    inst: Annotated[int | None, typer.Option(help="Instruction count for legacy instruction-bounded runs.")] = None,
    warmup_cycles: Annotated[int | None, typer.Option(help="Detailed warmup window in CPU cycles (timing Ruby only).")] = None,
    measurement_cycles: Annotated[int | None, typer.Option(help="Measurement window in CPU cycles (timing Ruby only).")] = None,
    branch_trace: Annotated[bool, typer.Option(help="Enable branch trace logging in CSV format.")] = False,
    tage_decision_trace: Annotated[bool, typer.Option(help="Enable compact TAGE decision logging.")] = False,
    data_trace: Annotated[bool, typer.Option(help="Enable data access trace logging.")] = False,
    dump_cache_state: Annotated[
        bool, typer.Option(help="Enable Ruby cache-state dumping (requires --timing-ruby).")
    ] = False,
    timing_ruby: Annotated[
        bool, typer.Option(help="Run gem5 in O3 Ruby MESI_Two_Level mode.")
    ] = False,
    timing_ruby_moesi: Annotated[
        bool, typer.Option(help="Run gem5 in O3 Ruby MOESI_CMP_directory mode.")
    ] = False,
    cache_hierarchy_restore: Annotated[
        bool,
        typer.Option(
            "--cache-hierarchy-restore/--no-cache-hierarchy-restore",
            help="Enable or disable gem5 LLC/L1 cache-hierarchy restore flags.",
        ),
    ] = True,
    sim_config: Annotated[
        str | None,
        typer.Option(help="Optional QPoints/gem5 config args file to pass through to run_gem5.sh."),
    ] = None,
):
    """
    Run gem5 for a single snapshot using QPoints run_gem5.sh.
    """
    if timing_ruby and timing_ruby_moesi:
        raise typer.BadParameter(
            "Choose only one timing Ruby protocol flag: --timing-ruby or --timing-ruby-moesi."
        )
    if dump_cache_state and not timing_ruby:
        raise typer.BadParameter(
            "--dump-cache-state requires --timing-ruby."
        )
    if measurement_cycles is not None or warmup_cycles is not None:
        if not (timing_ruby or timing_ruby_moesi):
            raise typer.BadParameter(
                "Cycle-window timing requires --timing-ruby or --timing-ruby-moesi."
            )
        if inst is not None:
            raise typer.BadParameter(
                "Do not mix --inst with --warmup-cycles/--measurement-cycles."
            )
        if measurement_cycles is None:
            raise typer.BadParameter(
                "--warmup-cycles requires --measurement-cycles."
            )
    elif inst is None:
        raise typer.BadParameter(
            "Either --inst or --measurement-cycles must be provided."
        )
    qpoints_run_gem5(
        gem5_ckp_dir=gem5_ckp_dir or _default_gem5_ckp_dir(experiment_context),
        experiment=experiment_context.experiment_name,
        snapshot=snapshot,
        inst=inst,
        warmup_cycles=warmup_cycles,
        measurement_cycles=measurement_cycles,
        core_count=experiment_context.simulation_context.core_count,
        memory_gb=experiment_context.simulation_context.memory_gb,
        kernel=experiment_context.kernel or None,
        bootloader=experiment_context.bootloader,
        root_device=experiment_context.root_device,
        itb_size=experiment_context.itb_size,
        dtb_size=experiment_context.dtb_size,
        have_large_asid_64=experiment_context.have_large_asid_64,
        branch_trace=branch_trace,
        tage_decision_trace=tage_decision_trace,
        data_trace=data_trace,
        dump_cache_state=dump_cache_state,
        timing_ruby=timing_ruby,
        timing_ruby_moesi=timing_ruby_moesi,
        cache_hierarchy_restore=cache_hierarchy_restore,
        sim_config=sim_config,
    )


