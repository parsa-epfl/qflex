@app.command("run_sample")
@data_class_wrap(ExperimentContextTyper("experiment_context"))
def run_sample(
    experiment_context: ExperimentContext,
    timing_engine: Annotated[str, typer.Option(help="Timing engine (gem5 or flexus).")] = "gem5",
    gem5_ckp_dir: Annotated[
        str | None,
        typer.Option(
            help="Gem5 checkpoint directory. Defaults to <mounting>/checkpoints/<experiment>."
        ),
    ] = None,
    first: Annotated[str, typer.Option(help="First snapshot name, e.g. snapshot_0.")] = "",
    last: Annotated[str, typer.Option(help="Last snapshot name, e.g. snapshot_99.")] = "",
    warmup_cycles: Annotated[int, typer.Option(help="Detailed warmup window in CPU cycles.")] = 0,
    measurement_cycles: Annotated[int, typer.Option(help="Measurement window in CPU cycles.")] = 0,
    timing_ruby: Annotated[
        bool, typer.Option(help="Run gem5 in O3 Ruby MESI_Two_Level mode.")
    ] = False,
    timing_ruby_moesi: Annotated[
        bool, typer.Option(help="Run gem5 in O3 Ruby MOESI_CMP_directory mode.")
    ] = False,
    cache_hierarchy_restore: Annotated[
        bool,
        typer.Option(
            "--cache-hierarchy-restore/--no-cache-hierarchy-restore",
            help="Enable or disable gem5 LLC/L1 cache-hierarchy restore flags.",
        ),
    ] = True,
    sim_config: Annotated[
        str | None,
        typer.Option(help="Optional QPoints/gem5 config args file to pass through to run_gem5.sh."),
    ] = None,
):
    """
    Run all selected sampling units serially and emit a canonical uIPC report.
    """
    experiment = experiment_context.experiment_name
    core_count = experiment_context.simulation_context.core_count
    memory_gb = experiment_context.simulation_context.memory_gb
    resolved_gem5_ckp_dir = gem5_ckp_dir or _default_gem5_ckp_dir(experiment_context)

    if timing_engine == "gem5":
        if timing_ruby and timing_ruby_moesi:
            raise typer.BadParameter(
                "Choose only one timing Ruby protocol flag: --timing-ruby or --timing-ruby-moesi."
            )
        if not (timing_ruby or timing_ruby_moesi):
            raise typer.BadParameter(
                "run_sample currently requires --timing-ruby or --timing-ruby-moesi."
            )
        if measurement_cycles <= 0:
            raise typer.BadParameter(
                "--measurement-cycles must be a positive integer."
            )
        if warmup_cycles < 0:
            raise typer.BadParameter(
                "--warmup-cycles must be non-negative."
            )
        qpoints_run_sample(
            gem5_ckp_dir=resolved_gem5_ckp_dir,
            experiment=experiment,
            first=first,
            last=last,
            core_count=core_count,
            memory_gb=memory_gb,
            kernel=experiment_context.kernel or None,
            bootloader=experiment_context.bootloader,
            root_device=experiment_context.root_device,
            itb_size=experiment_context.itb_size,
            dtb_size=experiment_context.dtb_size,
            have_large_asid_64=experiment_context.have_large_asid_64,
            warmup_cycles=warmup_cycles,
            measurement_cycles=measurement_cycles,
            timing_ruby=timing_ruby,
            timing_ruby_moesi=timing_ruby_moesi,
            cache_hierarchy_restore=cache_hierarchy_restore,
            sim_config=sim_config,
        )
        return

    if timing_engine == "flexus":
        if timing_ruby or timing_ruby_moesi:
            raise typer.BadParameter(
                "--timing-ruby and --timing-ruby-moesi are gem5-only options."
            )
        if sim_config:
            raise typer.BadParameter("--sim-config is currently gem5-only.")
        if measurement_cycles <= 0:
            raise typer.BadParameter(
                "--measurement-cycles must be a positive integer."
            )
        if warmup_cycles < 0:
            raise typer.BadParameter(
                "--warmup-cycles must be non-negative."
            )
        qpoints_run_sample_flexus(
            experiment=experiment,
            first=first,
            last=last,
            core_count=core_count,
            warmup_cycles=warmup_cycles,
            measurement_cycles=measurement_cycles,
            mounting_folder=experiment_context.get_mounting_folder(),
        )
        return

    raise typer.BadParameter(
        "Unsupported --timing-engine value. Expected one of: gem5, flexus."
    )


