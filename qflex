SUPPORTED_RUBY_PROTOCOLS = ("mesi_two_level", "moesi_cmp_directory")


def _load_args_file(path: str) -> list[str]:
    file_args: list[str] = []
    with open(path, encoding="utf-8") as infile:
        for raw_line in infile:
            line = raw_line.split("#", 1)[0].strip()
            if not line:
                continue
            file_args.extend(shlex.split(line))
    return file_args


def _expand_args_files(argv: list[str]) -> list[str]:
    expanded: list[str] = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--args-file":
            if i + 1 >= len(argv):
                raise SystemExit("--args-file requires a value.")
            expanded.extend(_load_args_file(argv[i + 1]))
            i += 2
            continue
        expanded.append(arg)
        i += 1
    return expanded


def _validate_qpoints_ruby_protocol(ruby_protocol: str) -> str:
    if ruby_protocol not in SUPPORTED_RUBY_PROTOCOLS:
        raise typer.BadParameter(
            "Unsupported --ruby-protocol value "
            f"{ruby_protocol!r}. Expected one of: "
            + ", ".join(SUPPORTED_RUBY_PROTOCOLS)
        )
    return ruby_protocol


def _default_gem5_ckp_dir(experiment_context: ExperimentContext) -> str:
    return os.path.join(
        experiment_context.get_mounting_folder(),
        "checkpoints",
        experiment_context.experiment_name,
    )

