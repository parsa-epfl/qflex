@app.command()
@data_class_wrap(ExperimentContextTyper("experiment_context"))
def result(
    experiment_context: ExperimentContext,
    unit_size: Annotated[int, typer.Option(help="Size of the sampling unit in intervals of 100 us (100K uncore cycles); match run-partition --measurement-ratio.")] = 1,
    index: Annotated[int, typer.Option(help="Index of the sampling unit to analyze, counted in units of --unit-size; the default 2 (with --unit-size 1) skips the warming of run-partition --warming-ratio 2.")] = 2,
    core_groups: Annotated[str, typer.Option(help='Core groups to analyze separately, e.g. "0-7,8-15". Default: the measured groups of the workload (see --groups).')] = "",
    confidence: Annotated[float, typer.Option(help="Confidence level for the sample size calculation.")] = 95.0,
    error: Annotated[float, typer.Option(help="Acceptable sampling error.")] = 0.05,
    plot: Annotated[bool, typer.Option(help="Plot the U-IPC distribution.")] = True,
):
    """
    This command collects the results from the detailed simulations into timing.csv and analyzes the sampling error.
    It writes the suggested sample size to NEXT_SAMPLE_SIZE and exits with 255 if the sampling error bound is not met.
    It does not modify core_info.csv; use train for that.
    """
    run_result_executor = RunResultCommand(
        experiment_context=experiment_context,
        unit_size=unit_size,
        index=index,
        core_groups=core_groups or experiment_context.workload.core_groups_arg(),
        confidence=confidence,
        error=error,
        plot=plot,
    )
    r = run_result_executor.execute(to_stdio=True, run_in_background=False)
    raise typer.Exit(r.returncode)

@app.command()
@data_class_wrap(ExperimentContextTyper("experiment_context"))
def train(
    experiment_context: ExperimentContext,
    core_groups: Annotated[str, typer.Option(help='Core groups that each get their own IPC model, e.g. "0-7,8-15". Default: the measured groups of the workload (see --groups).')] = "",
    interval_index: Annotated[int, typer.Option(help="Index of the 100 us interval used to train the per-core IPC model; the default 2 is the first measured one after --warming-ratio 2.")] = 2,
    cycle_range: Annotated[str, typer.Option(help='Uncore cycle range "START-END" (1 GHz, so 100000 = 100 us) used to train the per-ASID models; the default is the measurement after --warming-ratio 2.')] = "200000-300000",
):
    """
    This command trains the IPC model from the timing.csv produced by the result command.
    The per-ASID models are written to run/asid_info.csv, and the trained cores in cfg/core_info.csv switch to the ipc-model.
    The previous core_info.csv is backed up with a timestamp.
    """
    train_executor = TrainCommand(
        experiment_context=experiment_context,
        core_groups=core_groups or experiment_context.workload.core_groups_arg(),
        interval_index=interval_index,
        cycle_range=cycle_range,
    )
    train_executor.execute(to_stdio=True, run_in_background=False)

image_app = typer.Typer(help="List and download prebuilt workloads (disk + base snapshot), to start experiments directly from initialize with --prebuilt-workload.")
app.add_typer(image_app, name="image")

ImageFolderOption = Annotated[str, typer.Option(help="Image folder; prebuilt workloads are stored in <image-folder>/prebuilt/<id>.")]
CatalogUrlOption = Annotated[str, typer.Option(help="Base URL of the prebuilt workload bucket (or set QFLEX_PREBUILT_URL).")]


def print_prebuilt_table(catalog: list[prebuilt.PrebuiltWorkload], image_folder: str, numbered: bool = False):
    table = Table()
    if numbered:
        table.add_column("#", justify="right")
    for column in ["ID", "root.qcow2", "base.zstd", "Total", "Downloaded"]:
        table.add_column(column, justify="left" if column == "ID" else "right")
    for i, w in enumerate(catalog):
        row = [w.id] + [f"{size / 1e9:.1f} GB" for size in (w.sizes["root.qcow2"], w.sizes["base.zstd"], w.total_size)]
        row.append("yes" if prebuilt.is_downloaded(image_folder, w.id) else "")
        table.add_row(*([str(i + 1)] if numbered else []) + row)
    Console().print(table)


@image_app.command("list")
def image_list(
    image_folder: ImageFolderOption = "./images",
    url: CatalogUrlOption = prebuilt.PREBUILT_URL,
):
    """
    List the prebuilt workloads available online. IDs are <core count>/<workload>, e.g. 16c/dc.
    """
    print_prebuilt_table(prebuilt.fetch_catalog(url), image_folder)


@image_app.command("pull")
def image_pull(
    workload_id: Annotated[str, typer.Argument(help="ID of the prebuilt workload, e.g. 16c/dc. Omit to choose from a list.")] = "",
    image_folder: ImageFolderOption = "./images",
    url: CatalogUrlOption = prebuilt.PREBUILT_URL,
):
    """
    Download a prebuilt workload to <image-folder>/prebuilt/<id>. Interrupted downloads resume when pulled again.
    """
    catalog = prebuilt.fetch_catalog(url)
    if workload_id:
        workload = prebuilt.find_workload(catalog, workload_id)
    else:
        print_prebuilt_table(catalog, image_folder, numbered=True)
        choice = typer.prompt("Number of the workload to download", type=int)
        while not 1 <= choice <= len(catalog):
            choice = typer.prompt(f"Enter a number between 1 and {len(catalog)}", type=int)
        workload = catalog[choice - 1]
    folder = prebuilt.pull(workload, image_folder, url)
    config = prebuilt.load_prebuilt_config(folder)
    print(f"Downloaded {workload.id} to {folder}:")
    print(f"  cpu_cores={config['cpu_cores']} measured_core_count={config['measured_core_count']} memory={config['memory']} network_card={config['network_card']}")
    print(f"Start an experiment from it with --prebuilt-workload {workload.id} --image-folder {image_folder}")


