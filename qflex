    qpoints_convert_multi(
        first=first,
        last=last,
        parallel=parallel,
        qflex_ckp_dir=qflex_ckp_dir,
        gem5_ckp_dir=gem5_ckp_dir,
        core_count=core_count,
        memory_gb=memory_gb,
        base=base,
        ssh_host=ssh_host,
        ssh_user=ssh_user,
        monitor_base=monitor_base,
        qmp_base=qmp_base,
        ssh_base=ssh_base,
        overwrite=overwrite,
    )


@qpoints_app.command("run-gem5")
def qpoints_run_gem5_cmd(
    gem5_ckp_dir: Annotated[str, typer.Option(help="Gem5 checkpoint directory.")],
    experiment: Annotated[str, typer.Option(help="Experiment name.")],
    snapshot: Annotated[str, typer.Option(help="Snapshot name, e.g. snapshot_0.")],
    inst: Annotated[int, typer.Option(help="Instruction count.")],
    core_count: Annotated[int, typer.Option(help="Number of CPU cores.")],
    branch_trace: Annotated[bool, typer.Option(help="Enable branch trace logging.")] = False,
):
    """
    Run gem5 for a single snapshot using QPoints run_gem5.sh.
    """
    qpoints_run_gem5(
        gem5_ckp_dir=gem5_ckp_dir,
        experiment=experiment,
        snapshot=snapshot,
        inst=inst,
        core_count=core_count,
        branch_trace=branch_trace,
    )


if __name__ == "__main__":
    app()
